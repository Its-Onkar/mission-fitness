// Handle continue to dashboard
async function handleContinueToDashboard() {
    try {
        const btn = document.getElementById('continueToDashboard');
        btn.disabled = true;
        btn.innerHTML = '<span>Completing Setup...</span><span class="btn-icon">⏳</span>';
        
        const token = "{{token}}" !== "{{token}}" ? "{{token}}" : 
                     new URLSearchParams(window.location.search).get('token') || 
                     localStorage.getItem('token');
        
        if (!token) {
            alert('Please login first');
            window.location.href = '/login';
            return;
        }
        
        const response = await fetch('/api/flow/complete-onboarding', {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            }
        });
        
        const result = await response.json();
        
        if (response.ok) {
            window.location.href = '/main-dashboard';
        } else {
            throw new Error(result.message || 'Failed to complete setup');
        }
    } catch (error) {
        console.error('Error completing onboarding:', error);
        alert('Error completing setup: ' + error.message);
        const btn = document.getElementById('continueToDashboard');
        btn.disabled = false;
        btn.innerHTML = '<span>Continue to Dashboard</span><span class="btn-icon">→</span>';
    }
}

// Make functions available globally
window.debugToken = debugToken;
window.testAuth = testAuthentication;
window.handleContinueToDashboard = handleContinueToDashboard;
