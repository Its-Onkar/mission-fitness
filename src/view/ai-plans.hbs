<script>
const state = {
workout: [],
diet: [],
activeWorkoutDay: 0,
activeDietDay: 0
};
const DOM = {
loading: null,
noPlans: null,
plansContainer: null,
workoutDaysNav: null,
workoutContent: null,
dietDaysNav: null,
dietContent: null
};
function initDOM() {
DOM.loading = document.getElementById('loading');
DOM.noPlans = document.getElementById('no-plans');
DOM.plansContainer = document.getElementById('plans-container');
DOM.workoutDaysNav = document.getElementById('workout-days-nav');
DOM.workoutContent = document.getElementById('workout-content');
DOM.dietDaysNav = document.getElementById('diet-days-nav');
DOM.dietContent = document.getElementById('diet-content');
}
function initCanvas() {
const canvas = document.getElementById('dotsCanvas');
const ctx = canvas.getContext('2d');
function resizeCanvas() {
canvas.width = window.innerWidth;
canvas.height = window.innerHeight;
}
resizeCanvas();
window.addEventListener('resize', resizeCanvas);
const dots = [];
const dotCount = 80;
const maxDistance = 150;
class Dot {
constructor() {
this.x = Math.random() * canvas.width;
this.y = Math.random() * canvas.height;
this.vx = (Math.random() - 0.5) * 0.3;
this.vy = (Math.random() - 0.5) * 0.3;
this.radius = Math.random() * 1.5 + 0.5;
}
update() {
this.x += this.vx;
this.y += this.vy;
if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
if (this.y < 0 || this.y > canvas.height) this.vy *= -1;
}
draw() {
ctx.beginPath();
ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
ctx.fill();
}
}
for (let i = 0; i < dotCount; i++) {
dots.push(new Dot());
}
function animate() {
ctx.clearRect(0, 0, canvas.width, canvas.height);
dots.forEach(dot => {
dot.update();
dot.draw();
});
for (let i = 0; i < dots.length; i++) {
for (let j = i + 1; j < dots.length; j++) {
const dx = dots[i].x - dots[j].x;
const dy = dots[i].y - dots[j].y;
const distance = Math.sqrt(dx * dx + dy * dy);
if (distance < maxDistance) {
ctx.beginPath();
ctx.moveTo(dots[i].x, dots[i].y);
ctx.lineTo(dots[j].x, dots[j].y);
ctx.strokeStyle = `rgba(255, 255, 255, ${0.1 * (1 - distance / maxDistance)})`;
ctx.lineWidth = 0.3;
ctx.stroke();
}
}
}
requestAnimationFrame(animate);
}
animate();
}
function initEventListeners() {
document.addEventListener('click', handleClick);
}
function handleClick(e) {
console.log('Click detected on:', e.target.className, e.target.tagName);

if (e.target.classList.contains('tab-btn')) {
handleTabSwitch(e.target);
} else if (e.target.closest('.water-glass')) {
handleWaterGlassClick(e.target.closest('.water-glass'));
} else if (e.target.classList.contains('day-btn')) {
handleDaySwitch(e.target);
} else if (e.target.classList.contains('workout-complete') || e.target.closest('.workout-complete')) {
const btn = e.target.classList.contains('workout-complete') ? e.target : e.target.closest('.workout-complete');
console.log('Workout button clicked:', btn);
const dayIndex = btn.getAttribute('data-day');
completeWorkout(dayIndex);
} else if (e.target.classList.contains('diet-complete') || e.target.closest('.diet-complete')) {
const btn = e.target.classList.contains('diet-complete') ? e.target : e.target.closest('.diet-complete');
console.log('Diet button clicked:', btn);
const dayIndex = btn.getAttribute('data-day');
completeDiet(dayIndex);
}
}
function handleTabSwitch(button) {
document.querySelectorAll('.tab-btn').forEach(btn => {
btn.classList.remove('active');
btn.setAttribute('aria-selected', 'false');
});
document.querySelectorAll('.tab-content').forEach(content => {
content.classList.remove('active');
});
button.classList.add('active');
button.setAttribute('aria-selected', 'true');
document.getElementById(button.dataset.tab + '-tab').classList.add('active');
}
function handleWaterGlassClick(glass) {
const glassNumber = parseInt(glass.dataset.glass);
const allGlasses = glass.closest('.water-glasses').querySelectorAll('.water-glass');
allGlasses.forEach((g, index) => {
if (index < glassNumber) {
g.classList.add('filled');
} else {
g.classList.remove('filled');
}
});
showWaterProgress(glass, glassNumber);

// Update hydration data for dashboard
const today = new Date().toDateString();
localStorage.setItem('waterGlasses_' + today, glassNumber.toString());

// Mark as completed if 8 glasses reached
if (glassNumber >= 8) {
    localStorage.setItem('waterCompleted_' + today, 'true');
}

// Notify parent window if in iframe or update directly
if (window.parent && window.parent.calculateHydrationStreak) {
    const newStreak = window.parent.calculateHydrationStreak();
    if (window.parent.document.getElementById('waterStreak')) {
        window.parent.document.getElementById('waterStreak').textContent = newStreak;
    }
} else if (window.calculateHydrationStreak) {
    const newStreak = calculateHydrationStreak();
    if (document.getElementById('waterStreak')) {
        document.getElementById('waterStreak').textContent = newStreak;
    }
}
}
function showWaterProgress(glass, glassNumber) {
const waterCard = glass.closest('.water-tracker-card');
const waterAmount = waterCard.querySelector('.water-amount').textContent;
const totalAmount = parseInt(waterAmount);
const consumedAmount = Math.round((totalAmount / 8) * glassNumber);
const existingMsg = waterCard.querySelector('.progress-msg');
if (existingMsg) existingMsg.remove();
const progressMsg = document.createElement('div');
progressMsg.className = 'progress-msg';
progressMsg.textContent = `Great! You've consumed ${consumedAmount}ml out of ${totalAmount}ml today!`;
waterCard.querySelector('.water-glasses').after(progressMsg);
setTimeout(() => {
if (progressMsg.parentNode) progressMsg.remove();
}, 3000);
}
function handleDaySwitch(button) {
const isWorkout = button.closest('#workout-days-nav');
const navContainer = isWorkout ? DOM.workoutDaysNav : DOM.dietDaysNav;
const contentContainer = isWorkout ? DOM.workoutContent : DOM.dietContent;
const day = button.dataset.day;
navContainer.querySelectorAll('.day-btn').forEach(btn => btn.classList.remove('active'));
contentContainer.querySelectorAll('.day-content').forEach(content => content.classList.remove('active'));
button.classList.add('active');
contentContainer.querySelector(`[data-day="${day}"]`).classList.add('active');
}
    // Daily rotation functions (same as dashboard)
    function getDailyWorkout() {
        const allWorkouts = [
            [{ name: 'Pushups', sets: 3, reps: '8-12', rest: '60 sec' },
             { name: 'Pike Push-ups', sets: 3, reps: '6-10', rest: '60 sec' },
             { name: 'Tricep Dips', sets: 3, reps: '8-12', rest: '60 sec' }],
            [{ name: 'Squats', sets: 4, reps: '12-15', rest: '60 sec' },
             { name: 'Lunges', sets: 3, reps: '10-12', rest: '60 sec' },
             { name: 'Calf Raises', sets: 3, reps: '15-20', rest: '45 sec' }],
            [{ name: 'Plank', sets: 3, reps: '30-60 sec', rest: '60 sec' },
             { name: 'Mountain Climbers', sets: 4, reps: '20-30', rest: '60 sec' },
             { name: 'Jumping Jacks', sets: 3, reps: '30-45', rest: '45 sec' }],
            [{ name: 'Burpees', sets: 3, reps: '6-10', rest: '90 sec' },
             { name: 'Push-up to T', sets: 3, reps: '8-12', rest: '60 sec' },
             { name: 'Jump Squats', sets: 3, reps: '10-15', rest: '60 sec' }]
        ];
        const dayOfYear = Math.floor((new Date() - new Date(new Date().getFullYear(), 0, 0)) / (1000 * 60 * 60 * 24));
        return allWorkouts[dayOfYear % allWorkouts.length];
    }
    
    function getDailyDiet(preference) {
        const allDietPlans = {
            vegetarian: [
                {
                    breakfast: "Oats with banana and almonds (320 cal, 12g protein, 45g carbs, 8g fats)",
                    lunch: "Paneer tikka with quinoa (450 cal, 25g protein, 35g carbs, 18g fats)",
                    dinner: "Dal with brown rice (380 cal, 15g protein, 55g carbs, 6g fats)",
                    snacks: "Greek yogurt with berries (180 cal, 15g protein, 20g carbs, 5g fats)"
                },
                {
                    breakfast: "Vegetable upma with chutney (300 cal, 8g protein, 50g carbs, 7g fats)",
                    lunch: "Chickpea curry with roti (420 cal, 18g protein, 60g carbs, 10g fats)",
                    dinner: "Vegetable biryani with raita (400 cal, 12g protein, 65g carbs, 8g fats)",
                    snacks: "Roasted chickpeas (150 cal, 8g protein, 22g carbs, 3g fats)"
                }
            ]
        };
        const plans = allDietPlans[preference] || allDietPlans['vegetarian'];
        const dayOfYear = Math.floor((new Date() - new Date(new Date().getFullYear(), 0, 0)) / (1000 * 60 * 60 * 24));
        return plans[dayOfYear % plans.length];
    }

    async function loadPlans() {
        try {
            DOM.loading.style.display = 'block';
            DOM.noPlans.style.display = 'none';
            DOM.plansContainer.style.display = 'none';

            // 1. Try LocalStorage first (immediate post-onboarding)
            const localWorkout = localStorage.getItem('workoutPlan');
            const localDiet = localStorage.getItem('dietPlan');

            if (localWorkout && localDiet) {
                console.log('Loading plans from LocalStorage');
                state.workout = JSON.parse(localWorkout);
                state.diet = JSON.parse(localDiet);
                
                // Ensure array format
                if (!Array.isArray(state.workout)) state.workout = [state.workout];
                if (!Array.isArray(state.diet)) state.diet = [state.diet];
                
                displayPlans();
                return;
            }

            // 2. Fetch from Backend (returning user)
            console.log('Fetching plans from backend...');
            
            // Get token
            const serverToken = "{{token}}";
            const urlParams = new URLSearchParams(window.location.search);
            const token = serverToken && serverToken !== "{{token}}" ? serverToken : 
                         urlParams.get('token') || 
                         localStorage.getItem('token');

            if (!token) {
                throw new Error('No authentication token found');
            }

            // We need userId. Let's get it from the token or a profile endpoint.
            // For now, let's assume we can get it from a profile endpoint or the token payload if decoded (but we can't decode easily here without lib).
            // Better approach: Use an endpoint that uses the token to identify the user, OR fetch profile first.
            
            // Let's fetch the user profile first to get the ID
            const profileResponse = await fetch('/api/auth/me', { // Assuming this exists or similar
                 headers: { 'Authorization': `Bearer ${token}` }
            });
            
            // Fallback: If /me doesn't exist, try to use the test-auth endpoint which returns user info
             const authResponse = await fetch('/api/performance/test-auth', {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            
            if (!authResponse.ok) throw new Error('Failed to authenticate');
            const authData = await authResponse.json();
            const userId = authData.user.id || authData.user._id;

            // Now fetch plans
            const [workoutRes, dietRes] = await Promise.all([
                fetch(`/api/workout/workout/${userId}`, { headers: { 'Authorization': `Bearer ${token}` } }),
                fetch(`/api/diet/diet/${userId}`, { headers: { 'Authorization': `Bearer ${token}` } })
            ]);

            if (workoutRes.ok) {
                const workoutData = await workoutRes.json();
                // The backend now returns { ...plan, workoutPlan: [...] } or just the plan object
                // We updated the service to return { ...workoutPlanObj, workoutPlan: [...] }
                state.workout = workoutData.workoutPlan || []; 
            }

            if (dietRes.ok) {
                const dietData = await dietRes.json();
                // Diet service returns { dbPlan: ..., aiPlan: ... } usually, but let's check what the GET returns
                // The GET /diet/:userId calls getDietPlanByUserId which returns the DB object.
                // The DB object has `mealDetails.data` which is the plan array.
                state.diet = dietData.mealDetails?.data || [];
            }

            if ((!state.workout || state.workout.length === 0) && (!state.diet || state.diet.length === 0)) {
                showNoPlans();
            } else {
                displayPlans();
            }

        } catch (error) {
            console.error('Error loading plans:', error);
            showNoPlans();
        }
    }
function displayPlans() {
DOM.loading.style.display = 'none';
DOM.plansContainer.style.display = 'block';
if (state.workout.length) renderWorkoutPlan();
if (state.diet.length) renderDietPlan();
}
function renderWorkoutPlan() {
DOM.workoutDaysNav.innerHTML = state.workout
.map((day, i) => `
<button class="day-btn ${i === 0 ? 'active' : ''}" data-day="${i}">
${day.day}
</button>
`)
.join('');
DOM.workoutContent.innerHTML = state.workout
.map((day, i) => `
<div class="day-content ${i === 0 ? 'active' : ''}" data-day="${i}">
<div class="card">
<div class="card-header">
<div class="card-title">📅 ${day.day}</div>
<div class="focus-badge">${day.focus}</div>
</div>
<div class="exercises-grid">
${day.exercises.map(exercise => createExerciseCard(exercise)).join('')}
</div>
<button class="complete-btn workout-complete" data-day="${i}" type="button" onclick="completeWorkout('${i}')">
  ✅ Mark Workout Complete
</button>
</div>
</div>
`)
.join('');
}
function createExerciseCard(exercise) {
const steps = getExerciseSteps(exercise.name);
return `
<div class="exercise-card">
<div class="exercise-name">💪 ${exercise.name}</div>
<div class="exercise-meta">
<span class="meta-badge">${exercise.sets} sets × ${exercise.reps} reps</span>
<span class="meta-badge">Rest: ${exercise.rest}</span>
<span class="meta-badge">${exercise.duration || exercise.estimatedCalories || '15'} ${exercise.duration ? 'min' : 'cal'}</span>
</div>
<div class="exercise-desc">${exercise.description || exercise.notes || 'Complete this exercise with proper form'}</div>
${steps ? `<div class="exercise-steps"><strong>How to do it:</strong><ol>${steps.map(step => `<li>${step}</li>`).join('')}</ol></div>` : ''}
</div>
`;
}

function getExerciseSteps(exerciseName) {
const exerciseSteps = {
'Push-ups': [
'Start in plank position with hands shoulder-width apart',
'Lower your body until chest nearly touches the floor',
'Push back up to starting position',
'Keep your core tight throughout the movement'
],
'Pushups': [
'Start in plank position with hands shoulder-width apart',
'Lower your body until chest nearly touches the floor',
'Push back up to starting position',
'Keep your core tight throughout the movement'
],
'Squats': [
'Stand with feet shoulder-width apart',
'Lower your body by bending knees and pushing hips back',
'Go down until thighs are parallel to floor',
'Push through heels to return to starting position'
],
'Plank': [
'Start in push-up position',
'Lower onto forearms, keeping body straight',
'Hold position while engaging core muscles',
'Breathe normally and maintain straight line from head to heels'
],
'Burpees': [
'Start standing, then squat down and place hands on floor',
'Jump feet back into plank position',
'Do a push-up (optional)',
'Jump feet back to squat position',
'Jump up with arms overhead'
],
'Lunges': [
'Stand with feet hip-width apart',
'Step forward with one leg, lowering hips',
'Lower until both knees are bent at 90 degrees',
'Push back to starting position and repeat with other leg'
],
'Mountain Climbers': [
'Start in plank position',
'Bring right knee toward chest',
'Quickly switch legs, bringing left knee to chest',
'Continue alternating legs at a fast pace'
],
'Jumping Jacks': [
'Start standing with feet together, arms at sides',
'Jump while spreading legs shoulder-width apart',
'Simultaneously raise arms overhead',
'Jump back to starting position'
],
'Deadlifts': [
'Stand with feet hip-width apart, barbell over mid-foot',
'Bend at hips and knees to grip the bar',
'Keep chest up and back straight',
'Drive through heels to lift the bar up',
'Stand tall, then lower bar back down with control'
],
'Pull-ups': [
'Hang from pull-up bar with palms facing away',
'Start with arms fully extended',
'Pull your body up until chin clears the bar',
'Lower yourself back down with control'
],
'Dips': [
'Grip parallel bars or chair edges',
'Start with arms straight, supporting your weight',
'Lower your body by bending elbows',
'Push back up to starting position'
]
};

// Direct match first
const directMatch = exerciseSteps[exerciseName];
if (directMatch) return directMatch;

// Then try partial matching
for (const [key, steps] of Object.entries(exerciseSteps)) {
if (exerciseName.toLowerCase().includes(key.toLowerCase()) || key.toLowerCase().includes(exerciseName.toLowerCase())) {
return steps;
}
}

// Debug log
console.log('No steps found for exercise:', exerciseName);
return null;
}
function renderDietPlan() {
DOM.dietDaysNav.innerHTML = state.diet
.map((day, i) => `
<button class="day-btn ${i === 0 ? 'active' : ''}" data-day="${i}">
${day.day}
</button>
`)
.join('');
DOM.dietContent.innerHTML = state.diet
.map((day, i) => `
<div class="day-content ${i === 0 ? 'active' : ''}" data-day="${i}">
<div class="card">
<div class="card-header">
<div class="card-title">📅 ${day.day}</div>
${day.waterIntake ? `<div class="focus-badge">💧 ${day.waterIntake}</div>` : `<div class="focus-badge">💧 2500ml (daily target)</div>`}
</div>
${createWaterTracker(day.waterIntake || '2500ml (daily target)')}
<div class="meals-grid">
${Object.entries(day.meals).map(([type, meal]) => createMealCard(type, meal)).join('')}
</div>
<button class="complete-btn diet-complete" data-day="${i}" type="button" onclick="window.completeDiet('${i}'); return false;">
  ✅ Mark Diet Complete
</button>
</div>
</div>
`)
.join('');
}
function createWaterTracker(waterIntake) {
const totalAmount = parseInt(waterIntake);
const glassAmount = Math.round(totalAmount / 8);
return `
<div class="water-tracker-card">
<div class="water-header">
<span class="water-icon">💧</span>
<div class="water-info">
<span class="water-title">Daily Water Intake</span>
<span class="water-subtitle">Based on your body weight</span>
</div>
<span class="water-amount">${waterIntake}</span>
</div>
<div class="water-progress">
<div class="water-glasses">
${Array.from({length: 8}, (_, i) => `
<div class="water-glass" data-glass="${i + 1}">
<div class="glass-fill"></div>
<span class="glass-label">${glassAmount}ml</span>
</div>
`).join('')}
</div>
<div class="water-tips">
<div class="tip-item">• Calculated as 35ml per kg of body weight</div>
<div class="tip-item">• Drink a glass when you wake up</div>
<div class="tip-item">• Have water before each meal</div>
<div class="tip-item">• Increase intake during workouts</div>
</div>
</div>
</div>
`;
}
function createMealCard(type, meal) {
const icons = {
breakfast: '🍳',
snack1: '🍎',
lunch: '🍽️',
snack2: '🥜',
dinner: '🍴'
};
const mealData = typeof meal === 'object' ? meal : { item: meal };
const icon = icons[type] || '🍽️';
const name = type.charAt(0).toUpperCase() + type.slice(1).replace(/([0-9])/g, ' $1');
const mealTime = mealData.time ? `<span class="meal-time">${mealData.time}</span>` : '';

// Extract nutrition from meal text if it contains calories info
let nutritionInfo = '';
let mealText = mealData.item || mealData.original || meal;

// Check if meal text contains nutrition info in format "(320 cal, 12g protein, 45g carbs, 8g fats)"
const nutritionMatch = mealText.match(/\((\d+)\s*cal(?:,\s*(\d+)g\s*protein)?(?:,\s*(\d+)g\s*carbs)?(?:,\s*(\d+)g\s*fats)?\)/);
if (nutritionMatch) {
    const [, calories, protein, carbs, fats] = nutritionMatch;
    nutritionInfo = `
    <div class="nutrition">
        <span class="nutrition-item">🔥 ${calories} cal</span>
        ${protein ? `<span class="nutrition-item">🥩 ${protein}g protein</span>` : ''}
        ${carbs ? `<span class="nutrition-item">🍞 ${carbs}g carbs</span>` : ''}
        ${fats ? `<span class="nutrition-item">🧈 ${fats}g fats</span>` : ''}
    </div>`;
    // Remove nutrition info from meal text for cleaner display
    mealText = mealText.replace(nutritionMatch[0], '').trim();
} else if (mealData.calories) {
    nutritionInfo = createNutritionInfo(mealData);
}

return `
<div class="meal-card">
<div class="meal-header">
<span class="meal-icon">${icon}</span>
<div class="meal-info">
<span class="meal-name">${name}</span>
${mealTime}
</div>
</div>
<div class="meal-desc">${mealText}</div>
${nutritionInfo}
<div class="calorie-info">💡 <small>kcal = energy from food</small></div>
${mealData.benefits?.length ? createBenefitsInfo(mealData.benefits) : ''}
</div>
`;
}
function createNutritionInfo(mealData) {
if (!mealData.calories && !mealData.protein && !mealData.carbs && !mealData.fats) {
    return '';
}
return `
<div class="nutrition">
${mealData.calories ? `<span class="nutrition-item">🔥 ${mealData.calories} cal</span>` : ''}
${mealData.protein ? `<span class="nutrition-item">🥩 ${mealData.protein}g protein</span>` : ''}
${mealData.carbs ? `<span class="nutrition-item">🍞 ${mealData.carbs}g carbs</span>` : ''}
${mealData.fats ? `<span class="nutrition-item">🧈 ${mealData.fats}g fats</span>` : ''}
</div>
`;
}
function createBenefitsInfo(benefits) {
return `
