// Test authentication function
async function testAuthentication() {
    try {
        const serverToken = "{{token}}";
        const urlParams = new URLSearchParams(window.location.search);
        const token = serverToken && serverToken !== "{{token}}" ? serverToken : 
                     urlParams.get('token') || 
                     localStorage.getItem('token') || 
                     sessionStorage.getItem('token');
        
        console.log('Testing authentication with token:', token ? token.substring(0, 20) + '...' : 'null');
        
        if (!token) {
            alert('No token found!');
            return;
        }
        
        const response = await fetch('/api/performance/test-auth', {
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            }
        });
        
        const result = await response.json();
        console.log('Auth test result:', result);
        
        if (response.ok) {
            alert(`Auth Success! User: ${result.user.userName}`);
        } else {
            alert(`Auth Failed: ${result.message}`);
        }
    } catch (error) {
        console.error('Auth test error:', error);
        alert('Auth test failed: ' + error.message);
    }
}

