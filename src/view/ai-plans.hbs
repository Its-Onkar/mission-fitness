};

function initEventListeners() {
    // Direct event listeners for buttons after they're created
    document.addEventListener('click', handleGlobalClick, true);
}

function handleGlobalClick(e) {
    console.log('Global click:', e.target.tagName, e.target.className);
    
    // Diet complete button
    if (e.target.matches('.diet-complete') || e.target.closest('.diet-complete')) {
        e.preventDefault();
        e.stopPropagation();
        const btn = e.target.matches('.diet-complete') ? e.target : e.target.closest('.diet-complete');
        const dayIndex = btn.getAttribute('data-day');
        console.log('Diet button clicked, day:', dayIndex);
        completeDiet(dayIndex);
        return false;
    }
    
    // Workout complete button
    if (e.target.matches('.workout-complete') || e.target.closest('.workout-complete')) {
        e.preventDefault();
        e.stopPropagation();
        const btn = e.target.matches('.workout-complete') ? e.target : e.target.closest('.workout-complete');
        const dayIndex = btn.getAttribute('data-day');
        console.log('Workout button clicked, day:', dayIndex);
        completeWorkout(dayIndex);
        return false;
    }
    
    // Other buttons
    if (e.target.closest('.tab-btn')) handleTabSwitch(e.target.closest('.tab-btn'));
    if (e.target.closest('.day-btn')) handleDaySwitch(e.target.closest('.day-btn'));
    if (e.target.closest('.water-glass')) handleWaterGlassClick(e.target.closest('.water-glass'));
    if (e.target.closest('#testAuthBtn')) testAuthentication();
    if (e.target.closest('#continueToDashboard')) handleContinueToDashboard();
}

