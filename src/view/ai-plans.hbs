function generateDailyWorkoutVariations(basePlan) {
const today = new Date().getDay();
return basePlan.map((day, index) => {
const dayOffset = (today + index) % 7;
const variations = {
sets: [3, 4, 5],
reps: ['8-10', '10-12', '12-15'],
rest: ['60 sec', '90 sec', '120 sec']
};
return {
...day,
exercises: day.exercises.map(exercise => ({
...exercise,
sets: variations.sets[dayOffset % 3],
reps: variations.reps[dayOffset % 3],
rest: variations.rest[dayOffset % 3],
estimatedCalories: exercise.estimatedCalories + (dayOffset * 5)
}))
};
});
}
function generateDailyDietVariations(basePlan) {
return basePlan.map((day, index) => {
const newMeals = {};
Object.keys(day.meals).forEach(mealType => {
const originalMeal = day.meals[mealType];
if (typeof originalMeal === 'string') {
const mealTimings = {
breakfast: '8:00 AM',
snack1: '11:00 AM', 
lunch: '1:30 PM',
snack2: '5:00 PM',
dinner: '8:00 PM'
};
newMeals[mealType] = {
item: originalMeal,
time: mealTimings[mealType] || '12:00 PM'
};
} else {
newMeals[mealType] = originalMeal;
}
});
return {
...day,
meals: newMeals,
waterIntake: day.waterIntake
};
});
}
async function completeWorkout(dayIndex) {
  try {
    // Get the button first to provide immediate feedback
    const btn = document.querySelector(`.workout-complete[data-day="${dayIndex}"]`);
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Processing...';
      btn.style.background = '#6c757d';
    }
    
    const serverToken = "{{token}}";
    const urlParams = new URLSearchParams(window.location.search);
    const token = serverToken && serverToken !== "{{token}}" ? serverToken : 
                 urlParams.get('token') || 
                 localStorage.getItem('token') || 
                 sessionStorage.getItem('token');
    
    if (!token) {
      if (btn) {
        btn.disabled = false;
        btn.textContent = '✅ Mark Workout Complete';
        btn.style.background = '';
      }
      alert('Please login first');
      window.location.href = '/login';
      return;
    }
    
    const response = await fetch('/api/performance/workout/complete', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
      }
    });
    
    if (response.status === 401) {
      if (btn) {
        btn.disabled = false;
        btn.textContent = '✅ Mark Workout Complete';
        btn.style.background = '';
      }
      alert('Session expired. Please login again.');
      window.location.href = '/login';
      return;
    }
    
    const result = await response.json();
    if (response.ok) {
      if (btn) {
        btn.textContent = '✓ Workout Completed!';
        btn.disabled = true;
        btn.style.background = '#28a745';
      }
      alert(`Great job! Streak: ${result.streak || 0}, Score: ${result.score || 0}`);
    } else {
      if (btn) {
        btn.disabled = false;
        btn.textContent = '✅ Mark Workout Complete';
        btn.style.background = '';
      }
      alert(result.message || 'Failed to mark workout complete');
    }
  } catch (error) {
    console.error('Error completing workout:', error);
    const btn = document.querySelector(`.workout-complete[data-day="${dayIndex}"]`);
    if (btn) {
      btn.disabled = false;
      btn.textContent = '✅ Mark Workout Complete';
      btn.style.background = '';
    }
    alert('Failed to mark workout complete: ' + error.message);
  }
}

