<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Activity - Mission Fitness</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f0f0f 0%, #1a1a1a 50%, #2a2a2a 100%);
            color: #ffffff;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
            position: relative;
        }

        .header h1 {
            font-size: 3rem;
            font-weight: 900;
            background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        .header p {
            font-size: 1.2rem;
            color: #888;
            margin-bottom: 20px;
        }

        .streak-badge {
            display: inline-flex;
            align-items: center;
            background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .streak-badge i {
            margin-right: 8px;
        }

        .main-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 40px;
        }

        .activity-card {
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.8) 0%, rgba(20, 20, 20, 0.9) 100%);
            border-radius: 20px;
            padding: 30px;
            border: 1px solid rgba(249, 115, 22, 0.2);
            position: relative;
            overflow: hidden;
        }

        .activity-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: 700;
            display: flex;
            align-items: center;
        }

        .card-title i {
            margin-right: 12px;
            color: #f97316;
            font-size: 1.3rem;
        }

        .progress-ring {
            width: 60px;
            height: 60px;
            position: relative;
        }

        .progress-ring svg {
            width: 100%;
            height: 100%;
            transform: rotate(-90deg);
        }

        .progress-ring circle {
            fill: none;
            stroke-width: 4;
        }

        .progress-ring .bg {
            stroke: rgba(255, 255, 255, 0.1);
        }

        .progress-ring .progress {
            stroke: #f97316;
            stroke-linecap: round;
            transition: stroke-dasharray 0.5s ease;
        }

        .progress-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-weight: 700;
            font-size: 0.9rem;
        }

        .exercise-list, .meal-list {
            space-y: 15px;
        }

        .exercise-item, .meal-item {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 15px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .exercise-item:hover, .meal-item:hover {
            background: rgba(249, 115, 22, 0.1);
            border-color: rgba(249, 115, 22, 0.3);
            transform: translateY(-2px);
        }

        .exercise-item.completed, .meal-item.completed {
            background: rgba(34, 197, 94, 0.1);
            border-color: rgba(34, 197, 94, 0.3);
        }

        .item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .item-name {
            font-weight: 600;
            font-size: 1.1rem;
        }

        .item-status {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            border: 2px solid #f97316;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .item-status.completed {
            background: #22c55e;
            border-color: #22c55e;
        }

        .item-details {
            display: flex;
            gap: 20px;
            font-size: 0.9rem;
            color: #888;
        }

        .item-detail {
            display: flex;
            align-items: center;
        }

        .item-detail i {
            margin-right: 6px;
            color: #f97316;
        }

        .water-tracker {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(147, 197, 253, 0.1) 100%);
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 20px;
            padding: 25px;
            text-align: center;
            margin-bottom: 30px;
        }

        .water-progress {
            width: 200px;
            height: 200px;
            margin: 0 auto 20px;
            position: relative;
        }

        .water-wave {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6 0%, #93c5fd 100%);
            position: relative;
            overflow: hidden;
        }

        .wave {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 50%;
            background: rgba(59, 130, 246, 0.3);
            border-radius: 50%;
            animation: wave 2s ease-in-out infinite;
        }

        @keyframes wave {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(180deg); }
        }

        .water-controls {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 20px;
        }

        .water-btn {
            background: linear-gradient(135deg, #3b82f6 0%, #93c5fd 100%);
            border: none;
            border-radius: 12px;
            padding: 12px 20px;
            color: white;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .water-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.3);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 900;
            color: #f97316;
            margin-bottom: 5px;
        }

        .stat-label {
            font-size: 0.9rem;
            color: #888;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 30px;
        }

        .action-btn {
            background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
            border: none;
            border-radius: 12px;
            padding: 15px 30px;
            color: white;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(249, 115, 22, 0.3);
        }

        .action-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        .motivation-card {
            background: linear-gradient(135deg, rgba(249, 115, 22, 0.1) 0%, rgba(251, 146, 60, 0.1) 100%);
            border: 1px solid rgba(249, 115, 22, 0.2);
            border-radius: 20px;
            padding: 25px;
            text-align: center;
            margin-bottom: 30px;
        }

        .motivation-text {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .tip-text {
            font-size: 1rem;
            color: #888;
        }

        @media (max-width: 768px) {
            .main-grid {
                grid-template-columns: 1fr;
            }
            
            .header h1 {
                font-size: 2rem;
            }
            
            .container {
                padding: 15px;
            }
            
            .activity-card {
                padding: 20px;
            }
        }

        .loading {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 200px;
        }

        .spinner {
            width: 40px;
            height: 40px;
            border: 4px solid rgba(249, 115, 22, 0.3);
            border-top: 4px solid #f97316;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Daily Activity</h1>
            <p id="current-date"></p>
            <div class="streak-badge">
                <i class="fas fa-fire"></i>
                <span id="streak-count">0 Day Streak</span>
            </div>
        </div>

        <div id="loading" class="loading">
            <div class="spinner"></div>
        </div>

        <div id="content" style="display: none;">
            <!-- Motivation Card -->
            <div class="motivation-card">
                <div class="motivation-text" id="motivation-text">Loading motivation...</div>
                <div class="tip-text" id="tip-text">Loading tip...</div>
            </div>

            <!-- Water Tracker -->
            <div class="water-tracker">
                <h3>💧 Water Intake</h3>
                <div class="water-progress">
                    <div class="water-wave">
                        <div class="wave" id="water-wave"></div>
                    </div>
                </div>
                <div>
                    <span id="current-water">0</span>ml / <span id="target-water">2500</span>ml
                </div>
                <div class="water-controls">
                    <button class="water-btn" onclick="addWater(250)">+250ml</button>
                    <button class="water-btn" onclick="addWater(500)">+500ml</button>
                    <button class="water-btn" onclick="addWater(750)">+750ml</button>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-value" id="workout-progress">0%</div>
                    <div class="stat-label">Workout Progress</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="diet-progress">0%</div>
                    <div class="stat-label">Diet Progress</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="calories-burned">0</div>
                    <div class="stat-label">Calories Burned</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="calories-consumed">0</div>
                    <div class="stat-label">Calories Consumed</div>
                </div>
            </div>

            <!-- Main Activity Grid -->
            <div class="main-grid">
                <!-- Workout Card -->
                <div class="activity-card">
                    <div class="card-header">
                        <div class="card-title">
                            <i class="fas fa-dumbbell"></i>
                            Today's Workout
                        </div>
                        <div class="progress-ring">
                            <svg>
                                <circle class="bg" cx="30" cy="30" r="26"></circle>
                                <circle class="progress" cx="30" cy="30" r="26" id="workout-circle"></circle>
                            </svg>
                            <div class="progress-text" id="workout-percent">0%</div>
                        </div>
                    </div>
                    <div class="exercise-list" id="exercise-list">
                        <!-- Exercises will be loaded here -->
                    </div>
                    <div class="action-buttons">
                        <button class="action-btn" id="complete-workout-btn" onclick="completeWorkout()">
                            <i class="fas fa-check"></i>
                            Complete Workout
                        </button>
                        <button class="action-btn" onclick="regenerateWorkout()">
                            <i class="fas fa-sync"></i>
                            Regenerate
                        </button>
                    </div>
                </div>

                <!-- Diet Card -->
                <div class="activity-card">
                    <div class="card-header">
                        <div class="card-title">
                            <i class="fas fa-utensils"></i>
                            Today's Meals
                        </div>
                        <div class="progress-ring">
                            <svg>
                                <circle class="bg" cx="30" cy="30" r="26"></circle>
                                <circle class="progress" cx="30" cy="30" r="26" id="diet-circle"></circle>
                            </svg>
                            <div class="progress-text" id="diet-percent">0%</div>
                        </div>
                    </div>
                    <div class="meal-list" id="meal-list">
                        <!-- Meals will be loaded here -->
                    </div>
                    <div class="action-buttons">
                        <button class="action-btn" id="complete-diet-btn" onclick="completeDiet()">
                            <i class="fas fa-check"></i>
                            Complete Diet
                        </button>
                        <button class="action-btn" onclick="regenerateDiet()">
                            <i class="fas fa-sync"></i>
                            Regenerate
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentActivity = null;
        const token = new URLSearchParams(window.location.search).get('token') || 
                     localStorage.getItem('token') || 
                     sessionStorage.getItem('token');

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            if (!token) {
                window.location.href = '/login';
                return;
            }
            
            loadTodayActivity();
            updateCurrentDate();
        });

        // Update current date
        function updateCurrentDate() {
            const now = new Date();
            const options = { 
                weekday: 'long', 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
            };
            document.getElementById('current-date').textContent = now.toLocaleDateString('en-US', options);
        }

        // Load today's activity
        async function loadTodayActivity() {
            try {
                const response = await fetch('/api/daily-activity/today', {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (!response.ok) {
                    throw new Error('Failed to load activity');
                }

                const result = await response.json();
                currentActivity = result.data;
                
                renderActivity();
                document.getElementById('loading').style.display = 'none';
                document.getElementById('content').style.display = 'block';
                
            } catch (error) {
                console.error('Error loading activity:', error);
                alert('Failed to load today\'s activity');
            }
        }

        // Render activity data
        function renderActivity() {
            if (!currentActivity) return;

            // Update motivation and tips
            document.getElementById('motivation-text').textContent = currentActivity.motivation || "Let's make today count! 💪";
            document.getElementById('tip-text').textContent = currentActivity.tips || "Stay consistent and trust the process!";

            // Update streak
            document.getElementById('streak-count').textContent = `${currentActivity.streakCount || 0} Day Streak`;

            // Update water intake
            updateWaterDisplay();

            // Update stats
            updateStats();

            // Render exercises
            renderExercises();

            // Render meals
            renderMeals();

            // Update progress circles
            updateProgressCircles();
        }

        // Update water display
        function updateWaterDisplay() {
            const current = currentActivity.dietPlan?.currentWaterIntake || 0;
            const target = parseInt(currentActivity.dietPlan?.waterIntake?.replace('ml', '')) || 2500;
            
            document.getElementById('current-water').textContent = current;
            document.getElementById('target-water').textContent = target;
            
            const percentage = Math.min((current / target) * 100, 100);
            const wave = document.getElementById('water-wave');
            wave.style.height = `${percentage}%`;
        }

        // Update stats
        function updateStats() {
            const progress = currentActivity.progress || {};
            
            document.getElementById('workout-progress').textContent = `${progress.workout || 0}%`;
            document.getElementById('diet-progress').textContent = `${progress.diet || 0}%`;
            document.getElementById('calories-burned').textContent = currentActivity.workoutPlan?.totalCaloriesBurned || 0;
            document.getElementById('calories-consumed').textContent = currentActivity.dietPlan?.totalCaloriesConsumed || 0;
        }

        // Render exercises
        function renderExercises() {
            const exerciseList = document.getElementById('exercise-list');
            const exercises = currentActivity.workoutPlan?.exercises || [];
            
            exerciseList.innerHTML = exercises.map((exercise, index) => `
                <div class="exercise-item ${exercise.completed ? 'completed' : ''}" onclick="toggleExercise(${index})">
                    <div class="item-header">
                        <div class="item-name">${exercise.name}</div>
                        <div class="item-status ${exercise.completed ? 'completed' : ''}">
                            ${exercise.completed ? '<i class="fas fa-check"></i>' : ''}
                        </div>
                    </div>
                    <div class="item-details">
                        <div class="item-detail">
                            <i class="fas fa-repeat"></i>
                            ${exercise.sets} sets
                        </div>
                        <div class="item-detail">
                            <i class="fas fa-hashtag"></i>
                            ${exercise.reps} reps
                        </div>
                        <div class="item-detail">
                            <i class="fas fa-clock"></i>
                            ${exercise.rest} rest
                        </div>
                        <div class="item-detail">
                            <i class="fas fa-fire"></i>
                            ${exercise.estimatedCalories || 0} cal
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Render meals
        function renderMeals() {
            const mealList = document.getElementById('meal-list');
            const meals = currentActivity.dietPlan?.meals || {};
            
            const mealTypes = ['breakfast', 'snack1', 'lunch', 'snack2', 'dinner'];
            const mealNames = {
                breakfast: 'Breakfast',
                snack1: 'Morning Snack',
                lunch: 'Lunch',
                snack2: 'Evening Snack',
                dinner: 'Dinner'
            };
            
            mealList.innerHTML = mealTypes.map(type => {
                const meal = meals[type];
                if (!meal) return '';
                
                return `
                    <div class="meal-item ${meal.completed ? 'completed' : ''}" onclick="toggleMeal('${type}')">
                        <div class="item-header">
                            <div class="item-name">${mealNames[type]}</div>
                            <div class="item-status ${meal.completed ? 'completed' : ''}">
                                ${meal.completed ? '<i class="fas fa-check"></i>' : ''}
                            </div>
                        </div>
                        <div class="item-details">
                            <div class="item-detail">
                                <i class="fas fa-utensils"></i>
                                ${meal.food}
                            </div>
                            <div class="item-detail">
                                <i class="fas fa-clock"></i>
                                ${meal.time}
                            </div>
                            <div class="item-detail">
                                <i class="fas fa-fire"></i>
                                ${meal.calories} cal
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Update progress circles
        function updateProgressCircles() {
            const progress = currentActivity.progress || {};
            
            updateCircle('workout-circle', 'workout-percent', progress.workout || 0);
            updateCircle('diet-circle', 'diet-percent', progress.diet || 0);
        }

        // Update individual circle
        function updateCircle(circleId, textId, percentage) {
            const circle = document.getElementById(circleId);
            const text = document.getElementById(textId);
            
            const circumference = 2 * Math.PI * 26;
            const offset = circumference - (percentage / 100) * circumference;
            
            circle.style.strokeDasharray = circumference;
            circle.style.strokeDashoffset = offset;
            text.textContent = `${percentage}%`;
        }

        // Toggle exercise completion
        async function toggleExercise(index) {
            try {
                const response = await fetch('/api/daily-activity/complete-exercise', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ exerciseIndex: index })
                });

                if (response.ok) {
                    await loadTodayActivity();
                }
            } catch (error) {
                console.error('Error toggling exercise:', error);
            }
        }

        // Toggle meal completion
        async function toggleMeal(mealType) {
            try {
                const response = await fetch('/api/daily-activity/complete-meal', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ mealType })
                });

                if (response.ok) {
                    await loadTodayActivity();
                }
            } catch (error) {
                console.error('Error toggling meal:', error);
            }
        }

        // Add water intake
        async function addWater(amount) {
            try {
                const response = await fetch('/api/daily-activity/water-intake', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ amount })
                });

                if (response.ok) {
                    await loadTodayActivity();
                }
            } catch (error) {
                console.error('Error updating water intake:', error);
            }
        }

        // Complete entire workout
        async function completeWorkout() {
            try {
                const response = await fetch('/api/daily-activity/complete-workout', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({})
                });

                if (response.ok) {
                    await loadTodayActivity();
                    alert('Workout completed! Great job! 💪');
                }
            } catch (error) {
                console.error('Error completing workout:', error);
            }
        }

        // Complete entire diet
        async function completeDiet() {
            try {
                const response = await fetch('/api/daily-activity/complete-diet', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({})
                });

                if (response.ok) {
                    await loadTodayActivity();
                    alert('Diet plan completed! Excellent nutrition! 🥗');
                }
            } catch (error) {
                console.error('Error completing diet:', error);
            }
        }

        // Regenerate workout
        async function regenerateWorkout() {
            try {
                const response = await fetch('/api/daily-activity/regenerate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ type: 'workout' })
                });

                if (response.ok) {
                    await loadTodayActivity();
                    alert('New workout generated! 🔄');
                }
            } catch (error) {
                console.error('Error regenerating workout:', error);
            }
        }

        // Regenerate diet
        async function regenerateDiet() {
            try {
                const response = await fetch('/api/daily-activity/regenerate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ type: 'diet' })
                });

                if (response.ok) {
                    await loadTodayActivity();
                    alert('New meal plan generated! 🍽️');
                }
            } catch (error) {
                console.error('Error regenerating diet:', error);
            }
        }
    </script>
</body>
</html>