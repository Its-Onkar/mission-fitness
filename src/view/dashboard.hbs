<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mission Fitness AI - Your Personal Fitness Assistant</title>
    <meta name="description" content="Transform your fitness journey with AI-powered workout plans, nutrition guidance, and personalized coaching. Get started with Mission Fitness AI today.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {

            font-family: 'Inter', sans-serif;
            background-color: black;

            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background-image: linear-gradient(to bottom, rgba(66, 38, 19, 0.7), rgba(11, 11, 11)), url('images/image.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            color: #ffffff;
            overflow-x: hidden;
           

        }

        /* Header Styles */
        .header {
            width: 100%;
            padding: 1.5rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            animation: fadeInUp 0.8s ease-out;
            background-color: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .logo-text {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            color: #ffffff;
            animation: pulse 2s ease-in-out infinite;
        }

        .logo-text-gray {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            color: #8c8c8c;
        }

        .cta-button {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.625rem 1.25rem;
            background-color: rgba(26, 26, 26, 0.5);
            border: 1px solid rgba(51, 51, 51, 1);
            border-radius: 0.5rem;
            color: #ffffff;
            font-weight: 600;
            font-size: 0.875rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .cta-button:hover {
            background-color: rgba(38, 38, 38, 1);
            transform: scale(1.05);
        }

        .cta-icon {
            width: 1.25rem;
            height: 1.25rem;
        }

        /* Main Container */
        .main-container {
            flex: 1;
           
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            padding: 3rem 1.5rem;
        }

        .main-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
          
            background: linear-gradient(45deg, rgba(100, 100, 100, 0.1), rgba(50, 50, 50, 0.2), rgba(100, 100, 100, 0.1), transparent);
            background-size: 400%;
            animation: rotateGradient 25s ease-in-out infinite;
            pointer-events: none;
            opacity: 0.4;
        }

        .main-container::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
           
            background-image: radial-gradient(circle, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
            background-size: 100px 100px;
            opacity: 0.3;
            pointer-events: none;
            animation: floatParticles 30s linear infinite;
        }

        /* Hero Title */
        .hero-title {
            text-align: center;
            opacity: 0;
            transform: translateY(10px);
            animation: fadeInUp 1s ease-out forwards;
            z-index: 10;
            position: relative;
        }


        .input-glow::placeholder {
            color: gray;
            opacity: 50%;
        }

        @keyframes scrollMarquee {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }

        .marquee {
            display: flex;
            width: 100%;
            overflow: hidden;
            white-space: nowrap;
        }

        .marquee-track {
            display: flex;
            animation: scrollMarquee 15s linear infinite;
        }

        .main {
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: 2rem;
        }

        .loaders,
        .loadersB {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .loader {

        .hero-title::before {
            content: '';

            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            animation: shimmer 3s ease-in-out infinite;
            z-index: -1;
        }

        .hero-title h1 {
            font-size: clamp(2.5rem, 8vw, 4.5rem);
            font-weight: 600;
            line-height: 1.1;
            letter-spacing: -0.025em;
        }

        .title-welcome {
            display: block;
            color: #ffffff;
            margin-bottom: 1rem;
        }

        .title-mission {
            color: #ffffff;
        }

        .title-fitness {
            color: rgba(255, 102, 0, 0.5);
        }

        /* Fitness Loader */
        .loader-container {
            position: relative;
            width: 16rem;
            height: 16rem;
            opacity: 0;
            transform: scale(0.9);
            animation: fadeInScale 1s ease-out 0.3s forwards, float 3s ease-in-out infinite 1.3s;
            z-index: 10;
        }

        .loader-bars,
        .loader-balls {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .loader-bar {
            position: absolute;
            width: 0.5rem;
            height: 16rem;
            border-radius: 40px;
            background: #ffffff;
        }

        .loader-bar::after,
        .loader-bar::before {
            content: "";
            position: absolute;
            width: 0.87em;
            border-radius: 40px;
            background: #e0e0e0;
            border: 1px solid #e2e2e2;
            box-shadow:
                inset 4px 4px 12px rgba(211, 210, 210, 0.67),
                inset -4px -4px 12px rgba(233, 233, 233, 0.67);
        }

        .loader-bar::after {
            left: 0;
            top: 0;
            height: 6em;
            mask-image: linear-gradient(to bottom, black calc(100% - 48px), transparent 100%);
        }

        .loader-bar::before {
            bottom: 0;
            right: 0;
            height: 4.8em;
            mask-image: linear-gradient(to top, black calc(100% - 48px), transparent 100%);
        }

        .loader-ball-track {
            position: absolute;
            width: 0.6rem;
            height: 15rem;
        }

        .loader-ball {
            width: 0.85em;
            height: 0.85em;
            border-radius: 50%;
            background-color: transparent;
            box-shadow:
                rgba(0, 0, 0, 0.17) 0px -8px 8px 0px inset,
                rgba(0, 0, 0, 0.15) 0px -12px 12px 0px inset,
                rgba(0, 0, 0, 0.1) 0px -32px 16px 0px inset,
                rgba(0, 0, 0, 0.06) 0px 2px 1px,
                rgba(0, 0, 0, 0.09) 0px 4px 2px,
                rgba(0, 0, 0, 0.09) 0px 8px 4px,
                rgba(0, 0, 0, 0.09) 0px 16px 8px,
                rgba(0, 0, 0, 0.09) 0px 32px 16px,
                0px -1px 12px -6px rgba(0, 0, 0, 0.09);
            animation: ballMove 3.63s ease-in-out infinite;
        }

        /* Input Section */
        .input-section {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3rem;
            opacity: 0;
            transform: translateY(10px);
            animation: fadeInUp 1s ease-out 0.5s forwards;
            z-index: 10;
           
        }

        .input-wrapper {
            position: relative;
            width: 100%;
            max-width: 48rem;
            display: flex;
            align-items: center;
        }

        .input-icon-left {
            position: absolute;
            left: 1rem;
            z-index: 10;
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 60%;
            background-color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .input-icon-left svg {
            width: 1.5rem;
            height: 1.5rem;
            fill: #000000;
        }

        .fitness-input {
            width: 100%;
            height: 4rem;
            padding-left: 5rem;
            padding-right: 5rem;
            background-color: #ffffff;
            color: #000000;
            border: 2px solid rgba(51, 51, 51, 1);
            border-radius: 9999px;
            font-size: 1rem;
            font-weight: 500;
            font-family: 'Inter', sans-serif;
            box-shadow: 0 20px 25px -5px rgba(51, 51, 51, 0.4);
            transition: all 0.3s ease;
            outline: none;
            clip-path: inset(0 0 0 100%);
            animation: revealInput 3.63s ease-in-out 1.3s forwards;
        }

        .fitness-input::placeholder {
            color: rgba(0, 0, 0, 0.4);
        }

        .fitness-input:focus {
            box-shadow: 0 12px 40px rgba(255, 255, 255, 0.15);
            border-color: rgba(140, 140, 140, 1);
        }

        @keyframes revealInput {
            from {
                clip-path: inset(0 0 0 100%);
            }
            to {
                clip-path: inset(0 0 0 0);
            }
        }

        .submit-button {
            position: absolute;
            right: 0.75rem;
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 50%;
            background-color: #000000;
            color: #ffffff;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            animation: bounceSlow 2s infinite 1.3s;
            opacity: 0;
            transform: scale(0);
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
        }

        .submit-button.revealed {
            opacity: 1;
            transform: scale(1);
            animation: bounceSlow 2s infinite;
        }

        .submit-button:hover {
            transform: scale(1.1);
            animation: none;
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.6);
        }

        .submit-icon {
            width: 1.25rem;
            height: 1.25rem;
        }

        /* Feature Marquee */
        .marquee-container {
            width: 100%;
            max-width: 72rem;
            overflow: hidden;
        }

        .marquee-track {
            display: flex;
            gap: 3rem;
            animation: marqueeScroll 25s linear infinite;
            white-space: nowrap;
        }

        .feature-card {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 10rem;
            height: 10rem;
            padding: 1.5rem;
            text-align: center;
            background-color: rgba(18, 18, 18, 1);
            border: 1px solid rgba(51, 51, 51, 1);
            border-radius: 0.75rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
            transition: all 0.3s ease;
        }

        .feature-card:hover {
            transform: scale(1.05);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.7);
            background-color: rgba(38, 38, 38, 1);
        }

        .feature-text {
            font-size: 1.125rem;
            font-weight: 600;
            color: #ffffff;
        }

        /* Notification Styles */
        .notification {
            position: fixed;
            top: 2rem;
            right: 2rem;
            max-width: 24rem;
            padding: 1rem 1.5rem;
            border-radius: 0.5rem;
            color: #ffffff;
            font-weight: 500;
            z-index: 1000;
            animation: slideInRight 0.3s ease-out;
        }
        
        .notification.success {
            background-color: rgba(34, 197, 94, 0.9);
            border: 1px solid rgba(34, 197, 94, 1);
        }
        
        .notification.error {
            background-color: rgba(239, 68, 68, 0.9);
            border: 1px solid rgba(239, 68, 68, 1);
        }
        
        @keyframes slideInRight {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
        
        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInScale {
            from {
                opacity: 0;
                transform: scale(0.9);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-20px);
            }
        }

        @keyframes bounceSlow {
            0%, 100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-10%);
            }
        }

        @keyframes rotateGradient {
            0% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 400% 50%;
            }
            100% {
                background-position: 0% 50%;
            }
        }

        @keyframes floatParticles {
            0% {
                background-position: 0 0;
            }
            100% {
                background-position: 200px 200px;
            }
        }

        @keyframes marqueeScroll {
            0% {
                transform: translateX(100%);
            }
            100% {
                transform: translateX(-100%);
            }
        }

        @keyframes ballMove {
            0% {
                transform: translateY(0em);
            }
            50% {
                transform: translateY(13em);
            }
            100% {
                transform: translateY(0em);
            }
        }

        /* New Effects */
        @keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.7;
            }
        }

        @keyframes shimmer {
            0% {
                left: -100%;
            }
            100% {
                left: 100%;
            }
        }

        /* Responsive */
        @media (max-width: 640px) {
            .header {
                padding: 1rem;
            }

            .main-container {
                gap: 1rem;
                padding: 2rem 1rem;
            }

            .input-wrapper {
                padding: 0 1rem;
            }

            .fitness-input {
                font-size: 0.875rem;
                padding-left: 4rem;
                padding-right: 4rem;
            }

            .feature-card {
                min-width: 8rem;
                height: 8rem;
                font-size: 0.875rem;
            }
        }
    </style>
</head>
<body>

    <div class="logo-container">
        <div class="flex items-center pl-5">
            <!-- SVG logo with no background -->
            <svg class="logo-svg" width="40" height="40" viewBox="0 0 30 30" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 15 L15 5 L25 15 L15 25 Z" fill="#ffffff" />
            </svg>
            <!-- Logo Text -->
            <span class=" logo-text  text-2xl text-white font-bold">MISSION</span>
            <span class=" logo-text  text-2xl text-gray-400 font-bold ml-1">FITNESS</span>

    <!-- Header -->
    <header class="header">
        <div class="logo-container">
            <span class="logo-text">MISSION</span>
            <span class="logo-text-gray">FITNESS</span>

        </div>


    <div class="min-h-screen text-white geometric-bg gap-10 flex flex-col items-center justify-center">
        <h1 class="text-center gap-20 text-5xl sm:text-6xl md:text-7xl font-extrabold pt-10 leading-tight tracking-tight bg-transparent">
            <span class="text2 block text-white">Welcome To</span>
            <span class="text3 text-white">Mission <span class="text4 text-gray-400"> Fitness </span></span>
        </h1>
        <div class="main">
            <div class="up">
                <div class="loaders">
                    <div class="loader"></div>
                    <div class="loader"></div>
                    <div class="loader"></div>
                    <div class="loader"></div>
                    <div class="loader"></div>
                    <div class="loader"></div>
                    <div class="loader"></div>
                    <div class="loader"></div>
                    <div class="loader"></div>
                    <div class="loader"></div>
                </div>
                <div class="loadersB">
                    <div class="loaderA">
                        <div class="ball0"></div>
                    </div>
                    <div class="loaderA">
                        <div class="ball1"></div>
                    </div>
                    <div class="loaderA">
                        <div class="ball2"></div>
                    </div>
                    <div class="loaderA">
                        <div class="ball3"></div>
                    </div>
                    <div class="loaderA">
                        <div class="ball4"></div>
                    </div>
                    <div class="loaderA">
                        <div class="ball5"></div>
                    </div>
                    <div class="loaderA">
                        <div class="ball6"></div>
                    </div>
                    <div class="loaderA">
                        <div class="ball7"></div>
                    </div>
                    <div class="loaderA">
                        <div class="ball8"></div>
                    </div>
                </div>
            </div>

        <button class="cta-button" onclick="alert('Try Mission Fitness!')">
            <svg class="cta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
            <span>Try Mission Fitness</span>
        </button>
    </header>

    <!-- Main Container -->
    <main class="main-container">
        <!-- Hero Title -->
        <div class="hero-title">
            <h1>
                <span class="title-welcome">Welcome To</span>
                <span class="title-mission">Mission </span>
                <span class="title-fitness">Fitness</span>
            </h1>

        </div>

        <!-- Fitness Loader -->
        <div class="loader-container">
            <div class="loader-bars" id="loader-bars"></div>
            <div class="loader-balls" id="loader-balls"></div>
        </div>

        <!-- Notification Area -->
        <div id="notification" class="notification" style="display: none;"></div>
        
        <!-- Input Section -->
        <div class="input-section">
            <form class="input-wrapper" onsubmit="handleSubmit(event)">
                <div class="input-icon-left">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
                        <path d="M8.5 1.866a1 1 0 0 0-1 0L2.866 4.5a1 1 0 0 0-.5.866V10.5a1 1 0 0 0 .5.866l4.634 2.634a1 1 0 0 0 1 0l4.634-2.634a1 1 0 0 0 .5-.866V5.366a1 1 0 0 0-.5-.866L8.5 1.866z"/>
                    </svg>
                </div>

                <input 
                    type="text" 
                    id="fitness-message"
                    class="fitness-input" 
                    placeholder="Update your fitness plan: 'Change my diet to vegetarian', 'Add more cardio', 'Switch to morning workouts'..."
                />

                <button type="submit" class="submit-button" id="submit-btn">
                    <svg class="submit-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </form>

            <!-- Feature Marquee -->
            <div class="marquee-container">
                <div class="marquee-track" id="marquee-track">
                    <!-- Features will be duplicated by JavaScript -->
                </div>
            </div>
        </div>
    </main>

    <script>
        // Create loader bars
        const loaderBarsContainer = document.getElementById('loader-bars');
        for (let i = 0; i < 10; i++) {
            const bar = document.createElement('div');
            bar.className = 'loader-bar';
            bar.style.transform = `rotate(${i * 20}deg)`;
            loaderBarsContainer.appendChild(bar);
        }

        // Create loader balls
        const loaderBallsContainer = document.getElementById('loader-balls');
        for (let i = 0; i < 9; i++) {
            const track = document.createElement('div');
            track.className = 'loader-ball-track';
            track.style.transform = `rotate(${i * 20}deg)`;
            
            const ball = document.createElement('div');
            ball.className = 'loader-ball';
            ball.style.animationDelay = `${i * 0.2}s`;
            
            track.appendChild(ball);
            loaderBallsContainer.appendChild(track);
        }

        // Create marquee features
        const features = [
            "Custom Workout Plans",
            "Nutrition Guidance",
            "Exercise Library",
            "Progress Tracking",
            "Goal Setting",
            "AI Chat Assistant"
        ];

        const marqueeTrack = document.getElementById('marquee-track');
        
        // Duplicate features for seamless scrolling
        [...features, ...features].forEach(feature => {
            const card = document.createElement('div');
            card.className = 'feature-card';
            
            const text = document.createElement('span');
            text.className = 'feature-text';
            text.textContent = feature;
            
            card.appendChild(text);
            marqueeTrack.appendChild(card);
        });

        // Animate submit button reveal midway through input reveal
        const submitBtn = document.getElementById('submit-btn');
        setTimeout(() => {
            submitBtn.classList.add('revealed');
        }, 2900); // Roughly half way through 3.63s animation (1.815s + 1.3s delay)

        // Show notification function
        function showNotification(message, type = 'success') {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.className = `notification ${type}`;
            notification.style.display = 'block';
            
            setTimeout(() => {
                notification.style.display = 'none';
            }, 5000);
        }
        
        // Handle form submission
        async function handleSubmit(event) {
            event.preventDefault();
            const input = document.getElementById('fitness-message');
            const message = input.value.trim();
            const submitBtn = document.getElementById('submit-btn');
            
            if (message) {
                // Show loading state
                submitBtn.innerHTML = '<div style="width: 1.25rem; height: 1.25rem; border: 2px solid #fff; border-top: 2px solid transparent; border-radius: 50%; animation: spin 1s linear infinite;"></div>';
                submitBtn.disabled = true;
                
                try {
                    const token = localStorage.getItem('token');
                    console.log('Using token:', token);
                    if (!token) {
                        showNotification('Please login to update your fitness plan', 'error');
                        return;
                    }
                    
                    const response = await fetch('/api/update-plan', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${token}`
                        },
                        body: JSON.stringify({ message })
                    });
                    
                    const data = await response.json();
                    
                    if (response.ok) {
                        input.value = '';
                        // Redirect to response page with AI response
                        const aiResponse = encodeURIComponent(data.response || 'Your fitness plan has been updated successfully!');
                        window.location.href = `/plan-response?response=${aiResponse}`;
                    } else {
                        showNotification(`❌ ${data.error || 'Failed to update plan'}`, 'error');
                    }
                } catch (error) {
                    console.error('Error updating plan:', error);
                    showNotification('❌ Network error. Please try again.', 'error');
                } finally {
                    // Restore button
                    submitBtn.innerHTML = `
                        <svg class="submit-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                    `;
                    submitBtn.disabled = false;
                }
            }
        }

        // Add spin animation for loading
        const style = document.createElement('style');
        style.textContent = `
            @keyframes spin {
                0% { transform: rotate(0deg); }
                100% { transform: rotate(360deg); }
            }
        `;
        document.head.appendChild(style);
        
        // Optional: Add smooth scroll on page load
        window.addEventListener('load', () => {
            document.body.style.opacity = '1';
        });
    </script>
</body>
</html>
