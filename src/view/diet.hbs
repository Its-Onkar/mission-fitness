<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diet & Nutrition | Mission Fitness</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; }
        .glass-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px); border: 1px solid rgba(226, 232, 240, 0.8); }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 w-64 h-full bg-white border-r border-gray-200 z-40">
        <div class="p-6 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-orange-100 flex items-center justify-center text-orange-600">
                <i data-lucide="dumbbell" class="w-6 h-6"></i>
            </div>
            <span class="text-xl font-bold">Mission<span class="text-orange-500">Fitness</span></span>
        </div>
        <nav class="flex-1 px-4 space-y-2 py-4">
            <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium">
                <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Dashboard
            </a>
            <a href="/workouts" class="flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium">
                <i data-lucide="dumbbell" class="w-5 h-5"></i> Workouts
            </a>
            <a href="/diet" class="flex items-center gap-3 px-4 py-3 bg-orange-50 text-orange-600 rounded-xl font-medium">
                <i data-lucide="utensils" class="w-5 h-5"></i> Diet & Nutrition
            </a>
            <a href="/progress" class="flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium">
                <i data-lucide="trending-up" class="w-5 h-5"></i> Progress
            </a>
        </nav>
    </aside>
    
    <main class="ml-64 p-6">
        <header class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900">🥗 Diet & Nutrition</h1>
            <p class="text-gray-600">Track your meals and nutrition goals</p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Today's Meal Plan -->
            <div class="glass-card rounded-2xl p-6 lg:col-span-2">
                <h3 class="text-xl font-bold mb-4">Today's AI Diet Plan</h3>
                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div class="p-4 bg-orange-50 rounded-xl">
                        <h4 class="font-bold text-orange-800 mb-2">🌅 Breakfast</h4>
                        <p class="text-sm" id="breakfast">Oats with banana and almonds</p>
                        <p class="text-xs text-gray-500">320 kcal</p>
                    </div>
                    <div class="p-4 bg-blue-50 rounded-xl">
                        <h4 class="font-bold text-blue-800 mb-2">🍽️ Lunch</h4>
                        <p class="text-sm" id="lunch">Paneer tikka with quinoa</p>
                        <p class="text-xs text-gray-500">450 kcal</p>
                    </div>
                    <div class="p-4 bg-purple-50 rounded-xl">
                        <h4 class="font-bold text-purple-800 mb-2">🌙 Dinner</h4>
                        <p class="text-sm" id="dinner">Dal with brown rice</p>
                        <p class="text-xs text-gray-500">380 kcal</p>
                    </div>
                    <div class="p-4 bg-green-50 rounded-xl">
                        <h4 class="font-bold text-green-800 mb-2">🥜 Snacks</h4>
                        <p class="text-sm" id="snacks">Greek yogurt with berries</p>
                        <p class="text-xs text-gray-500">180 kcal</p>
                    </div>
                </div>
                <button id="logFoodBtn" class="w-full py-3 bg-green-500 text-white rounded-lg font-medium">Log Food</button>
            </div>

            <!-- Nutrition Progress -->
            <div class="glass-card rounded-2xl p-6">
                <h3 class="text-lg font-bold mb-4">Today's Progress</h3>
                <div class="space-y-4">
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span>Calories</span>
                            <span id="calStatus">1200 / 1800</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div id="calBar" class="bg-green-500 h-2 rounded-full" style="width: 67%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span>Protein</span>
                            <span id="proteinStatus">60 / 120g</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div id="proteinBar" class="bg-blue-500 h-2 rounded-full" style="width: 50%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span>Carbs</span>
                            <span id="carbsStatus">150 / 200g</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div id="carbsBar" class="bg-yellow-500 h-2 rounded-full" style="width: 75%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span>Fats</span>
                            <span id="fatsStatus">40 / 60g</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div id="fatsBar" class="bg-purple-500 h-2 rounded-full" style="width: 67%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Food Log -->
            <div class="glass-card rounded-2xl p-6 lg:col-span-3">
                <h3 class="text-xl font-bold mb-4">Food Log</h3>
                <div class="space-y-3" id="foodLog">
                    <div class="p-3 bg-gray-50 rounded-lg flex justify-between items-center">
                        <div>
                            <p class="font-medium">Breakfast - Oats with banana</p>
                            <p class="text-sm text-gray-500">320 kcal • 12g protein</p>
                        </div>
                        <span class="text-sm text-gray-500">8:00 AM</span>
                    </div>
                    <div class="p-3 bg-gray-50 rounded-lg flex justify-between items-center">
                        <div>
                            <p class="font-medium">Lunch - Paneer tikka</p>
                            <p class="text-sm text-gray-500">450 kcal • 25g protein</p>
                        </div>
                        <span class="text-sm text-gray-500">1:00 PM</span>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            loadDietData();
        });

        function loadDietData() {
            const token = localStorage.getItem('token');
            if (!token) {
                window.location.href = '/login';
                return;
            }
            
            const defaultData = {
                diet: { 
                    consistencyScore: 80, 
                    caloriesEaten: 1200, 
                    caloriesTarget: 1800,
                    proteinEaten: 60,
                    proteinTarget: 120,
                    carbsEaten: 150,
                    carbsTarget: 200,
                    fatsEaten: 40,
                    fatsTarget: 60
                }
            };
            
            document.getElementById('calStatus').textContent = `${defaultData.diet.caloriesEaten} / ${defaultData.diet.caloriesTarget}`;
            document.getElementById('proteinStatus').textContent = `${defaultData.diet.proteinEaten} / ${defaultData.diet.proteinTarget}g`;
            document.getElementById('carbsStatus').textContent = `${defaultData.diet.carbsEaten} / ${defaultData.diet.carbsTarget}g`;
            document.getElementById('fatsStatus').textContent = `${defaultData.diet.fatsEaten} / ${defaultData.diet.fatsTarget}g`;
            
            document.getElementById('logFoodBtn').addEventListener('click', () => {
                localStorage.setItem('dietCompleted_' + new Date().toDateString(), 'true');
                alert('Food logged successfully!');
                window.location.href = '/dashboard';
            });
        }
    </script>
</body>
</html>
