<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mission Fitness - Elevate Your Fitness</title>
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
    @import url('https://api.fontshare.com/v2/css?f[]=sakana@900&display=swap');

    body {
      font-family: 'Inter', sans-serif;
      background: #000;
      color: #fff;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    .hero-bg {
      background: linear-gradient(135deg, #000 0%, #111 100%);
    }

    /* --- FLOATING CARDS --- */
    .floating-card {
      position: absolute;
      background: #1a1a1a;
      border: 1px solid #333;
      padding: 1rem;
      border-radius: 24px;
      animation: float 4s ease-in-out infinite;
      z-index: 20;
      transform-style: preserve-3d;
      transition: all 0.3s ease;
      display: block;
      visibility: visible;
      opacity: 1;
      gap: 2rem;
    }

    .floating-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(135deg, rgba(249, 115, 22, 0.2) 0%, transparent 50%);
      border-radius: 24px;
      opacity: 0;
      transition: opacity 0.3s ease;
      gap: 2rem;
    }

    .floating-card:hover::before {
      opacity: 1;
    }

    .floating-card:hover {
      transform: translateY(-10px) scale(1.05);
      border-color: #f97316;
      box-shadow: 0 25px 70px rgba(249, 115, 22, 0.3), 0 0 1px rgba(255, 255, 255, 0.3) inset;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-25px) rotate(1deg); }
    }

    .floating-card-1 { 
      top: 30%; 
      left: 18%; 
      animation-delay: 0s;
      border-radius: 30px 10px 30px 10px;
    }
    .floating-card-2 { 
      bottom: 25%; 
      left: 18%; 
      animation-delay: 0.7s;
      border-radius: 10px 30px 10px 30px;
    }
    .floating-card-3 { 
      top: 30%; 
      right: 14%; 
      animation-delay: 1.4s;
      border-radius: 10px 25px 10px 25px;
    }
    .floating-card-4 { 
      bottom: 25%; 
      right: 18%; 
      animation-delay: 2.1s;
      border-radius: 10px 30px 10px 30px;
    }

    .gradient-text {
      color: #fff;
      text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
    }

    .luxury-gradient {
      color: #f97316;
      text-shadow: 0 0 10px rgba(249, 115, 22, 0.5);
    }

    .hero-image {
      position: relative;
      height: 100vh; 
      width: 100%;
      z-index: 5;
    }

    .hero-img {
      position: relative;
      z-index: 10;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: brightness(0.9);
    }

    /* --- MOBILE MENU --- */
    .mobile-menu {
      transform: translateX(100%);
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      display: block;
    }

    .mobile-menu.active {
      transform: translateX(0);
    }

    .burger-line {
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .burger.active .burger-line:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .burger.active .burger-line:nth-child(2) {
      opacity: 0;
    }

    .burger.active .burger-line:nth-child(3) {
      transform: rotate(-45deg) translate(7px, -6px);
    }

    @media (max-width: 768px) {
      .floating-card { 
        padding: 0.75rem;
        font-size: 0.85rem;
        transform: scale(0.8);
      }
      .floating-card-1 { left: 10%; bottom: 10%; }
      .floating-card-2 { left: 2%; bottom: 10%; }
      .floating-card-3 { right: 15%; bottom: 10%; }
      .floating-card-4 { right: 2%; bottom: 10%; }
    }

    .luxury-section {
      position: relative;
      overflow: hidden;
    }

    /* --- MARQUEE --- */
    .marquee-bg {
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    .marquee-bg::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 800px;
      height: 800px;
      background: radial-gradient(circle, rgba(26, 25, 25, 0.2) 0%, rgba(64, 63, 63, 0.1) 100%);
      box-shadow: 0 0 40px rgba(255, 255, 255, 0.7), 0 0 80px rgba(255, 255, 255, 0.7);
      border-radius: 50%;
      filter: blur(60px);
    }

    .marquee-container {
      position: absolute;
      z-index: 2;
      top: 50%;
      left: 0;
      width: 200%;
      transform: translateY(-50%);
      white-space: nowrap;
    }

    .marquee-text {
      display: inline-block;
      font-size: 6rem;
      font-weight: 700;
      color: #fff;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.4);
      animation: marquee 40s linear infinite;
    }

    @media (min-width: 768px) {
      .marquee-text {
        font-size: 6rem;
      }
    }

    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    .bottom-gradient {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 25%;
      background: linear-gradient(to top, #000 10%, transparent);
      z-index: 25;
      pointer-events: none;
    }

    /* --- NAVBAR --- */
    .nav-fixed {
      position: fixed;
      top: 0;
      width: 100%;
      background: rgba(0,0,0,0.8);
      backdrop-filter: blur(10px);
      z-index: 50;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .nav-container {
      max-width: 80rem;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .nav-flex {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem 0;
    }

    .nav-logo {
      font-size: 1.5rem;
      font-weight: 700;
    }

    .nav-logo-white { color: #fff; }
    .nav-logo-gradient { font-style: italic; color: #f97316; }

    .nav-buttons { gap: 1rem; display: flex; justify-items: end; }
    @media (min-width: 768px) {
      .nav-buttons { display: flex; }
      .burger { display: none; }
    }

    .nav-button {
      color: #fff;
      padding: 0.625rem 1.5rem;
      border-radius: 9999px;
      font-weight: 500;
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s;
      text-decoration: none;
      display: inline-block;
    }
    .nav-button:hover {
      border-color: rgba(255, 255, 255, 0.4);
      background-color: rgba(255, 255, 255, 0.1);
    }
    .nav-button-register {
      background-color: #dc2626;
      color: #fff;
      font-weight: 600;
      border: none;
    }
    .nav-button-register:hover { background-color: #b91c1c; }

    .burger {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      padding: 0.5rem;
      background: none;
      border: none;
      cursor: pointer;
    }
    .burger-line {
      width: 1.5rem;
      height: 0.125rem;
      background-color: #fff;
      border-radius: 0.25rem;
    }

    /* Mobile Menu details */
    .mobile-menu {
      position: fixed;
      top: 0;
      right: 0;
      height: 100vh;
      width: 300px;
      background: #000;
      border-left: 1px solid #333;
      padding: 5rem 1.5rem 0;
      z-index: 60;
    }
    .mobile-menu-flex {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .mobile-border-t {
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      gap: 1rem;
      display: flex;
      flex-direction: column;
    }
    .mobile-button {
      width: 100%;
      color: #fff;
      padding: 0.625rem 1.5rem;
      border-radius: 9999px;
      font-weight: 500;
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s;
      text-align: center;
      text-decoration: none;
      display: block;
      box-sizing: border-box;
    }
    .mobile-register { background-color: #dc2626; border: none; }

    /* --- HERO SECTION --- */
    .hero-section {
      min-height: 100vh;
      position: relative;
      overflow: hidden;
      padding-top: 0; 
      padding-bottom: 0;
    }

    .hero-container {
      max-width: 100%;
      margin: 0 auto;
      padding: 0;
    }

    .hero-relative {
      position: relative;
      width: 100%;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-image-container {
      width: 80%;
      height: 90%;
      position: relative;
    }

    .floating-card-content { display: flex; align-items: center; gap: 0.5rem; }
    .floating-card-icon { width: 1.5rem; height: 1.5rem; color: #fff; }
    .floating-card-text-small { font-size: 0.75rem; color: #ccc; }
    .floating-card-text-medium { font-size: 0.75rem; font-weight: 600; color: #fff; }
    .floating-card-heart-large { font-size: 0.75rem; font-weight: 500; color: #fff; }
    .floating-card-calories-icon {
      width: 2rem; height: 2rem; background: #1a1a1a;
      border-radius: 1rem; display: flex; align-items: center; justify-content: center; color: #f97316;
    }
    .floating-card-calories-text-large { font-size: 0.75rem; font-weight: 300; color: #f97316; }

    .hero-overlay {
      position: absolute; 
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 15;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: 8rem;
      pointer-events: none;
    }

    .hero-overlay-text {
      text-align: center;
      max-width: 60rem;
      z-index: 10;
      pointer-events: auto;
    }

    /* --- HERO CTA BUTTONS --- */
    .hero-cta-wrapper {
      position: absolute;
      bottom: 8%;
      left: 0;
      width: 100%;
      z-index: 40;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 0 1.5rem;
    }

    .modern-cta-group {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      align-items: center;
      background: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      padding: 1rem 2rem;
      border-radius: 2rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 10px 40px -10px rgba(0,0,0,0.5);
    }

    @media (min-width: 640px) {
      .modern-cta-group {
        flex-direction: row;
        padding: 0.75rem 1rem;
        border-radius: 9999px;
      }
    }

    .btn-mission-start {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      padding: 1rem 2.5rem;
      background: linear-gradient(135deg, #f97316, #dc2626);
      border-radius: 9999px;
      color: white;
      font-weight: 700;
      font-size: 1.125rem;
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 0 20px rgba(249, 115, 22, 0.4);
      overflow: hidden;
      white-space: nowrap;
      border: 1px solid rgba(255,255,255,0.2);
    }

    .btn-mission-start::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
      transition: 0.5s;
    }

    .btn-mission-start:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 10px 30px rgba(249, 115, 22, 0.6);
    }

    .btn-mission-start:hover::before {
      left: 100%;
    }

    .btn-watch-demo {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      padding: 1rem 2rem;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 9999px;
      color: white;
      font-weight: 600;
      font-size: 1.125rem;
      text-decoration: none;
      transition: all 0.3s ease;
      backdrop-filter: blur(4px);
    }

    .btn-watch-demo:hover {
      background: rgba(255, 255, 255, 0.15);
      border-color: #fff;
      transform: translateY(-2px);
    }

    .play-icon-bg {
      width: 24px;
      height: 24px;
      background: #fff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #000;
      transition: all 0.3s ease;
    }

    .btn-watch-demo:hover .play-icon-bg {
      transform: scale(1.1);
      color: #dc2626;
    }

    /* --- PROGRAMS / GALLERY SECTION --- */
    .programs-section { padding: 8rem 0; background: #000; }
    .programs-container { max-width: 80rem; margin: 0 auto; padding: 0 1.5rem; }
    .programs-header { text-align: center; margin-bottom: 5rem; }
    .programs-badge { display: inline-block; margin-bottom: 1.5rem; }
    .programs-badge-text {
      color: #fb923c; font-weight: 700; font-size: 0.875rem; text-transform: uppercase;
      letter-spacing: 0.1em; background: #2a1810; padding: 0.5rem 1.5rem;
      border-radius: 9999px; border: 1px solid #4a2c1a;
    }
    .programs-title { font-size: 3rem; font-weight: 900; color: #fff; margin-bottom: 1.5rem; line-height: 1.1; }
    @media (min-width: 768px) { .programs-title { font-size: 4.5rem; } }
    .programs-subtitle { color: rgba(255, 255, 255, 0.7); font-size: 1.25rem; max-width: 48rem; margin: 0 auto; line-height: 1.625; }

    /* --- GALLERY LAYOUT --- */
    .ex-gallery-container {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      background: #111;
      border: 1px solid #333;
      border-radius: 2rem;
      overflow: hidden;
      min-height: 600px;
    }

    @media (min-width: 1024px) {
      .ex-gallery-container {
        grid-template-columns: 350px 1fr;
      }
    }

    /* Left Menu */
    .ex-menu {
      background: #0a0a0a;
      padding: 2rem;
      border-right: 1px solid #222;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      overflow-y: auto;
    }

    .ex-menu-title {
      font-size: 0.85rem;
      text-transform: uppercase;
      color: #666;
      letter-spacing: 0.1em;
      margin-bottom: 1rem;
      font-weight: 700;
    }

    .ex-btn {
      width: 100%;
      text-align: left;
      padding: 1.25rem;
      background: transparent;
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 1rem;
      color: #aaa;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .ex-btn:hover {
      background: rgba(255,255,255,0.05);
      color: #fff;
    }

    .ex-btn.active {
      background: rgba(249, 115, 22, 0.1);
      border-color: #f97316;
      color: #fff;
      box-shadow: 0 0 20px rgba(249, 115, 22, 0.1);
    }

    .ex-btn-arrow {
      opacity: 0;
      transform: translateX(-10px);
      transition: all 0.3s ease;
      color: #f97316;
    }

    .ex-btn.active .ex-btn-arrow {
      opacity: 1;
      transform: translateX(0);
    }

    /* Right Display Area */
    .ex-display {
      position: relative;
      padding: 3rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: radial-gradient(circle at top right, rgba(249, 115, 22, 0.05), transparent 60%);
    }

    .ex-content {
      opacity: 1;
      transition: opacity 0.4s ease;
    }

    .ex-content.fade-out {
      opacity: 0;
    }

    .ex-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 2rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .ex-main-title {
      font-size: 2.5rem;
      font-weight: 800;
      margin: 0;
      color: #fff;
      line-height: 1.1;
    }

    .ex-tags {
      display: flex;
      gap: 0.75rem;
    }

    .ex-tag {
      font-size: 0.75rem;
      padding: 0.4rem 1rem;
      border-radius: 999px;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.05em;
    }

    .ex-tag-level { background: #333; color: #ccc; border: 1px solid #444; }
    .ex-tag-muscle { background: rgba(249, 115, 22, 0.2); color: #f97316; border: 1px solid rgba(249, 115, 22, 0.3); }

    .ex-visual-row {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      margin-bottom: 2.5rem;
    }

    @media (min-width: 768px) {
      .ex-visual-row { grid-template-columns: 1.2fr 1fr; }
    }

    .ex-image-wrapper {
      position: relative;
      border-radius: 1.5rem;
      overflow: hidden;
      aspect-ratio: 16/9;
      box-shadow: 0 20px 40px rgba(0,0,0,0.5);
      border: 1px solid rgba(255,255,255,0.1);
    }

    .ex-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    
    .ex-image-wrapper:hover .ex-image {
      transform: scale(1.05);
    }

    /* Steps */
    .ex-steps-container {
      background: rgba(255,255,255,0.03);
      border-radius: 1.5rem;
      padding: 2rem;
      border: 1px solid rgba(255,255,255,0.05);
    }

    .ex-steps-title {
      font-size: 1rem;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 1.5rem;
      font-weight: 700;
      border-bottom: 1px solid #333;
      padding-bottom: 1rem;
    }

    .ex-step-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .ex-step-item {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }

    .ex-step-num {
      background: #f97316;
      color: #000;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 800;
      flex-shrink: 0;
      margin-top: 0.2rem;
    }

    .ex-step-text {
      color: #ccc;
      font-size: 1rem;
      line-height: 1.6;
    }

    /* --- IMPROVED & ANIMATED CTA SECTION --- */
    .cta-section { 
      padding: 10rem 0; 
      position: relative; 
      overflow: hidden; 
      background: linear-gradient(135deg, #000 0%, #111 50%, #000 100%);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .cta-bg-animate {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      z-index: 1;
      opacity: 0.6;
    }
    
    .cta-aurora {
      position: absolute;
      width: 100%; height: 100%;
      background: 
        radial-gradient(circle at 20% 30%, rgba(249, 115, 22, 0.4) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(234, 88, 12, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 50% 50%, rgba(255, 140, 0, 0.2) 0%, transparent 60%);
      filter: blur(80px);
      animation: auroraMove 20s infinite alternate ease-in-out;
    }

    @keyframes auroraMove {
      0% { transform: scale(1) rotate(0deg); opacity: 0.6; }
      33% { transform: scale(1.1) rotate(2deg); opacity: 0.8; }
      66% { transform: scale(0.9) rotate(-1deg); opacity: 0.7; }
      100% { transform: scale(1.05) rotate(1deg); opacity: 0.6; }
    }

    .cta-container { 
      max-width: 80rem; 
      margin: 0 auto; 
      padding: 0 1.5rem; 
      position: relative; 
      z-index: 10; 
      width: 100%;
    }

    .cta-card {
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(30px);
      -webkit-backdrop-filter: blur(30px);
      border: 2px solid rgba(249, 115, 22, 0.3);
      border-radius: 3rem;
      padding: 5rem 3rem;
      text-align: center;
      box-shadow: 
        0 50px 100px -20px rgba(0,0,0,0.9),
        0 0 0 1px rgba(249, 115, 22, 0.1) inset,
        0 0 50px rgba(249, 115, 22, 0.2);
      position: relative;
      overflow: hidden;
      transform: translateY(30px);
      opacity: 0;
    }

    .cta-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 100%; height: 2px;
      background: linear-gradient(90deg, transparent, rgba(249, 115, 22, 1), rgba(255, 140, 0, 0.8), rgba(249, 115, 22, 1), transparent);
      animation: shimmer 3s infinite;
    }

    @keyframes shimmer {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }

    .cta-badge { 
      display: inline-block; 
      margin-bottom: 2.5rem; 
      opacity: 0; 
      transform: translateY(20px);
      animation: pulse 2s infinite;
    }
    
    .cta-badge-text {
      color: #f97316; 
      font-weight: 800; 
      font-size: 0.9rem; 
      text-transform: uppercase;
      letter-spacing: 0.15em; 
      background: rgba(249, 115, 22, 0.15); 
      padding: 1rem 2rem;
      border-radius: 9999px; 
      border: 2px solid rgba(249, 115, 22, 0.4);
      box-shadow: 0 0 20px rgba(249, 115, 22, 0.3);
      position: relative;
      overflow: hidden;
    }

    .cta-badge-text::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      animation: badgeShine 2s infinite;
    }

    @keyframes badgeShine {
      0% { left: -100%; }
      100% { left: 100%; }
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }

    .cta-title { 
      font-size: 3.5rem; 
      font-weight: 900; 
      color: #fff; 
      margin-bottom: 2rem; 
      line-height: 1.1; 
      opacity: 0; 
      transform: translateY(30px);
      text-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }

    @media (min-width: 768px) { 
      .cta-title { font-size: 6rem; } 
    }

    .cta-title-outline {
      color: transparent;
      -webkit-text-stroke: 2px rgba(255,255,255,0.8);
      background: linear-gradient(135deg, #fff 0%, #f3f4f6 100%);
      -webkit-background-clip: text;
      transition: all 0.8s ease;
      display: inline-block;
      animation: titleGlow 3s infinite alternate;
    }

    @keyframes titleGlow {
      0% { -webkit-text-stroke: 2px rgba(255,255,255,0.8); }
      100% { -webkit-text-stroke: 2px rgba(255,255,255,1); }
    }

    .cta-title-gradient {
      
      -webkit-background-clip: text;
      -webkit-text-stroke: 0;
      color: transparent;
      position: relative;
      display: inline-block;
      color: orangered;
    }

  
    
    .cta-subtitle { 
      font-size: 1.4rem; 
      color: rgba(255, 255, 255, 0.85); 
      margin-bottom: 3.5rem; 
      max-width: 45rem; 
      margin-left: auto; 
      margin-right: auto; 
      line-height: 1.7; 
      opacity: 0; 
      transform: translateY(30px);
      font-weight: 400;
    }

    .cta-btn-wrapper {
      opacity: 0; 
      transform: translateY(30px);
      margin-bottom: 3rem;
    }

    .cta-button {
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); 
      color: #000; 
      padding: 1.75rem 5rem; 
      border-radius: 9999px;
      font-size: 1.4rem; 
      font-weight: 800; 
      border: 2px solid rgba(249, 115, 22, 0.5); 
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 
        0 10px 40px rgba(249, 115, 22, 0.3),
        0 0 0 2px rgba(249, 115, 22, 0.2) inset;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .cta-button:hover {
      transform: translateY(-5px) scale(1.05);
      box-shadow: 
        0 20px 60px rgba(249, 115, 22, 0.5),
        0 0 50px rgba(249, 115, 22, 0.4),
        0 0 0 3px rgba(249, 115, 22, 0.3) inset;
    }

    .cta-button:active {
      transform: translateY(-2px) scale(1.02);
    }

    /* Enhanced shine effect */
    .cta-button::after {
      content: '';
      position: absolute;
      top: 0; left: -200%;
      width: 200%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 140, 0, 0.6), rgba(255, 255, 255, 0.9), rgba(255, 140, 0, 0.6), transparent);
      transform: skewX(-25deg);
      transition: 0.8s;
    }

    .cta-button:hover::after {
      left: 200%;
      transition: 1s ease-in-out;
    }

    .cta-features { 
      color: rgba(255, 255, 255, 0.7); 
      font-size: 1rem; 
      font-weight: 600; 
      margin-top: 3rem; 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      gap: 3rem; 
      flex-wrap: wrap;
      opacity: 0; 
      transform: translateY(20px);
    }
    
    .cta-feature { 
      display: flex; 
      align-items: center; 
      gap: 0.75rem;
      padding: 0.75rem 1.5rem;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 9999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      transition: all 0.3s ease;
    }
    
    .cta-feature:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(249, 115, 22, 0.3);
      transform: translateY(-2px);
    }
    
    .cta-icon { 
      width: 1.25rem; 
      height: 1.25rem; 
      color: #f97316;
      filter: drop-shadow(0 0 5px rgba(249, 115, 22, 0.5));
    }
    
    .footer { background: #000; padding: 2rem; text-align: center; border-top: 1px solid #333; color: rgba(255, 255, 255, 0.6); }

  </style>
</head>
<body>
  <!-- Navigation -->
