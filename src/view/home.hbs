  <script>
    // Mobile Menu Toggle
    function toggleMenu() {
      const menu = document.getElementById('mobileMenu');
      const burger = document.querySelector('.burger');
      menu.classList.toggle('active');
      burger.classList.toggle('active');
    }

    // GSAP Animations
    gsap.registerPlugin(ScrollTrigger);

    // Navigation
    gsap.from('.nav-logo', { opacity: 0, x: -30, duration: 1.2, ease: 'power3.out' });
    gsap.from('.nav-links a', { opacity: 0, y: -20, duration: 1, stagger: 0.15, ease: 'power3.out' });
    gsap.from('.nav-buttons a', { opacity: 0, x: 30, duration: 1.2, stagger: 0.1, ease: 'power3.out' });

    // Hero Content
    gsap.from('.marquee-text', { opacity: 0, x: 100, duration: 1.5, delay: 0.4, ease: 'power4.out' });
    gsap.from('.hero-button-container', { opacity: 0, y: 50, duration: 1.2, delay: 0.8, ease: 'power3.out' });
    
    // Floating Cards
    gsap.from('.floating-card-1', { opacity: 100, x: -50, duration: 1.2, delay: 1, ease: 'power3.out' });
    gsap.from('.floating-card-2', { opacity: 100, x: -50, duration: 1.2, delay: 1.2, ease: 'power3.out' });
    gsap.from('.floating-card-3', { opacity: 100, x: 50, duration: 1.2, delay: 1.4, ease: 'power3.out' });
    gsap.from('.floating-card-4', { opacity: 100, x: 50, duration: 1.2, delay: 1.6, ease: 'power3.out' });
    
    gsap.from('.trainer-badge', { opacity: 0, scale: 0.8, duration: 1.2, delay: 1.8, ease: 'back.out(1.7)' });
    
    // Hero Image
    gsap.from('.hero-img', { opacity: 0, scale: 0.9, duration: 1.5, delay: 0.6, ease: 'power3.out' });
    
    // Scroll Indicator
    gsap.from('.scroll-indicator', { opacity: 0, y: -20, duration: 1.2, delay: 2, ease: 'power3.out' });

    // Programs Cards
    gsap.from('.program-card', {
      scrollTrigger: {
        trigger: '.programs-grid',
        start: 'top 80%',
      },
      opacity: 100,
      y: 50,
      duration: 1,
      stagger: 0.2,
      ease: 'power3.out'
    });

    // Smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          toggleMenu(); // Close mobile menu
        }
      });
    });

    // Close mobile menu on outside click
    document.addEventListener('click', function(e) {
      const menu = document.getElementById('mobileMenu');
      const burger = document.querySelector('.burger');
      if (!menu.contains(e.target) && !burger.contains(e.target) && menu.classList.contains('active')) {
        toggleMenu();
      }
    });
  </script>
