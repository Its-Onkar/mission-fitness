                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path>
                </svg>
              </div>
              <div>
                <div class="floating-card-calories-text-small">Calories</div>
                <div class="floating-card-calories-text-large luxury-gradient">824 Kcal</div>
              </div>
            </div>
          </div>

          <div class="floating-card floating-card-4">
            <div class="floating-card-content floating-card-flexibility-gap">
              <div class="floating-card-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <div class="floating-card-calories-text-small">Flexibility</div>
                <div class="floating-card-text-medium">Training</div>
              </div>
            </div>
          </div>

          <!-- Image -->
          <img src="images/main.png" alt="Fitness Hero Image" class="hero-img">

        </div>
        
        <!-- NEW MODERN BOTTOM BUTTONS -->
        <div class="hero-cta-wrapper">
          <div class="modern-cta-group">
            <a href="/start" class="btn-mission-start">
              <span>START YOUR MISSION</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
            
            <a href="/demo" class="btn-watch-demo">
              <div class="play-icon-bg">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              </div>
              <span>WATCH DEMO</span>
            </a>
          </div>
        </div>

      </div> <!-- Close hero-relative -->
    </div> <!-- Close hero-container -->
    
    <div class="bottom-gradient"></div>
  </section> <!-- Close hero-section -->

  <!-- Exercise Masterclass Gallery (Replaced Programs Section) -->
  <section id="program" class="programs-section luxury-section">
    <div class="programs-container">
      <div class="programs-header">
        <div class="programs-badge">
          <span class="programs-badge-text">Exercise Gallery</span>
        </div>
        <h2 class="programs-title">
          Master The <span class="luxury-gradient">Fundamentals</span>
        </h2>
        <p class="programs-subtitle">
          Select an exercise to view the detailed step-by-step breakdown. Perfect form is the key to progress.
        </p>
      </div>

      <!-- New Interactive Gallery Layout -->
      <div class="ex-gallery-container">
        <!-- Sidebar Selection -->
        <div class="ex-menu">
          <div class="ex-menu-title">Compound Movements</div>
          <!-- Buttons generated by JS -->
          <div id="exercise-list-container"></div>
        </div>

        <!-- Main Display -->
        <div class="ex-display">
          <div id="ex-content-wrapper" class="ex-content">
            <div class="ex-header">
              <h3 class="ex-main-title" id="ex-title">Barbell Squats</h3>
              <div class="ex-tags">
                <span class="ex-tag ex-tag-level" id="ex-level">Intermediate</span>
                <span class="ex-tag ex-tag-muscle" id="ex-muscle">Legs & Glutes</span>
              </div>
            </div>

            <div class="ex-visual-row">
              <div class="ex-image-wrapper">
                <img src="" alt="Exercise" class="ex-image" id="ex-image">
              </div>
              <div class="ex-steps-container">
                <div class="ex-steps-title">Execution Steps</div>
                <ul class="ex-step-list" id="ex-steps-list">
                  <!-- Steps injected via JS -->
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- IMPROVED ANIMATED CTA SECTION -->
  <section class="cta-section">
    <div class="cta-bg-animate">
      <div class="cta-aurora"></div>
    </div>
    
    <div class="cta-container">
      <div class="cta-card">
        <div class="cta-badge">
          <span class="cta-badge-text">Limited Time Offer</span>
        </div>
        <h2 class="cta-title">
          <span class="cta-title-outline">READY TO START YOUR</span><br>
          <span class="cta-title-gradient" style="font-family: 'Sakana', sans-serif; font-style: italic; text-transform: lowercase; letter-spacing: 0.05em;">journey?</span>
        </h2>
        <p class="cta-subtitle">
          Join thousands of members who have transformed their lives with Mission Fitness's premium fitness experience.
        </p>
        <div class="cta-btn-wrapper">
          <button class="cta-button">
            GET STARTED TODAY
          </button>
        </div>
        <div class="cta-features">
          <div class="cta-feature">
            <svg class="cta-icon" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            14-day free trial
          </div>
          <div class="cta-feature">
            <svg class="cta-icon" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            No credit card required
          </div>
          <div class="cta-feature">
            <svg class="cta-icon" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            Premium Access
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  {{> footer}}

  <script>
    // Mobile Menu Toggle
    function toggleMenu() {
      const menu = document.getElementById('mobileMenu');
      const burger = document.querySelector('.burger');
      menu.classList.toggle('active');
      burger.classList.toggle('active');
    }

    // GSAP Animations
    gsap.registerPlugin(ScrollTrigger);

    // Navigation
    gsap.from('.nav-logo', { opacity: 0, x: -30, duration: 1.2, ease: 'power3.out' });
    gsap.from('.nav-links a', { opacity: 0, y: -20, duration: 1, stagger: 0.15, ease: 'power3.out' });
    gsap.from('.nav-buttons a', { opacity: 0, x: 30, duration: 1.2, stagger: 0.1, ease: 'power3.out' });

    // Hero Content
    gsap.from('.marquee-text', { opacity: 0, x: 100, duration: 1.5, delay: 0.4, ease: 'power4.out' });
    
    // Animate New Bottom Buttons
    gsap.from('.hero-cta-wrapper', { opacity: 0, y: 50, duration: 1.2, delay: 1.0, ease: 'power3.out' });
    
    // Floating Cards
    gsap.from('.floating-card-1', {  x: -50, duration: 1.2, delay: 1, ease: 'power3.out' });
    gsap.from('.floating-card-2', {  x: -50, duration: 1.2, delay: 1.2, ease: 'power3.out' });
    gsap.from('.floating-card-3', {  x: 50, duration: 1.2, delay: 1.4, ease: 'power3.out' });
    gsap.from('.floating-card-4', {  x: 50, duration: 1.2, delay: 1.6, ease: 'power3.out' });
    
    // Hero Image
    gsap.from('.hero-img', {  scale: 0.9, duration: 1.5, delay: 0.6, ease: 'power3.out' });

    // Gallery Fade In
    gsap.from('.ex-gallery-container', {
      scrollTrigger: {
        trigger: '.programs-section',
        start: 'top 70%',
      },
      y: 50,
      opacity: 0,
      duration: 1,
      ease: 'power3.out'
    });

    // --- NEW CTA SECTION ANIMATIONS ---
    const ctaTl = gsap.timeline({
      scrollTrigger: {
        trigger: '.cta-section',
        start: 'top 60%',
        toggleActions: 'play none none reverse'
      }
    });

    ctaTl.to('.cta-card', { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' })
         .to('.cta-badge', { opacity: 1, y: 0, duration: 0.5 }, '-=0.4')
         .to('.cta-title', { opacity: 1, y: 0, duration: 0.5 }, '-=0.3')
         .to('.cta-subtitle', { opacity: 1, y: 0, duration: 0.5 }, '-=0.3')
         .to('.cta-btn-wrapper', { opacity: 1, y: 0, duration: 0.5 }, '-=0.3')
         .to('.cta-features', { opacity: 1, y: 0, duration: 0.5 }, '-=0.3');


    // --- EXERCISE GALLERY LOGIC ---
    const exercises = [
      {
        id: 'squat',
        title: 'Barbell Squat',
        level: 'Intermediate',
        muscle: 'Legs & Glutes',
        image: 'https://images.unsplash.com/photo-1574680096145-d05b474e2155?q=80&w=1200&auto=format&fit=crop',
        steps: [
          'Stand with feet shoulder-width apart, toes slightly out.',
          'Rest the barbell comfortably on your upper back (traps).',
          'Keep chest up, engage core, and break at the hips.',
          'Lower down as if sitting in a chair until thighs are parallel.',
          'Drive through heels to return to start position.'
        ]
      },
      {
        id: 'deadlift',
        title: 'Conventional Deadlift',
        level: 'Advanced',
        muscle: 'Posterior Chain',
        image: 'https://images.unsplash.com/photo-1517836357463-d25dfeac3438?q=80&w=1200&auto=format&fit=crop',
        steps: [
          'Stand with mid-foot under the barbell.',
          'Bend over and grab the bar with a shoulder-width grip.',
          'Bend your knees until shins touch the bar.',
          'Lift your chest up and straighten your back.',
          'Pull the bar up dragging it against your shins.'
        ]
      },
      {
        id: 'pushup',
        title: 'Perfect Push-up',
        level: 'Beginner',
        muscle: 'Chest & Triceps',
        image: 'https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?q=80&w=1200&auto=format&fit=crop',
        steps: [
          'Start in a high plank position, hands slightly wider than shoulders.',
          'Engage your core and squeeze your glutes.',
          'Lower your body until chest nearly touches floor.',
          'Keep elbows tucked at a 45-degree angle.',
          'Push back up to starting position explosively.'
        ]
      },
      {
        id: 'lunge',
        title: 'Walking Lunges',
        level: 'Intermediate',
        muscle: 'Legs & Balance',
        image: 'https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=1200&auto=format&fit=crop',
        steps: [
          'Stand tall with feet hip-width apart.',
          'Step forward with one leg, lowering hips until both knees are bent 90°.',
          'Keep front knee directly above ankle.',
          'Push off the back foot to bring it forward to meet the front.',
          'Repeat on the opposite side.'
        ]
      },
      {
        id: 'plank',
        title: 'Forearm Plank',
        level: 'Beginner',
        muscle: 'Core Stability',
        image: 'https://images.unsplash.com/photo-1566241440091-ec10de8db2e1?q=80&w=1200&auto=format&fit=crop',
        steps: [
          'Place forearms on floor, elbows under shoulders.',
          'Extend legs back, balancing on toes.',
          'Maintain a straight line from head to heels.',
          'Tighten abs and glutes to prevent sagging.',
          'Hold position while breathing rhythmically.'
        ]
      }
    ];

    const listContainer = document.getElementById('exercise-list-container');
    const contentWrapper = document.getElementById('ex-content-wrapper');
    const domTitle = document.getElementById('ex-title');
    const domLevel = document.getElementById('ex-level');
    const domMuscle = document.getElementById('ex-muscle');
    const domImage = document.getElementById('ex-image');
    const domList = document.getElementById('ex-steps-list');

    function renderExerciseList() {
      listContainer.innerHTML = '';
      exercises.forEach((ex, index) => {
        const btn = document.createElement('button');
        btn.className = `ex-btn ${index === 0 ? 'active' : ''}`;
        btn.innerHTML = `
          <span>${ex.title}</span>
          <svg class="ex-btn-arrow" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        `;
        btn.onclick = () => loadExercise(index);
        listContainer.appendChild(btn);
      });
    }

    function loadExercise(index) {
      // update buttons
      const buttons = document.querySelectorAll('.ex-btn');
      buttons.forEach(b => b.classList.remove('active'));
      buttons[index].classList.add('active');

      // fade out content
      contentWrapper.classList.add('fade-out');

      setTimeout(() => {
        const data = exercises[index];
        domTitle.textContent = data.title;
        domLevel.textContent = data.level;
        domMuscle.textContent = data.muscle;
        domImage.src = data.image;
        
        // Render steps
        domList.innerHTML = data.steps.map((step, i) => `
          <li class="ex-step-item">
            <span class="ex-step-num">${i + 1}</span>
            <span class="ex-step-text">${step}</span>
          </li>
        `).join('');

        // fade in
        contentWrapper.classList.remove('fade-out');
      }, 300);
    }

    // Initialize
    renderExerciseList();
    loadExercise(0); // Load first item

    // Smooth scroll (existing logic)
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          toggleMenu(); // Close mobile menu
        }
      });
    });

    // Close mobile menu on outside click
    document.addEventListener('click', function(e) {
      const menu = document.getElementById('mobileMenu');
      const burger = document.querySelector('.burger');
      if (!menu.contains(e.target) && !burger.contains(e.target) && menu.classList.contains('active')) {
        toggleMenu();
      }
    });
  </script>
</body>
</html>