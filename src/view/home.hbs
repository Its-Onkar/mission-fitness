<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mission Fitness - Elevate Your Fitness</title>
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
    @import url('https://api.fontshare.com/v2/css?f[]=sakana@900&display=swap');

    body {
      font-family: 'Inter', sans-serif;
      background: #000;
      color: #fff;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    .hero-bg {
      background: linear-gradient(135deg, #000 0%, #111 100%);
    }

    .floating-card {
      position: absolute;
      background: #1a1a1a;
      border: 1px solid #333;
      padding: 1rem;
      border-radius: 24px;
      animation: float 4s ease-in-out infinite;
      z-index: 20;
      transform-style: preserve-3d;
      transition: all 0.3s ease;
      display: block;
      visibility: visible;
      opacity: 1;
    }

    .floating-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(135deg, rgba(249, 115, 22, 0.2) 0%, transparent 50%);
      border-radius: 24px;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .floating-card:hover::before {
      opacity: 1;
    }

    .floating-card:hover {
      transform: translateY(-10px) scale(1.05);
      border-color: #f97316;
      box-shadow: 0 25px 70px rgba(249, 115, 22, 0.3), 0 0 1px rgba(255, 255, 255, 0.3) inset;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-25px) rotate(1deg); }
    }

    .floating-card-1 { 
      bottom: 20%; 
      left: 22%; 
      animation-delay: 0s;
      border-radius: 30px 10px 30px 10px;
    }
    .floating-card-2 { 
      bottom: 35%; 
      left: 22%; 
      animation-delay: 0.7s;
      border-radius: 10px 30px 10px 30px;
    }
    .floating-card-3 { 
      bottom: 18%; 
      right: 16%; 
      animation-delay: 1.4s;
      border-radius: 10px 25px 10px 25px;
    }
    .floating-card-4 { 
      bottom: 35%; 
      right: 22%; 
      animation-delay: 2.1s;
      border-radius: 10px 30px 10px 30px;
    }

    .trainer-badge {
      background: #111;
      border: 1px solid #333;
      border-radius: 1.5rem;
      animation: float 4s ease-in-out infinite;
      animation-delay: 0.5s;
      z-index: 15;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", "Liberation Sans", Arial, sans-serif, 
     "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
    }

    .gradient-text {
      color: #fff;
      text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
    }

    .luxury-gradient {
      color: #f97316;
      text-shadow: 0 0 10px rgba(249, 115, 22, 0.5);
    }

    .hero-image {
      position: relative;
      height: 100vh; 
      width: 100%;
      z-index: 5;
    }

    .hero-img {
      position: relative;
      z-index: 10;
      width: 100%;
      height: auto;
      object-fit: cover;
    }

    .glow-orange {
      box-shadow: 0 0 10px rgba(249, 115, 22, 0.3), 0 0 80px rgba(249, 115, 22, 0.2);
    }

    .mobile-menu {
      transform: translateX(100%);
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      display: block;
    }

    .mobile-menu.active {
      transform: translateX(0);
    }

    .burger-line {
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .burger.active .burger-line:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .burger.active .burger-line:nth-child(2) {
      opacity: 0;
    }

    .burger.active .burger-line:nth-child(3) {
      transform: rotate(-45deg) translate(7px, -6px);
    }

    @media (max-width: 768px) {
      .floating-card { 
        padding: 0.75rem;
        font-size: 0.85rem;
      }
      .floating-card-1 { left: 5%; bottom: 15%; }
      .floating-card-2 { left: 5%; bottom: 35%; }
      .floating-card-3 { right: 5%; bottom: 15%; }
      .floating-card-4 { right: 5%; bottom: 35%; }
    }

    .luxury-section {
      position: relative;
      overflow: hidden;
    }

    .luxury-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: radial-gradient(circle at 20% 80%, rgba(249, 115, 22, 0.1) 0%, transparent 50%),
                  radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
      pointer-events: none;
    }

    .marquee-bg {
      position: absolute;
      inset: 0;
      z-index: 1;
      
    }

    .marquee-bg::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 800px;
      height: 800px;
      background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0.1) 100%);
      box-shadow: 0 0 40px rgba(246, 246, 246, 0.4), 0 0 80px rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      filter: blur(60px);
    }

    .marquee-container {
      position: absolute;
      z-index: 2;
      top: 50%;
      left: 0;
      width: 200%;
      transform: translateY(-50%);
      white-space: nowrap;
    }

    .marquee-text {
      display: inline-block;
      font-size: 4rem;
      font-weight: 900;
      color: #fff;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
      animation: marquee 40s linear infinite;
    }

    @media (min-width: 768px) {
      .marquee-text {
        font-size: 6rem;
      }
    }

    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    .hero-button {
      position: absolute;
      bottom: 10%;
      left: 50%;
      transform: translateX(-50%);
      z-index: 30;
    }

    .bottom-gradient {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 20%;
      background: linear-gradient(to top, #000, transparent);
      z-index: 10;
      pointer-events: none;
    }

    .nav-fixed {
      position: fixed;
      top: 0;
      width: 100%;
      background: #000;
      z-index: 50;
      border-bottom: 1px solid #333;
    }

    .nav-container {
      max-width: 80rem;
      margin: 0 auto;
      padding: 0 1.5rem;
     
      
    }

    .nav-flex {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem 0;
    }

    .nav-logo {
      font-size: 1.5rem;
      font-weight: 700;
    }

    .nav-logo-white {
      color: #fff;
    }

    .nav-logo-gradient {
      font-style: italic;
      color: #f97316;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
    }

    .nav-link {
      color: #fff;
      transition: all 0.3s;
      font-weight: 500;
      border-bottom: 2px solid transparent;
      padding-bottom: 0.25rem;
      text-decoration: none;
    }

    .nav-link:hover {
      color: #fb923c;
      border-color: #fb923c;
    }

    .nav-link-inactive {
      color: rgba(255, 255, 255, 0.7);
    }

    .nav-buttons {
      gap: 1rem;
      display: flex;
      
      justify-items: end;
    }

    @media (min-width: 768px) {
      .nav-buttons {
        display: flex;
      }
      .burger {
        display: none;
      }
    }

    .nav-button {
      color: #fff;
      padding: 0.625rem 1.5rem;
      border-radius: 9999px;
      font-weight: 500;
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s;
      text-decoration: none;
      display: inline-block;
    }

    .nav-button:hover {
      border-color: rgba(255, 255, 255, 0.4);
      background-color: rgba(255, 255, 255, 0.1);
    }

    .nav-button-register {
      background-color: #dc2626;
      color: #fff;
      font-weight: 600;
    }

    .nav-button-register:hover {
      background-color: #b91c1c;
    }

    .burger {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      padding: 0.5rem;
      background: none;
      border: none;
      cursor: pointer;
    }

    .burger-line {
      width: 1.5rem;
      height: 0.125rem;
      background-color: #fff;
      border-radius: 0.25rem;
    }

    .mobile-menu {
      position: fixed;
      top: 0;
      right: 0;
      height: 100vh;
      width: 300px;
      background: #000;
      border-left: 1px solid #333;
      padding: 5rem 1.5rem 0;
      z-index: 60;
    }

    .mobile-menu-flex {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .mobile-link {
      color: #fff;
      transition: all 0.3s;
      font-size: 1.125rem;
      font-weight: 500;
      border-bottom: 1px solid transparent;
      padding-bottom: 0.5rem;
      text-decoration: none;
    }

    .mobile-link:hover {
      color: #fb923c;
      border-color: #fb923c;
    }

    .mobile-link-inactive {
      color: rgba(255, 255, 255, 0.7);
    }

    .mobile-border-t {
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      gap: 1rem;
    }

    .mobile-button {
      width: 100%;
      color: #fff;
      padding: 0.625rem 1.5rem;
      border-radius: 9999px;
      font-weight: 500;
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s;
      text-align: center;
      text-decoration: none;
      display: block;
    }

    .mobile-button:hover {
      border-color: rgba(255, 255, 255, 0.4);
      background-color: rgba(255, 255, 255, 0.1);
    }

    .mobile-register {
      background-color: #dc2626;
      color: #fff;
      font-weight: 600;
    }

    .mobile-register:hover {
      background-color: #b91c1c;
    }

    .hero-section {
      min-height: 70vh;
      position: relative;
      overflow: hidden;
      padding-top: 80px;
      padding-bottom: 5rem;
    }

    .hero-container {
      max-width: 80rem;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .hero-relative {
      position: relative;
      width: 100%;
      height: 80vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-image-container {
      max-width: 62.5rem;
      width: 100%;
      height: 100%;
      position: relative;
    }

    .floating-card-content {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .floating-card-icon {
      width: 1.5rem;
      height: 1.5rem;
      color: #fff;
    }

    .floating-card-text-small {
      font-size: 0.75rem;
      color: #ccc;
    }

    .floating-card-text-medium {
      font-size: 0.875rem;
      font-weight: 600;
      color: #fff;
    }

    .floating-card-heart-large {
      font-size: 1.25rem;
      font-weight: 500;
      color: #fff;
    }

    .floating-card-calories-icon {
      width: 3rem;
      height: 3rem;
      background: #1a1a1a;
      border-radius: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #f97316;
    }

    .floating-card-calories-text-small {
      font-size: 0.75rem;
      color: #ccc;
    }

    .floating-card-calories-text-large {
      font-size: 1.25rem;
      font-weight: 500;
      color: #f97316;
    }

    .floating-card-flexibility-gap {
      gap: 0.75rem;
    }

    .trainer-badge {
      position: absolute;
      bottom: -1.5rem;
      right: -1.5rem;
      padding: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .hero-button-container {
      position: absolute;
      bottom: 10%;
      left: 50%;
      transform: translateX(-50%);
      z-index: 30;
    }

    .hero-button-style {
      background-color: #dc2626;
      color: #fff;
      padding: 1rem 2rem;
      border-radius: 1rem;
      font-size: 1.125rem;
      font-weight: 500;
      transition: all 0.3s;
      border: none;
      cursor: pointer;
    }

    .hero-button-style:hover {
      background-color: #b91c1c;
    }

    .scroll-indicator {
      position: absolute;
      bottom: 2.5rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 20;
    }

    .scroll-text {
      color: #999;
      font-size: 0.875rem;
      margin-bottom: 0.5rem;
      font-weight: 500;
      text-align: center;
    }

    .scroll-arrow {
      width: 1.5rem;
      height: 2.5rem;
      border: 2px solid #333;
      border-radius: 9999px;
      margin: 0 auto;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 0.5rem;
    }

    .scroll-dot {
      width: 0.25rem;
      height: 0.5rem;
      background-color: #fb923c;
      border-radius: 0.25rem;
      animation: bounce 1s infinite;
      animation-delay: 0.2s;
    }

    @keyframes bounce {
      0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
      40% { transform: translateY(-10px); }
      60% { transform: translateY(-5px); }
    }

    .programs-section {
      padding: 8rem 0;
      background: #000;
    }

    .programs-container {
      max-width: 80rem;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .programs-header {
      text-align: center;
      margin-bottom: 5rem;
    }

    .programs-badge {
      display: inline-block;
      margin-bottom: 1.5rem;
    }

    .programs-badge-text {
      color: #fb923c;
      font-weight: 700;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      background: #2a1810;
      padding: 0.5rem 1.5rem;
      border-radius: 9999px;
      border: 1px solid #4a2c1a;
    }

    .programs-title {
      font-size: 3rem;
      font-weight: 900;
      color: #fff;
      margin-bottom: 1.5rem;
      line-height: 1.1;
    }

    @media (min-width: 768px) {
      .programs-title {
        font-size: 4.5rem;
      }
    }

    .programs-subtitle {
      color: rgba(255, 255, 255, 0.7);
      font-size: 1.25rem;
      max-width: 48rem;
      margin: 0 auto;
      line-height: 1.625;
    }

    .programs-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    @media (min-width: 768px) {
      .programs-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .program-card {
      background: #181818;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 1.5rem;
      padding: 2.5rem;
      transition: all 0.5s;
      cursor: pointer;
    }

    .program-card:hover {
      border-color: #f97316;
      transform: scale(1.05);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(249, 115, 22, 0.2);
    }

    .program-icon {
      width: 5rem;
      height: 5rem;
      background: linear-gradient(to bottom right, #f97316, #ea580c);
      border-radius: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1rem;
      transition: all 0.3s;
    }

    .program-icon:hover {
      transform: scale(1.1) rotate(6deg);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.1);
    }

    .program-icon-svg {
      width: 2.5rem;
      height: 2.5rem;
      color: #fff;
    }

    .program-image {
      width: 100%;
      height: 12rem;
      background: #1f2937;
      border-radius: 1rem;
      overflow: hidden;
      margin-bottom: 1.5rem;
      transition: opacity 0.3s;
    }

    .program-image:hover {
      opacity: 0.9;
    }

    .program-image-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .program-title {
      font-size: 1.875rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 1rem;
    }

    .program-description {
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.625;
      margin-bottom: 2rem;
      font-size: 1.125rem;
    }

    .program-button {
      color: #fb923c;
      font-weight: 600;
      transition: all 0.3s;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .program-button:hover {
      color: #f97316;
      transform: translateX(0.5rem);
    }

    .program-arrow {
      width: 1rem;
      height: 1rem;
      transition: all 0.3s;
    }

    .cta-section {
      padding: 8rem 0;
      background: linear-gradient(to bottom right, #dc2626, #ea580c, #c2410c);
      position: relative;
      overflow: hidden;
    }

    .cta-bg-elements {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      overflow: hidden;
      z-index: 1;
    }

    .cta-bg-circle {
      position: absolute;
      width: 24rem;
      height: 24rem;
      background: rgba(42, 24, 16, 0.3);
      border-radius: 9999px;
      filter: blur(48px);
      animation: pulse 2s infinite;
    }

    .cta-bg-circle-top {
      top: 5rem;
      left: 5rem;
    }

    .cta-bg-circle-bottom {
      bottom: 5rem;
      right: 5rem;
      animation-delay: 1s;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.6; }
    }

    .cta-container {
      max-width: 64rem;
      margin: 0 auto;
      text-align: center;
      padding: 0 1.5rem;
      position: relative;
      z-index: 10;
    }

    .cta-badge {
      display: inline-block;
      margin-bottom: 2rem;
    }

    .cta-badge-text {
      color: rgba(255, 255, 255, 0.9);
      font-weight: 700;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      background: rgba(255, 255, 255, 0.15);
      padding: 0.75rem 1.5rem;
      border-radius: 9999px;
      border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .cta-title {
      font-size: 3rem;
      font-weight: 900;
      color: #fff;
      margin-bottom: 2rem;
      line-height: 1.1;
    }

    @media (min-width: 768px) {
      .cta-title {
        font-size: 4.5rem;
      }
    }

    .cta-subtitle {
      font-size: 1.5rem;
      color: rgba(255, 255, 255, 0.95);
      margin-bottom: 3rem;
      max-width: 48rem;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.625;
    }

    .cta-button {
      background: #fff;
      color: #dc2626;
      padding: 1.5rem 4rem;
      border-radius: 9999px;
      font-size: 1.25rem;
      font-weight: 700;
      transition: all 0.3s;
      border: none;
      cursor: pointer;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3);
    }

    .cta-button:hover {
      background: rgba(255, 255, 255, 0.95);
      transform: scale(1.05);
      box-shadow: 0 25px 50px -12px rgba(255, 255, 255, 0.3);
    }

    .cta-features {
      color: rgba(255, 255, 255, 0.9);
      font-size: 1rem;
      font-weight: 500;
      margin-top: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      flex-wrap: wrap;
    }

    .cta-feature {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .cta-icon {
      width: 1.25rem;
      height: 1.25rem;
      color: #fff;
    }

    .footer {
      background: #000;
      padding: 2rem;
      text-align: center;
      border-top: 1px solid #333;
      color: rgba(255, 255, 255, 0.6);
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="nav-fixed">
    <div class="nav-container">
      <div class="nav-flex">
        <div class="nav-logo">
          <span class="nav-logo-white">Mission</span><span class="nav-logo-gradient">Fitness</span>
        </div>
        
        <!-- Desktop Menu -->
       
        
        <!-- Desktop Buttons -->
        <div class="nav-buttons">
          <a href="/login" class="nav-button">Login</a>
          <a href="/register" class="nav-button nav-button-register">Sign Up</a>
        </div>

        <!-- Mobile Menu Button -->
        <button class="burger" onclick="toggleMenu()">
          <span class="burger-line"></span>
          <span class="burger-line"></span>
          <span class="burger-line"></span>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
      <div class="mobile-menu-flex">
    
        <div class="mobile-border-t">
          <a href="/login" class="mobile-button">Login</a>
          <a href="/register" class="mobile-button mobile-register">Sign Up</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section id="home" class="hero-section hero-bg luxury-section">
    <div class="hero-container">
      <div class="hero-relative">
        
        <!-- Marquee behind the image -->
        <div class="marquee-bg">
