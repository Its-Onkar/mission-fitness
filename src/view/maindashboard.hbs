        // Goal-Based Weight Tracking System
        function calculateGoalProgress(user, weightData) {
            const goal = user.fitnessGoal || user.goal || 'weight_loss';
            const currentWeight = weightData.current || 80; // Use logged weight or default
            const targetWeight = user.targetWeight || user.goalWeight || 70;
            const startWeight = user.currentWeight || user.startWeight || 85; // Onboarding weight
            const timeframe = user.timeframe || user.duration || 12; // weeks
            const startDate = new Date(user.createdAt || Date.now());
            const weeksElapsed = Math.max(1, Math.floor((Date.now() - startDate.getTime()) / (7 * 24 * 60 * 60 * 1000)));
            
            let expectedWeight, progressPercent, status, statusColor, aiInsight;
            
            if (goal === 'weight_loss' || goal === 'lose_weight') {
                const totalToLose = startWeight - targetWeight;
                const expectedWeeklyLoss = totalToLose / timeframe;
                expectedWeight = startWeight - (expectedWeeklyLoss * weeksElapsed);
                const actualLoss = startWeight - currentWeight;
                const expectedLoss = expectedWeeklyLoss * weeksElapsed;
                
                progressPercent = totalToLose > 0 ? Math.min(100, (actualLoss / totalToLose) * 100) : 0;
                
                if (actualLoss >= expectedLoss * 0.8) {
                    status = 'ON TRACK';
                    statusColor = 'bg-green-100 text-green-700';
                    aiInsight = {
                        icon: '🎯',
                        text: 'Excellent progress! You\'re losing weight at a healthy pace.',
                        detail: `Lost ${Math.max(0, actualLoss).toFixed(1)}kg of ${totalToLose.toFixed(1)}kg target`
                    };
                } else if (actualLoss >= expectedLoss * 0.5) {
                    status = 'SLOW PROGRESS';
                    statusColor = 'bg-yellow-100 text-yellow-700';
                    aiInsight = {
                        icon: '⚠️',
                        text: 'Progress is slower than expected. Let\'s boost your efforts!',
                        detail: `Lost ${Math.max(0, actualLoss).toFixed(1)}kg of ${totalToLose.toFixed(1)}kg target - increase cardio`
                    };
                } else if (actualLoss <= 0) {
                    status = 'NEEDS ATTENTION';
                    statusColor = 'bg-red-100 text-red-700';
                    aiInsight = {
                        icon: '🚨',
                        text: 'Weight hasn\'t decreased yet. Time to focus on your plan!',
                        detail: `Target: lose ${totalToLose.toFixed(1)}kg - track meals and increase activity`
                    };
                } else {
                    status = 'BEHIND TARGET';
                    statusColor = 'bg-orange-100 text-orange-700';
                    aiInsight = {
                        icon: '📉',
                        text: 'You\'re behind your weight loss target. Let\'s get back on track!',
                        detail: `Lost ${actualLoss.toFixed(1)}kg of ${totalToLose.toFixed(1)}kg - need ${(expectedLoss - actualLoss).toFixed(1)}kg more`
                    };
                }
            } else if (goal === 'weight_gain' || goal === 'gain_weight') {
                const totalToGain = targetWeight - startWeight;
                const expectedWeeklyGain = totalToGain / timeframe;
                expectedWeight = startWeight + (expectedWeeklyGain * weeksElapsed);
                const actualGain = currentWeight - startWeight;
                const expectedGain = expectedWeeklyGain * weeksElapsed;
                
                progressPercent = totalToGain > 0 ? Math.min(100, (actualGain / totalToGain) * 100) : 0;
                
                if (actualGain >= expectedGain * 0.8) {
                    status = 'GAINING WELL';
                    statusColor = 'bg-green-100 text-green-700';
                    aiInsight = {
                        icon: '💪',
                        text: 'Great job! You\'re gaining weight at a healthy rate.',
                        detail: `Gained ${Math.max(0, actualGain).toFixed(1)}kg of ${totalToGain.toFixed(1)}kg target`
                    };
                } else if (actualGain < 0) {
                    status = 'LOSING WEIGHT';
                    statusColor = 'bg-red-100 text-red-700';
                    aiInsight = {
                        icon: '⚠️',
                        text: 'You\'re losing weight instead of gaining. Increase your intake!',
                        detail: `Lost ${Math.abs(actualGain).toFixed(1)}kg - need to gain ${totalToGain.toFixed(1)}kg total`
                    };
                } else {
                    status = 'SLOW GAIN';
                    statusColor = 'bg-yellow-100 text-yellow-700';
                    aiInsight = {
                        icon: '📈',
                        text: 'Weight gain is slower than expected. Add more calories!',
                        detail: `Gained ${actualGain.toFixed(1)}kg of ${totalToGain.toFixed(1)}kg - add protein-rich foods`
                    };
                }
            } else { // weight_maintenance
                const allowedRange = 2;
                const upperLimit = startWeight + allowedRange;
                const lowerLimit = startWeight - allowedRange;
                
                progressPercent = currentWeight >= lowerLimit && currentWeight <= upperLimit ? 100 : 0;
                
                if (currentWeight >= lowerLimit && currentWeight <= upperLimit) {
                    status = 'MAINTAINING';
                    statusColor = 'bg-green-100 text-green-700';
                    aiInsight = {
                        icon: '⚖️',
                        text: 'Perfect! You\'re maintaining your weight within the healthy range.',
                        detail: `Weight stable at ${currentWeight}kg (±${allowedRange}kg range)`
                    };
                } else if (currentWeight > upperLimit) {
                    status = 'ABOVE RANGE';
                    statusColor = 'bg-yellow-100 text-yellow-700';
                    aiInsight = {
                        icon: '⬆️',
                        text: 'Weight is above your maintenance range. Time to cut back!',
                        detail: `${(currentWeight - startWeight).toFixed(1)}kg above start weight - reduce portions`
                    };
                } else {
                    status = 'BELOW RANGE';
                    statusColor = 'bg-yellow-100 text-yellow-700';
                    aiInsight = {
                        icon: '⬇️',
                        text: 'Weight is below your maintenance range. Eat a bit more!',
                        detail: `${(startWeight - currentWeight).toFixed(1)}kg below start weight - add healthy snacks`
                    };
                }
            }
            
            return {
                goal,
                currentWeight,
                targetWeight,
                startWeight,
                expectedWeight,
                progressPercent: Math.max(0, progressPercent),
                status,
                statusColor,
                aiInsight,
                weeksElapsed,
                timeframe
            };
        }
        
        function updateGoalBasedWeightUI(goalData) {
