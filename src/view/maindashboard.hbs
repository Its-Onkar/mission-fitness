        async function submitWeight() {
            const weight = parseFloat(document.getElementById('weightInput').value);
            const notes = document.getElementById('notesInput').value;
            
            if (!weight || weight < 20 || weight > 300) {
                showToast('Invalid Weight', 'error', 'Please enter a weight between 20-300 kg');
                return;
            }
            
            await logWeightToBackend(weight, notes);
            closeWeightModal();
        }

        async function logWeightToBackend(weight, notes = '') {
            const token = localStorage.getItem('token') || sessionStorage.getItem('token');
            try {
                const response = await fetch('/api/weight/log', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ weight, notes })
                });

                if (response.ok) {
                    const result = await response.json();
                    const diff = result.progress.difference;
                    const trend = diff > 0 ? '↑' : diff < 0 ? '↓' : '→';
                    showToast('Weight Logged!', 'success', `${weight} kg ${trend} ${Math.abs(diff).toFixed(1)} kg`);
                    
                    // Update UI immediately
                    document.getElementById('currentWeight').textContent = `${weight} kg`;
                    document.getElementById('prevWeight').textContent = `${result.progress.previous} kg`;
                    document.getElementById('weightDiff').textContent = `${diff >= 0 ? '+' : ''}${diff.toFixed(1)} kg`;
                    document.getElementById('totalLost').textContent = `${result.progress.totalProgress.toFixed(1)} kg`;
                    
                    setTimeout(() => window.location.reload(), 2000);
                } else {
                    const err = await response.json();
                    showToast('Failed to log weight', 'error', err.message);
                }
            } catch (error) {
                console.error('Error logging weight:', error);
                showToast('Failed to log weight', 'error', 'Please try again');
            }
        }

