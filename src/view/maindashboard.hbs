            // Update status
            const statusElement = document.getElementById('goalStatus');
            statusElement.textContent = goalData.status;
            statusElement.className = `px-2 py-1 text-xs font-bold rounded-full ${goalData.statusColor}`;
            
            // Update progress
            const progressElement = document.getElementById('weightProgress');
            const progressLabel = document.getElementById('progressLabel');
            
            if (goalData.goal === 'weight_loss' || goalData.goal === 'lose_weight') {
                const lost = Math.max(0, goalData.startWeight - goalData.currentWeight);
                const remaining = Math.max(0, goalData.currentWeight - goalData.targetWeight);
                progressElement.innerHTML = `<span class="text-green-600">-${lost.toFixed(1)} kg</span>`;
                progressLabel.textContent = `${remaining.toFixed(1)} kg to go`;
            } else if (goalData.goal === 'weight_gain' || goalData.goal === 'gain_weight') {
                const gained = Math.max(0, goalData.currentWeight - goalData.startWeight);
                const remaining = Math.max(0, goalData.targetWeight - goalData.currentWeight);
                progressElement.innerHTML = `<span class="text-blue-600">+${gained.toFixed(1)} kg</span>`;
                progressLabel.textContent = `${remaining.toFixed(1)} kg to go`;
            } else {
                const diff = goalData.currentWeight - goalData.startWeight;
                const sign = diff >= 0 ? '+' : '';
                progressElement.innerHTML = `<span class="text-gray-600">${sign}${diff.toFixed(1)} kg</span>`;
                progressLabel.textContent = 'From start';
            }
            
            // Update progress bar
            const progressBar = document.getElementById('weightProgressBar');
            const barColor = goalData.status.includes('TRACK') || goalData.status.includes('WELL') || goalData.status.includes('MAINTAINING') 
                ? 'bg-green-500' : goalData.status.includes('SLOW') || goalData.status.includes('RANGE') 
                ? 'bg-yellow-500' : 'bg-red-500';
            progressBar.className = `h-2 rounded-full transition-all duration-500 ${barColor}`;
