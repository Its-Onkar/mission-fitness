        async function submitFood() {
            const foodName = document.getElementById('foodNameInput').value.trim();
            const mealType = document.getElementById('mealTypeInput').value;
            const calories = parseFloat(document.getElementById('caloriesInput').value);
            const protein = parseFloat(document.getElementById('proteinInput').value) || 0;
            const carbs = parseFloat(document.getElementById('carbsInput').value) || 0;
            const fats = parseFloat(document.getElementById('fatsInput').value) || 0;
            
            if (!foodName || !calories || calories <= 0) {
                showToast('Invalid Input', 'error', 'Please enter food name and valid calories');
                return;
            }
            
            await logFoodToBackend({ foodName, mealType, calories, protein, carbs, fats });
            closeFoodModal();
        }

        async function logFoodToBackend(foodData) {
            const token = localStorage.getItem('token') || sessionStorage.getItem('token');
            try {
                const response = await fetch('/api/diet/log-food', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(foodData)
                });

                if (response.ok) {
                    const result = await response.json();
                    const score = result.comparison.scores.overall;
                    showToast('Food Logged!', 'success', `Diet Score: ${score}% • ${result.comparison.insights[0]}`);
                    
                    // Update UI with comparison data
                    updateDietUI(result.comparison);
                    
                    // Also mark diet complete for performance tracking
                    await fetch('/api/performance/diet/complete', {
                        method: 'POST',
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    
                    setTimeout(() => window.location.reload(), 3000);
                } else {
                    const err = await response.json();
                    showToast('Failed to log food', 'error', err.message);
                }
            } catch (error) {
                console.error('Error logging food:', error);
                showToast('Failed to log food', 'error', 'Please try again');
            }
        }

        function updateDietUI(comparison) {
            // Update calories
            document.getElementById('calStatus').textContent = `${comparison.actual.calories} / ${comparison.target.calories}`;
            const calPercent = Math.min(100, (comparison.actual.calories / comparison.target.calories) * 100);
            document.getElementById('calBar').style.width = `${calPercent}%`;
            
            // Update protein
            document.getElementById('proteinStatus').textContent = `${comparison.actual.protein} / ${comparison.target.protein}g`;
            const proteinPercent = Math.min(100, (comparison.actual.protein / comparison.target.protein) * 100);
            document.getElementById('proteinBar').style.width = `${proteinPercent}%`;
            
            // Update carbs
            document.getElementById('carbsStatus').textContent = `${comparison.actual.carbs} / ${comparison.target.carbs}g`;
            const carbsPercent = Math.min(100, (comparison.actual.carbs / comparison.target.carbs) * 100);
            document.getElementById('carbsBar').style.width = `${carbsPercent}%`;
            
            // Update fats
            document.getElementById('fatsStatus').textContent = `${comparison.actual.fats} / ${comparison.target.fats}g`;
            const fatsPercent = Math.min(100, (comparison.actual.fats / comparison.target.fats) * 100);
            document.getElementById('fatsBar').style.width = `${fatsPercent}%`;
            
            document.getElementById('dietScore').textContent = `${comparison.scores.overall}%`;
            document.getElementById('dietMessage').textContent = comparison.insights[0] || 'Keep logging your meals!';
        }

