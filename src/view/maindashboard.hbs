        // Function to update weekly diet compliance
        function updateWeeklyDietCompliance() {
            // Calculate completed diet days in current week
            const today = new Date();
            const startOfWeek = new Date(today);
            startOfWeek.setDate(today.getDate() - today.getDay());
            
            let completedDays = 0;
            for (let i = 0; i < 7; i++) {
                const checkDate = new Date(startOfWeek);
                checkDate.setDate(startOfWeek.getDate() + i);
                const dateString = checkDate.toDateString();
                
                if (localStorage.getItem('dietCompleted_' + dateString) === 'true') {
                    completedDays++;
                }
            }
            
            // Calculate new compliance percentage
            const newCompliance = Math.round((completedDays / 7) * 100);
            
            // Update weekly diet score
            const weeklyDietScore = document.getElementById('weeklyDietScore');
            if (weeklyDietScore) {
                weeklyDietScore.textContent = newCompliance + '%';
            }
            
            // Update meal compliance
            const mealCompliance = document.getElementById('mealCompliance');
            if (mealCompliance) {
                mealCompliance.textContent = newCompliance + '%';
            }
            
            // Update diet progress bar
            const dietProgressBar = document.getElementById('dietProgressBar');
            if (dietProgressBar) {
                dietProgressBar.style.width = newCompliance + '%';
            }
        }
        
