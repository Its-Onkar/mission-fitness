        // Calculate progressive weekly progress (starts at 0, increases daily)
        function calculateWeeklyProgress() {
            // Get user's start date (when they first used the app)
            let startDate = localStorage.getItem('userStartDate');
            if (!startDate) {
                startDate = new Date().toDateString();
                localStorage.setItem('userStartDate', startDate);
            }
            
            const start = new Date(startDate);
            const today = new Date();
            const daysSinceStart = Math.floor((today - start) / (1000 * 60 * 60 * 24));
            
            // Count completed workouts since start
            let completedWorkouts = 0;
            for (let i = 0; i <= daysSinceStart; i++) {
                const checkDate = new Date(start);
                checkDate.setDate(start.getDate() + i);
                const dateString = checkDate.toDateString();
                
                if (localStorage.getItem('workoutCompleted_' + dateString) === 'true') {
                    completedWorkouts++;
                }
            }
            
            // Calculate progress: each completed workout = ~14.3% (100/7)
            const progressPerWorkout = 100 / 7;
            const currentProgress = Math.min(100, completedWorkouts * progressPerWorkout);
            
            return Math.round(currentProgress);
        }
        
        // Update workout progress displays
        function updateWorkoutProgress(percentage) {
            // Update workout score
            document.getElementById('workoutScore').textContent = percentage + '%';
            
            // Update duration based on progress (starts at 0, increases to 45)
            const maxDuration = 45;
            const currentDuration = Math.round((percentage / 100) * maxDuration);
            document.getElementById('durationStatus').textContent = `${currentDuration} / ${maxDuration} min`;
            document.getElementById('durationBar').style.width = percentage + '%';
            
            // Update workout ring (starts empty, fills progressively)
            const workoutRing = document.getElementById('workoutRing');
            if (workoutRing) {
                const circumference = 2 * Math.PI * 28;
                const offset = circumference - (percentage / 100) * circumference;
                workoutRing.style.strokeDashoffset = offset;
            }
            
            // Update weekly consistency (shows actual completed workouts)
            const completedWorkouts = Math.round((percentage / 100) * 7);
            document.getElementById('weeklyConsistency').textContent = `${completedWorkouts}/7`;
            
            // Update weekly progress dots
            updateWeeklyDots(completedWorkouts);
            
            // Update burned calories based on progress
            const maxCalories = 300;
            const burnedCalories = Math.round((percentage / 100) * maxCalories);
            document.getElementById('burnedCal').textContent = burnedCalories;
        }
        
        // Update weekly progress dots (shows actual completion pattern)
        function updateWeeklyDots(completedWorkouts) {
            const container = document.getElementById('weeklyProgress');
            if (!container) return;
            
            container.innerHTML = '';
            const days = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
            
            // Get actual completion status for each day
            const startDate = localStorage.getItem('userStartDate');
            const start = startDate ? new Date(startDate) : new Date();
            
            for (let i = 0; i < 7; i++) {
                const checkDate = new Date(start);
                checkDate.setDate(start.getDate() + i);
                const dateString = checkDate.toDateString();
                const isCompleted = localStorage.getItem('workoutCompleted_' + dateString) === 'true';
                
                const dayElement = document.createElement('div');
                dayElement.className = `w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold ${
                    isCompleted ? 'bg-green-500 text-white' : 'bg-gray-200 text-gray-500'
                }`;
                dayElement.textContent = days[i];
                container.appendChild(dayElement);
            }
        }
        
        // Calculate workout streak (consecutive days)
        function calculateWorkoutStreak() {
            const startDate = localStorage.getItem('userStartDate');
            if (!startDate) return 0;
            
            const start = new Date(startDate);
            const today = new Date();
            let streak = 0;
            
            // Count consecutive completed workouts from most recent
            for (let i = 0; i <= Math.floor((today - start) / (1000 * 60 * 60 * 24)); i++) {
                const checkDate = new Date(today);
                checkDate.setDate(today.getDate() - i);
                const dateString = checkDate.toDateString();
                
                if (localStorage.getItem('workoutCompleted_' + dateString) === 'true') {
                    streak++;
                } else {
                    break;
                }
            }
            
            return streak;
        }
        
        // Calculate hydration streak
        function calculateHydrationStreak() {
            const startDate = localStorage.getItem('userStartDate');
            if (!startDate) return 0;
            
            const start = new Date(startDate);
            const today = new Date();
            let streak = 0;
            
            // Count consecutive days with water intake
            for (let i = 0; i <= Math.floor((today - start) / (1000 * 60 * 60 * 24)); i++) {
                const checkDate = new Date(today);
                checkDate.setDate(today.getDate() - i);
                const dateString = checkDate.toDateString();
                
                if (localStorage.getItem('waterCompleted_' + dateString) === 'true') {
                    streak++;
                } else {
                    break;
                }
            }
            
            return streak;
        }
        
