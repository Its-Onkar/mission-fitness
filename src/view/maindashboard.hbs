        // Weekly Overview Functions
        function switchWeeklyView(period) {
            const currentBtn = document.getElementById('currentWeekBtn');
            const lastBtn = document.getElementById('lastWeekBtn');
            
            if (period === 'current') {
                currentBtn.className = 'px-3 py-1 bg-blue-100 text-blue-600 rounded-lg text-sm font-medium';
                lastBtn.className = 'px-3 py-1 bg-gray-100 text-gray-600 rounded-lg text-sm font-medium';
            } else {
                currentBtn.className = 'px-3 py-1 bg-gray-100 text-gray-600 rounded-lg text-sm font-medium';
                lastBtn.className = 'px-3 py-1 bg-blue-100 text-blue-600 rounded-lg text-sm font-medium';
            }
            
            loadWeeklyOverview(period);
        }
        
        async function loadWeeklyOverview(period = 'current') {
            const token = localStorage.getItem('token') || sessionStorage.getItem('token');
            
            try {
                // Calculate week dates
                const today = new Date();
                const startOfWeek = new Date(today);
                startOfWeek.setDate(today.getDate() - today.getDay());
                
                if (period === 'last') {
                    startOfWeek.setDate(startOfWeek.getDate() - 7);
                }
                
                // Generate weekly data
                const weeklyData = generateWeeklyData(startOfWeek);
                
                // Update UI with weekly data
                updateWeeklyOverviewUI(weeklyData);
                
                // Try to fetch real data from API
                try {
                    const response = await fetch('/api/analytics/weekly', {
                        headers: { 'Authorization': `Bearer ${token}` },
                        method: 'POST',
                        body: JSON.stringify({ period, startDate: startOfWeek.toISOString() }),
                        headers: { 
                            'Authorization': `Bearer ${token}`,
                            'Content-Type': 'application/json'
                        }
                    });
                    
                    if (response.ok) {
                        const apiData = await response.json();
                        updateWeeklyOverviewUI(apiData);
                    }
                } catch (apiError) {
                    console.log('Using generated data for weekly overview');
                }
                
            } catch (error) {
                console.error('Error loading weekly overview:', error);
            }
        }
        
        function generateWeeklyData(startOfWeek) {
            const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
            let totalWorkouts = 0;
            let totalCalories = 0;
            let totalSteps = 0;
            let dietCompliance = 0;
            let completedDays = 0;
            
            const dailyActivities = [];
            
            // Check each day of the week
            for (let i = 0; i < 7; i++) {
                const checkDate = new Date(startOfWeek);
                checkDate.setDate(startOfWeek.getDate() + i);
                const dateString = checkDate.toDateString();
                
                const workoutCompleted = localStorage.getItem('workoutCompleted_' + dateString) === 'true';
                const dietCompleted = localStorage.getItem('dietCompleted_' + dateString) === 'true';
                const activityCompleted = localStorage.getItem('activityCompleted_' + dateString) === 'true';
                
                if (workoutCompleted) {
                    totalWorkouts++;
                    totalCalories += 300; // Average calories per workout
                }
                
                if (dietCompleted) {
                    dietCompliance += 100;
                    completedDays++;
                }
                
                if (activityCompleted) {
                    totalCalories += 150; // Additional activity calories
                }
                
                // Generate daily steps (random but realistic)
                const dailySteps = Math.floor(Math.random() * 3000) + 5000;
                totalSteps += dailySteps;
                
                // Create daily activity entry
                const dayActivity = {
                    day: days[i],
                    date: checkDate.toLocaleDateString(),
                    workout: workoutCompleted,
                    diet: dietCompleted,
                    activity: activityCompleted,
                    steps: dailySteps,
                    calories: workoutCompleted ? 300 : 0
                };
                
                dailyActivities.push(dayActivity);
            }
            
            // Calculate averages and insights
            const avgDietCompliance = completedDays > 0 ? Math.round(dietCompliance / 7) : 0;
            const avgDailySteps = Math.round(totalSteps / 7);
            const avgDailyCals = Math.round(totalCalories / 7);
            
            // Generate insights
            const insights = generateWeeklyInsights(dailyActivities, totalWorkouts, avgDietCompliance);
            
            return {
                workouts: totalWorkouts,
                calories: totalCalories,
                steps: avgDailySteps,
                dietScore: avgDietCompliance,
                dailyActivities,
                insights,
                nutrition: {
                    avgDailyCals: avgDailyCals + 1800, // Add base metabolism
                    avgProtein: Math.round(totalWorkouts * 25 + 60), // Protein based on activity
                    avgHydration: Math.round((totalWorkouts * 0.5 + 2) * 10) / 10, // Hydration in liters
                    mealCompliance: avgDietCompliance
                }
            };
        }
        
        function generateWeeklyInsights(dailyActivities, totalWorkouts, dietCompliance) {
            // Find best performance day
            let bestDay = 'Monday';
            let bestScore = 0;
            
            dailyActivities.forEach(day => {
                const score = (day.workout ? 40 : 0) + (day.diet ? 30 : 0) + (day.activity ? 20 : 0) + (day.steps > 8000 ? 10 : 0);
                if (score > bestScore) {
                    bestScore = score;
                    bestDay = day.day;
                }
            });
            
            // Determine improvement area
            let improvementArea = 'Consistency';
            if (totalWorkouts < 3) {
                improvementArea = 'Workout frequency - aim for 4-5 sessions';
            } else if (dietCompliance < 70) {
                improvementArea = 'Diet tracking - log meals daily';
            } else {
                improvementArea = 'Great job! Focus on progressive overload';
            }
            
            // Streak status
            const currentStreak = calculateWorkoutStreak();
            let streakStatus = `${currentStreak} day workout streak`;
            if (currentStreak >= 7) {
                streakStatus += ' - Amazing consistency! 🔥';
            } else if (currentStreak >= 3) {
                streakStatus += ' - Keep it up! 💪';
            } else {
                streakStatus += ' - Build momentum daily';
            }
            
            // Achievement
            let achievement = 'Getting started!';
            if (totalWorkouts >= 6) {
                achievement = 'Workout Warrior - 6+ sessions! 🏆';
            } else if (totalWorkouts >= 4) {
                achievement = 'Consistency Champion - 4+ workouts! 🥇';
            } else if (totalWorkouts >= 2) {
                achievement = 'Progress Maker - 2+ sessions! 🌟';
            } else if (dietCompliance >= 80) {
                achievement = 'Nutrition Master - Great diet tracking! 🥗';
            }
            
            return {
                bestDay,
                improvementArea,
                streakStatus,
                achievement
            };
        }
        
        function updateWeeklyOverviewUI(data) {
            // Update main stats
            document.getElementById('weeklyWorkouts').textContent = data.workouts;
            document.getElementById('weeklyDietScore').textContent = data.dietScore + '%';
            document.getElementById('weeklyCals').textContent = data.calories;
            document.getElementById('weeklySteps').textContent = data.steps.toLocaleString();
            
            // Update progress bars
            const workoutProgress = Math.min(100, (data.workouts / 7) * 100);
            document.getElementById('workoutProgressBar').style.width = workoutProgress + '%';
            
            document.getElementById('dietProgressBar').style.width = data.dietScore + '%';
            
            const calorieProgress = Math.min(100, (data.calories / 2100) * 100); // Target 2100 calories/week
            document.getElementById('calorieProgressBar').style.width = calorieProgress + '%';
            
            const stepsProgress = Math.min(100, (data.steps / 10000) * 100); // Target 10k steps/day
            document.getElementById('stepsProgressBar').style.width = stepsProgress + '%';
            
            // Update daily activities
            const dailyList = document.getElementById('dailyActivityList');
            dailyList.innerHTML = '';
            
            data.dailyActivities.forEach(day => {
                const dayElement = document.createElement('div');
                dayElement.className = 'flex justify-between items-center p-2 bg-white rounded-lg border';
                
                const statusIcons = [
                    day.workout ? '💪' : '⭕',
                    day.diet ? '🥗' : '⭕',
                    day.activity ? '🚶' : '⭕'
                ].join(' ');
                
                dayElement.innerHTML = `
                    <div>
                        <span class="font-medium text-sm">${day.day}</span>
                        <span class="text-xs text-gray-500 ml-2">${day.date}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-sm">${statusIcons}</span>
                        <span class="text-xs text-gray-500">${day.steps.toLocaleString()} steps</span>
                    </div>
                `;
                
                dailyList.appendChild(dayElement);
            });
            
            // Update nutrition summary
            if (data.nutrition) {
                document.getElementById('avgDailyCals').textContent = data.nutrition.avgDailyCals + ' kcal';
                document.getElementById('avgProtein').textContent = data.nutrition.avgProtein + 'g';
                document.getElementById('avgHydration').textContent = data.nutrition.avgHydration + 'L';
                document.getElementById('mealCompliance').textContent = data.nutrition.mealCompliance + '%';
            }
            
            // Update insights
            if (data.insights) {
                document.getElementById('bestDay').textContent = data.insights.bestDay;
                document.getElementById('improvementArea').textContent = data.insights.improvementArea;
                document.getElementById('streakStatus').textContent = data.insights.streakStatus;
                document.getElementById('weeklyAchievement').textContent = data.insights.achievement;
            }
        }
        
