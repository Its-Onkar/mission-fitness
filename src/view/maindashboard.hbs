    <script>
        // Toast Notification Function
        function showToast(message, type = 'success', details = null) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            
            const icon = type === 'success' ? '✅' : type === 'error' ? '❌' : 'ℹ️';
            
            let content = `
                <div style="font-size: 24px;">${icon}</div>
                <div style="flex: 1;">
                    <div style="font-weight: 600; color: #2D3748; margin-bottom: 4px;">${message}</div>
            `;
            
            if (details) {
                content += `<div style="font-size: 13px; color: #718096;">${details}</div>`;
            }
            
            content += `</div>`;
            toast.innerHTML = content;
            
            container.appendChild(toast);
            
            // Auto remove after 4 seconds
            setTimeout(() => {
                toast.classList.add('removing');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        document.addEventListener('DOMContentLoaded', async () => {
            lucide.createIcons();
            attachEventListeners();
            
            // Priority: Server-rendered > URL Query > LocalStorage > SessionStorage
            const serverToken = "{{token}}";
            const urlParams = new URLSearchParams(window.location.search);
            const urlToken = urlParams.get('token');
            
            let token = serverToken || urlToken || localStorage.getItem('token') || sessionStorage.getItem('token');

            if (token) {
                // Ensure token is persisted
                if (token !== localStorage.getItem('token')) {
                    localStorage.setItem('token', token);
                }
            } else {
                window.location.href = '/login';
                return;
            }

            try {
                const response = await fetch('/api/dashboard-data', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (!response.ok) throw new Error('Failed to fetch data');
                
                const data = await response.json();
                
                console.log('Dashboard Data:', data);

                if (data.user && data.user.needsOnboarding) {
                    console.log('Redirecting to onboarding...');
                    window.location.href = '/onboarding';
                    return;
                }

                renderDashboard(data);
                
                // Load additional data
                loadDietProgress();
                
            } catch (error) {
                console.error('Error loading dashboard:', error);
                document.getElementById('loadingState').innerHTML = `
                    <div class="text-center text-red-500">
                        <p class="font-bold">Failed to load data</p>
                        <p class="text-sm">${error.message}</p>
                        <button onclick="window.location.reload()" class="mt-2 px-4 py-2 bg-red-100 rounded-lg text-sm">Retry</button>
                    </div>
                `;
            }
        });

        function renderDashboard(data) {
            document.getElementById('loadingState').classList.add('hidden');
            document.getElementById('section1').classList.remove('hidden');
            document.getElementById('mainGrid').classList.remove('hidden');

            document.getElementById('userName').textContent = data.user.name;
            document.getElementById('userEmail').textContent = data.user.email;
            if (data.user.avatar) {
                document.getElementById('userAvatar').src = data.user.avatar;
                document.getElementById('userAvatar').classList.remove('hidden');
                document.getElementById('userAvatarFallback').classList.add('hidden');
            }

            document.getElementById('readinessScore').textContent = data.summary.readinessScore;
            document.getElementById('aiMessage').textContent = data.summary.message;
            document.getElementById('sleepStatus').textContent = data.summary.status.sleep;
            document.getElementById('waterStatus').textContent = data.summary.status.water;
            document.getElementById('stepsStatus').textContent = data.summary.status.steps;
            
            const circle = document.getElementById('readinessRing');
            const radius = circle.r.baseVal.value;
            const circumference = radius * 2 * Math.PI;
            const offset = circumference - (data.summary.readinessScore / 100) * circumference;
            circle.style.strokeDashoffset = offset;

            // Use onboarding weight data first, then load real weight updates
            document.getElementById('currentWeight').textContent = `${data.weight.current} kg`;
            document.getElementById('prevWeight').textContent = `${data.weight.previous} kg`;
            document.getElementById('weightDiff').innerHTML = `<span class="${data.weight.trend === 'gained' ? 'text-red-500' : data.weight.trend === 'lost' ? 'text-green-500' : 'text-gray-500'}">${data.weight.diff}</span>`;
            document.getElementById('totalLost').textContent = data.weight.totalLost;
            document.getElementById('weightComment').textContent = data.weight.comment;
            
            // Load any additional weight updates
            loadWeightData();

            // Update diet consistency and macros
            document.getElementById('dietScore').textContent = `${data.diet.consistencyScore}%`;
            
            // Calories
            document.getElementById('calStatus').textContent = `${data.diet.caloriesEaten} / ${data.diet.caloriesTarget}`;
            const calPercent = Math.min(100, (data.diet.caloriesEaten / data.diet.caloriesTarget) * 100);
            document.getElementById('calBar').style.width = `${calPercent}%`;
            
            // Protein
            document.getElementById('proteinStatus').textContent = `${data.diet.proteinEaten} / ${data.diet.proteinTarget}g`;
            const proteinPercent = Math.min(100, (data.diet.proteinEaten / data.diet.proteinTarget) * 100);
            document.getElementById('proteinBar').style.width = `${proteinPercent}%`;
            
            // Carbs
            document.getElementById('carbsStatus').textContent = `${data.diet.carbsEaten} / ${data.diet.carbsTarget}g`;
            const carbsPercent = Math.min(100, (data.diet.carbsEaten / data.diet.carbsTarget) * 100);
            document.getElementById('carbsBar').style.width = `${carbsPercent}%`;
            
            // Fats
            document.getElementById('fatsStatus').textContent = `${data.diet.fatsEaten} / ${data.diet.fatsTarget}g`;
            const fatsPercent = Math.min(100, (data.diet.fatsEaten / data.diet.fatsTarget) * 100);
            document.getElementById('fatsBar').style.width = `${fatsPercent}%`;
            
            // AI Diet Plan
            if (data.diet.todaysPlan) {
                const getMealText = (meal) => {
                    if (!meal) return 'Not scheduled';
                    if (typeof meal === 'string') return meal;
                    return `${meal.item} (${meal.calories} kcal)`;
                };

                document.getElementById('aiBreakfast').textContent = getMealText(data.diet.todaysPlan.breakfast);
                document.getElementById('aiLunch').textContent = getMealText(data.diet.todaysPlan.lunch);
                document.getElementById('aiDinner').textContent = getMealText(data.diet.todaysPlan.dinner);
                document.getElementById('aiSnacks').textContent = getMealText(data.diet.todaysPlan.snack1 || data.diet.todaysPlan.snacks);
            }
            
            document.getElementById('dietMessage').textContent = data.diet.message;

            // Animate diet ring
            const dietRing = document.getElementById('dietRing');
            const dietRadius = dietRing.r.baseVal.value;
            const dietCircumference = dietRadius * 2 * Math.PI;
            const dietOffset = dietCircumference - (data.diet.consistencyScore / 100) * dietCircumference;
            dietRing.style.strokeDashoffset = dietOffset;

            // Update workout consistency
            document.getElementById('workoutScore').textContent = `${data.workout.consistencyScore}%`;
            document.getElementById('burnedCal').textContent = data.workout.caloriesBurned;
            
            // Duration tracking
            const completedMin = parseInt(data.workout.completedDuration) || 0;
            const plannedMin = parseInt(data.workout.plannedDuration) || 45;
            document.getElementById('durationStatus').textContent = `${completedMin} / ${plannedMin} min`;
            const durationPercent = Math.min(100, (completedMin / plannedMin) * 100);
            document.getElementById('durationBar').style.width = `${durationPercent}%`;
            
            // Today's workout status
            updateWorkoutStatus(data.workout.todaysStatus);
            
            // Weekly consistency
            if (data.workout.weeklyStats) {
                document.getElementById('weeklyConsistency').textContent = 
                    `${data.workout.weeklyStats.completed}/${data.workout.weeklyStats.planned}`;
                renderWeeklyProgress(data.workout.weeklyProgress);
            }
            
            document.getElementById('workoutMessage').textContent = data.workout.message;

            // Animate workout ring
            const workoutRing = document.getElementById('workoutRing');
            const workoutRadius = workoutRing.r.baseVal.value;
            const workoutCircumference = workoutRadius * 2 * Math.PI;
            const workoutOffset = workoutCircumference - (data.workout.consistencyScore / 100) * workoutCircumference;
            workoutRing.style.strokeDashoffset = workoutOffset;

            if (data.dailyPlan && data.dailyPlan.workout) {
                const w = data.dailyPlan.workout;
                document.getElementById('workoutFocus').textContent = `Focus: ${w.intensity} Intensity`;
                document.getElementById('workoutIntensity').textContent = w.intensity;
                
                renderList('warmupList', w.warmup);
