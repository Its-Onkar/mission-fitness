            const calPercent = Math.min(100, (caloriesEaten / caloriesTarget) * 100);
            document.getElementById('calBar').style.width = `${calPercent}%`;
            
            // Protein with realistic data
            const proteinEaten = data.diet?.proteinEaten || 80;
            const proteinTarget = data.diet?.proteinTarget || 120;
            document.getElementById('proteinStatus').textContent = `${proteinEaten} / ${proteinTarget}g`;
            const proteinPercent = Math.min(100, (proteinEaten / proteinTarget) * 100);
            document.getElementById('proteinBar').style.width = `${proteinPercent}%`;
            
            // Carbs with realistic data
            const carbsEaten = data.diet?.carbsEaten || 150;
            const carbsTarget = data.diet?.carbsTarget || 200;
            document.getElementById('carbsStatus').textContent = `${carbsEaten} / ${carbsTarget}g`;
