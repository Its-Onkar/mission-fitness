            await logWeightToBackend(weight, notes);
            closeWeightModal();
        }

        async function logWeightToBackend(weight, notes = '') {
            const token = localStorage.getItem('token') || sessionStorage.getItem('token');
            try {
                const response = await fetch('/api/weight/log', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ weight, notes })
                });

                if (response.ok) {
                    const result = await response.json();
                    showToast('Weight Logged!', 'success', `${weight} kg logged successfully`);
                    
                    // Reload weight data to update UI
                    setTimeout(() => {
                        loadWeightData();
                        window.location.reload();
                    }, 1000);
                } else {
                    const errorText = await response.text();
                    console.error('Weight log error:', errorText);
                    showToast('Failed to log weight', 'error', 'Check your connection and try again');
                }
            } catch (error) {
                console.error('Error logging weight:', error);
                showToast('Failed to log weight', 'error', 'Network error - please try again');
            }
        }

