    <script>
        // Toast Notification Function
        function showToast(message, type = 'success', details = null) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            
            const icon = type === 'success' ? '✅' : type === 'error' ? '❌' : 'ℹ️';
            
            let content = `
                <div style="font-size: 24px;">${icon}</div>
                <div style="flex: 1;">
                    <div style="font-weight: 600; color: #2D3748; margin-bottom: 4px;">${message}</div>
            `;
            
            if (details) {
                content += `<div style="font-size: 13px; color: #718096;">${details}</div>`;
            }
            
            content += `</div>`;
            toast.innerHTML = content;
            
            container.appendChild(toast);
            
            // Auto remove after 4 seconds
            setTimeout(() => {
                toast.classList.add('removing');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        document.addEventListener('DOMContentLoaded', async () => {
            lucide.createIcons();
            attachEventListeners();
            
            // Priority: Server-rendered > URL Query > LocalStorage > SessionStorage
            const serverToken = "{{token}}";
            const urlParams = new URLSearchParams(window.location.search);
            const urlToken = urlParams.get('token');
            
            let token = serverToken || urlToken || localStorage.getItem('token') || sessionStorage.getItem('token');

            if (token) {
                // Ensure token is persisted
                if (token !== localStorage.getItem('token')) {
                    localStorage.setItem('token', token);
                }
            } else {
                window.location.href = '/login';
                return;
            }

            try {
                const response = await fetch('/api/dashboard-data', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (!response.ok) throw new Error('Failed to fetch data');
                
                const data = await response.json();
                
                console.log('Dashboard Data:', data);

                if (data.user && data.user.needsOnboarding) {
                    console.log('Redirecting to onboarding...');
                    window.location.href = '/onboarding';
