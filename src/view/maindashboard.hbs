        function updateWorkoutStatus(status) {
            const statusElement = document.getElementById('todayWorkoutStatus');
            const dotElement = document.getElementById('statusDot');
            const labelElement = document.getElementById('statusLabel');
            const statusText = document.getElementById('statusText');
            
            switch(status) {
                case 'completed':
                    statusElement.className = 'flex items-center justify-between mb-4 p-3 rounded-lg bg-green-50 border border-green-200';
                    dotElement.className = 'w-3 h-3 rounded-full bg-green-500';
                    labelElement.textContent = 'COMPLETED';
                    labelElement.className = 'text-sm font-bold text-green-700';
                    if (statusText) statusText.textContent = "Today's Workout";
                    break;
                case 'skipped':
                    statusElement.className = 'flex items-center justify-between mb-4 p-3 rounded-lg bg-red-50 border border-red-200';
                    dotElement.className = 'w-3 h-3 rounded-full bg-red-500';
                    labelElement.textContent = 'SKIPPED';
                    labelElement.className = 'text-sm font-bold text-red-700';
                    if (statusText) statusText.textContent = "Today's Workout";
                    break;
                default: // pending
                    statusElement.className = 'flex items-center justify-between mb-4 p-3 rounded-lg bg-orange-50 border border-orange-200';
                    dotElement.className = 'w-3 h-3 rounded-full bg-orange-500';
                    labelElement.textContent = 'PENDING';
                    labelElement.className = 'text-sm font-bold text-orange-700';
                    if (statusText) statusText.textContent = "Today's Workout";
            }
        }
        
        function renderWeeklyProgress(weeklyData) {
            const container = document.getElementById('weeklyProgress');
            container.innerHTML = '';
            
            const days = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
            
            weeklyData.forEach((completed, index) => {
                const dayElement = document.createElement('div');
                dayElement.className = `w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold ${
                    completed ? 'bg-green-500 text-white' : 'bg-gray-200 text-gray-500'
                }`;
                dayElement.textContent = days[index];
                container.appendChild(dayElement);
            });
        }
        
