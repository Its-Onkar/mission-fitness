            document.getElementById('statusText').textContent = goalData.aiInsight.text;
            document.getElementById('statusDetail').textContent = goalData.aiInsight.detail;
            
            // Generate mini chart
            generateWeightChart(goalData);
        }
        
        function generateWeightChart(goalData) {
            const chartContainer = document.getElementById('miniChart');
            chartContainer.innerHTML = '';
            
            // Generate 7 days of weight data (simulated for demo)
            const days = 7;
            const baseWeight = goalData.currentWeight;
            const variation = goalData.goal === 'weight_maintenance' ? 0.3 : 0.5;
            
            for (let i = 0; i < days; i++) {
                const dayWeight = baseWeight + (Math.random() - 0.5) * variation;
                const normalizedHeight = Math.max(10, Math.min(90, ((dayWeight - baseWeight + 2) / 4) * 100));
                
                const bar = document.createElement('div');
                bar.className = 'w-2 bg-blue-400 rounded-t opacity-70';
                bar.style.height = `${normalizedHeight}%`;
                bar.title = `Day ${i + 1}: ${dayWeight.toFixed(1)}kg`;
                
                chartContainer.appendChild(bar);
            }
        }
