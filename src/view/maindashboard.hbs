        async function loadWeightData() {
            const token = localStorage.getItem('token') || sessionStorage.getItem('token');
            try {
                const response = await fetch('/api/weight/progress', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (response.ok) {
                    const progress = await response.json();
                    
                    document.getElementById('currentWeight').textContent = `${progress.current || 0} kg`;
                    document.getElementById('prevWeight').textContent = `${progress.previous || 0} kg`;
                    
                    const diff = progress.difference || 0;
                    const trendIcon = diff > 0 ? '↑' : diff < 0 ? '↓' : '→';
                    const trendColor = diff > 0 ? 'text-red-500' : diff < 0 ? 'text-green-500' : 'text-gray-500';
                    
                    document.getElementById('weightDiff').innerHTML = `<span class="${trendColor}">${trendIcon} ${Math.abs(diff).toFixed(1)} kg</span>`;
                    document.getElementById('totalLost').textContent = `${Math.abs(progress.totalProgress || 0).toFixed(1)} kg`;
                    
                    const comments = {
                        'gained': 'Weight increased - stay consistent!',
                        'lost': 'Great progress! Keep it up!',
                        'stable': 'Weight is stable - good maintenance!'
                    };
                    document.getElementById('weightComment').textContent = comments[progress.trend] || 'Keep tracking!';
                }
            } catch (error) {
                console.error('Error loading weight data:', error);
            }
        }

