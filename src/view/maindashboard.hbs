<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Dashboard | Mission Fitness</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #FF6B35;
            --secondary: #2D3748;
            --glass-bg: rgba(255, 255, 255, 0.95);
        }
        body { font-family: 'Outfit', sans-serif; background-color: #F7FAFC; }
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(226, 232, 240, 0.8);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s ease;
        }
        .glass-card:hover { transform: translateY(-2px); }
        .neon-border { border: 1px solid rgba(255, 107, 53, 0.3); box-shadow: 0 0 10px rgba(255, 107, 53, 0.1); }
        .progress-ring-circle { transition: stroke-dashoffset 0.35s; transform: rotate(-90deg); transform-origin: 50% 50%; }
        
        /* Toast Notifications */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .toast {
            background: white;
            border-radius: 12px;
            padding: 16px 20px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 320px;
            animation: slideIn 0.3s ease-out;
            border-left: 4px solid;
        }
        .toast.success { border-left-color: #48BB78; }
        .toast.error { border-left-color: #F56565; }
        .toast.info { border-left-color: #4299E1; }
        @keyframes slideIn {
            from { transform: translateX(400px); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes slideOut {
            from { transform: translateX(0); opacity: 1; }
            to { transform: translateX(400px); opacity: 0; }
        }
        .toast.removing { animation: slideOut 0.3s ease-in forwards; }
    </style>
</head>
<body class="flex h-screen bg-gray-50 text-gray-900">

    <!-- Toast Notification Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Sidebar (Simplified) -->
    <aside class="w-64 bg-white border-r border-gray-200 hidden lg:flex flex-col h-full">
        <div class="p-6 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-orange-100 flex items-center justify-center text-orange-600">
                <i data-lucide="dumbbell" class="w-6 h-6"></i>
            </div>
            <span class="text-xl font-bold">Mission<span class="text-orange-500">Fitness</span></span>
        </div>
        <nav class="flex-1 px-4 space-y-2 py-4">
            <a href="#dashboard" onclick="showSection('dashboard')" class="nav-link flex items-center gap-3 px-4 py-3 bg-orange-50 text-orange-600 rounded-xl font-medium" data-section="dashboard">
                <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Dashboard
            </a>
            <a href="#workouts" onclick="showSection('workouts')" class="nav-link flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium" data-section="workouts">
                <i data-lucide="dumbbell" class="w-5 h-5"></i> Workouts
            </a>
            <a href="#diet" onclick="showSection('diet')" class="nav-link flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium" data-section="diet">
                <i data-lucide="utensils" class="w-5 h-5"></i> Diet & Nutrition
            </a>
            <a href="#progress" onclick="showSection('progress')" class="nav-link flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium" data-section="progress">
                <i data-lucide="trending-up" class="w-5 h-5"></i> Progress
            </a>
            <a href="#analytics" onclick="showSection('analytics')" class="nav-link flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium" data-section="analytics">
                <i data-lucide="bar-chart-3" class="w-5 h-5"></i> Analytics
            </a>
            <a href="#ai-coach" onclick="showSection('ai-coach')" class="nav-link flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium" data-section="ai-coach">
                <i data-lucide="bot" class="w-5 h-5"></i> AI Coach
            </a>
            <a href="/onboarding" class="flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium">
                <i data-lucide="settings" class="w-5 h-5"></i> Onboarding
            </a>
            <a href="/ai-plans" class="flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium">
                <i data-lucide="brain" class="w-5 h-5"></i> AI Plans
            </a>
            <a href="/profile" class="flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium">
                <i data-lucide="user" class="w-5 h-5"></i> Profile
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-full overflow-hidden">
        <header class="bg-white/80 backdrop-blur-md border-b border-gray-200 px-6 py-4 flex justify-between items-center sticky top-0 z-30">
            <h1 class="text-2xl font-bold">AI Dashboard</h1>
            <div class="flex items-center gap-4">
                <div class="text-sm text-right hidden sm:block">
                    <p class="font-bold text-gray-900" id="userName">Loading...</p>
                    <p class="text-xs text-gray-500" id="userEmail">...</p>
                </div>
                <div class="w-10 h-10 rounded-full bg-gray-200 overflow-hidden">
                    <img id="userAvatar" src="" alt="User" class="w-full h-full object-cover hidden">
                    <div id="userAvatarFallback" class="w-full h-full flex items-center justify-center text-gray-500">
                        <i data-lucide="user" class="w-5 h-5"></i>
                    </div>
                </div>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-6 space-y-6" id="dashboardContent">
            <!-- Loading State -->
            <div id="loadingState" class="flex items-center justify-center h-64">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-orange-500"></div>
            </div>

            <!-- 1. AI Daily Summary Card -->
            <div id="section1" class="glass-card rounded-2xl p-6 bg-gradient-to-r from-orange-50 to-white hidden">
                <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                    <div class="flex-1">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="px-2 py-1 bg-orange-100 text-orange-600 text-xs font-bold rounded-full">AI INSIGHT</span>
                            <span class="text-sm text-gray-500" id="currentDate">Today</span>
                        </div>
                        <h2 class="text-2xl font-bold text-gray-900 mb-2" id="aiMessage">Analyzing your data...</h2>
                        <div class="flex gap-4 mt-4">
                            <div class="flex items-center gap-2 text-sm text-gray-600">
                                <i data-lucide="moon" class="w-4 h-4 text-purple-500"></i> <span id="sleepStatus">--</span>
                            </div>
                            <div class="flex items-center gap-2 text-sm text-gray-600">
                                <i data-lucide="droplets" class="w-4 h-4 text-blue-500"></i> <span id="waterStatus">--</span>
                            </div>
                            <div class="flex items-center gap-2 text-sm text-gray-600">
                                <i data-lucide="footprints" class="w-4 h-4 text-green-500"></i> <span id="stepsStatus">--</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-6">
                        <div class="relative w-24 h-24 flex items-center justify-center">
                            <svg class="w-full h-full transform -rotate-90">
                                <circle cx="48" cy="48" r="40" stroke="#E2E8F0" stroke-width="8" fill="transparent"/>
                                <circle id="readinessRing" cx="48" cy="48" r="40" stroke="#FF6B35" stroke-width="8" fill="transparent" stroke-dasharray="251.2" stroke-dashoffset="251.2" class="progress-ring-circle"/>
                            </svg>
                            <div class="absolute text-center">
                                <span class="text-2xl font-bold text-gray-900" id="readinessScore">0</span>
                                <span class="block text-xs text-gray-500">Readiness</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-6 flex gap-3 border-t border-gray-100 pt-4">
                    <button id="startWorkoutBtn" class="flex-1 py-2 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">Start Workout</button>
                    <button id="logMealBtn" class="flex-1 py-2 bg-white border border-gray-200 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-pointer">Complete Diet</button>
                    <button id="addWeightBtn" class="flex-1 py-2 bg-white border border-gray-200 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">Add Weight</button>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 hidden" id="mainGrid">
                
                <!-- 2. AI Goal-Based Weight Progress -->
                <div class="glass-card rounded-2xl p-6">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-lg font-bold flex items-center gap-2"><i data-lucide="scale" class="w-5 h-5 text-blue-500"></i> Weight Progress</h3>
                        <span class="px-2 py-1 text-xs font-bold rounded-full" id="goalStatus">ON TRACK</span>
                    </div>
                    
                    <!-- Current vs Target -->
                    <div class="flex justify-between items-end mb-3">
                        <div>
                            <p class="text-3xl font-bold text-gray-900" id="currentWeight">-- kg</p>
                            <p class="text-sm text-gray-500" id="goalType">Goal: --</p>
                        </div>
                        <div class="text-right">
                            <p class="text-lg font-bold flex items-center justify-end" id="weightProgress">--</p>
                            <p class="text-xs text-gray-400" id="progressLabel">Progress</p>
                        </div>
                    </div>
                    
                    <!-- Progress Bar -->
                    <div class="mb-3">
                        <div class="flex justify-between text-xs text-gray-500 mb-1">
                            <span id="startWeight">-- kg</span>
                            <span id="targetWeight">-- kg</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div id="weightProgressBar" class="h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
                        </div>
                    </div>
                    
                    <!-- Weekly Status -->
                    <div class="p-3 rounded-xl text-sm" id="weeklyStatus">
                        <div class="flex items-center gap-2 mb-1">
                            <span id="statusIcon">📊</span>
                            <span class="font-medium" id="statusText">Analyzing progress...</span>
                        </div>
                        <p class="text-xs opacity-75" id="statusDetail">Track daily for better insights</p>
                    </div>
                    
                    <!-- Mini Chart -->
                    <div class="mt-3 h-16 bg-gray-50 rounded-lg flex items-end justify-between px-2 py-1" id="miniChart">
                        <!-- Chart bars will be generated here -->
                    </div>
                </div>

                <!-- 3. Diet Consistency with AI Plan -->
                <div class="glass-card rounded-2xl p-6 lg:col-span-2">
                    <h3 class="text-lg font-bold mb-4 flex items-center gap-2"><i data-lucide="utensils" class="w-5 h-5 text-green-500"></i> AI Diet Plan & Progress</h3>
                    
                    <!-- Progress Ring and Macros -->
                    <div class="flex justify-between items-start mb-4">
                        <div class="relative w-20 h-20">
                            <svg class="w-full h-full transform -rotate-90">
                                <circle cx="40" cy="40" r="35" stroke="#E2E8F0" stroke-width="8" fill="transparent"/>
                                <circle id="dietRing" cx="40" cy="40" r="35" stroke="#48BB78" stroke-width="8" fill="transparent" stroke-dasharray="219.9" stroke-dashoffset="219.9" class="progress-ring-circle"/>
                            </svg>
                            <span class="absolute inset-0 flex items-center justify-center text-lg font-bold" id="dietScore">0%</span>
                        </div>
                        
                        <!-- Macro Tracking -->
                        <div class="flex-1 ml-6 grid grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <div class="flex justify-between text-sm">
                                    <span class="text-gray-500">Calories</span>
                                    <span class="font-medium" id="calStatus">0 / 0</span>
                                </div>
                                <div class="w-full bg-gray-100 rounded-full h-2">
                                    <div id="calBar" class="bg-green-500 h-2 rounded-full" style="width: 0%"></div>
                                </div>
                                
                                <div class="flex justify-between text-sm">
                                    <span class="text-gray-500">Protein</span>
                                    <span class="font-medium" id="proteinStatus">0 / 0g</span>
                                </div>
                                <div class="w-full bg-gray-100 rounded-full h-2">
                                    <div id="proteinBar" class="bg-blue-500 h-2 rounded-full" style="width: 0%"></div>
                                </div>
                            </div>
                            
                            <div class="space-y-2">
                                <div class="flex justify-between text-sm">
                                    <span class="text-gray-500">Carbs</span>
                                    <span class="font-medium" id="carbsStatus">0 / 0g</span>
                                </div>
                                <div class="w-full bg-gray-100 rounded-full h-2">
                                    <div id="carbsBar" class="bg-yellow-500 h-2 rounded-full" style="width: 0%"></div>
                                </div>
                                
                                <div class="flex justify-between text-sm">
                                    <span class="text-gray-500">Fats</span>
                                    <span class="font-medium" id="fatsStatus">0 / 0g</span>
                                </div>
                                <div class="w-full bg-gray-100 rounded-full h-2">
                                    <div id="fatsBar" class="bg-purple-500 h-2 rounded-full" style="width: 0%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- AI Diet Plan for Today -->
                    <div class="bg-green-50 rounded-xl p-4 mb-4">
                        <h4 class="font-bold text-green-800 mb-3 flex items-center gap-2">
                            <i data-lucide="sparkles" class="w-4 h-4"></i> Today's AI Diet Plan
                        </h4>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                            <div class="space-y-2">
                                <div class="flex items-start gap-2">
                                    <span class="text-orange-600 font-medium">🌅 Breakfast:</span>
                                    <span class="text-gray-700" id="aiBreakfast">Loading...</span>
                                </div>
                                <div class="flex items-start gap-2">
                                    <span class="text-blue-600 font-medium">🍽️ Lunch:</span>
                                    <span class="text-gray-700" id="aiLunch">Loading...</span>
                                </div>
                            </div>
                            <div class="space-y-2">
                                <div class="flex items-start gap-2">
                                    <span class="text-purple-600 font-medium">🌙 Dinner:</span>
                                    <span class="text-gray-700" id="aiDinner">Loading...</span>
                                </div>
                                <div class="flex items-start gap-2">
                                    <span class="text-green-600 font-medium">🥜 Snacks:</span>
                                    <span class="text-gray-700" id="aiSnacks">Loading...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex gap-3">
                        <button id="logCaloriesBtn" class="flex-1 py-2 bg-green-500 text-white rounded-lg text-sm font-medium hover:bg-green-600 transition">Complete Diet</button>
                        <button onclick="generateNewDietPlan()" class="px-4 py-2 bg-green-100 text-green-700 rounded-lg text-sm font-medium hover:bg-green-200 transition">New Plan</button>
                    </div>
                    
                    <p class="text-xs text-gray-500 mt-3" id="dietMessage">Follow your AI plan for best results!</p>
                </div>

                <!-- 4. Workout Consistency -->
                <div class="glass-card rounded-2xl p-6">
                    <h3 class="text-lg font-bold mb-4 flex items-center gap-2"><i data-lucide="activity" class="w-5 h-5 text-red-500"></i> Workout Consistency</h3>
                    
                    <!-- Today's Status -->
                    <div class="flex items-center justify-between mb-4 p-3 rounded-lg" id="todayWorkoutStatus">
                        <div class="flex items-center gap-3">
                            <div class="w-3 h-3 rounded-full" id="statusDot"></div>
                            <span class="font-medium" id="statusText">Today's Workout</span>
                        </div>
                        <span class="text-sm font-bold" id="statusLabel">PENDING</span>
                    </div>
                    
                    <div class="flex justify-between items-center mb-4">
                        <div class="relative w-16 h-16">
                            <svg class="w-full h-full transform -rotate-90">
                                <circle cx="32" cy="32" r="28" stroke="#E2E8F0" stroke-width="6" fill="transparent"/>
                                <circle id="workoutRing" cx="32" cy="32" r="28" stroke="#F56565" stroke-width="6" fill="transparent" stroke-dasharray="175.9" stroke-dashoffset="175.9" class="progress-ring-circle"/>
                            </svg>
                            <span class="absolute inset-0 flex items-center justify-center text-sm font-bold" id="workoutScore">0%</span>
                        </div>
                        <div class="flex-1 ml-4 space-y-1">
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-500">Duration</span>
                                <span class="font-medium" id="durationStatus">0 / 0 min</span>
                            </div>
                            <div class="w-full bg-gray-100 rounded-full h-2">
                                <div id="durationBar" class="bg-red-500 h-2 rounded-full" style="width: 0%"></div>
                            </div>
                            <p class="text-xs text-gray-600">Burned: <span class="font-bold" id="burnedCal">0</span> kcal</p>
                        </div>
                    </div>
                    
                    <!-- Weekly Progress -->
                    <div class="mb-4">
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-sm font-medium text-gray-700">This Week</span>
                            <span class="text-sm font-bold" id="weeklyConsistency">0/0</span>
                        </div>
                        <div class="flex gap-1" id="weeklyProgress">
                            <!-- 7 day dots will be inserted here -->
                        </div>
                    </div>
                    
                    <p class="text-xs text-gray-500" id="workoutMessage">Stay consistent!</p>
                </div>

                <!-- 5. Today's AI Workout Plan (Full Width) -->
                <div class="glass-card rounded-2xl p-6 lg:col-span-2 border-l-4 border-orange-500">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h3 class="text-lg font-bold text-gray-900">Today's AI Workout</h3>
                            <p class="text-sm text-gray-500" id="workoutFocus">Focus: Full Body</p>
                        </div>
                        <span class="px-3 py-1 bg-orange-100 text-orange-600 text-xs font-bold rounded-full" id="workoutIntensity">Medium</span>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                        <div class="p-3 bg-gray-50 rounded-xl">
                            <p class="text-xs text-gray-500 uppercase font-bold mb-2">Warmup</p>
                            <ul class="text-sm space-y-1 text-gray-700" id="warmupList">
                                <li>Loading...</li>
                            </ul>
                        </div>
                        <div class="p-3 bg-orange-50 rounded-xl border border-orange-100">
                            <p class="text-xs text-orange-600 uppercase font-bold mb-2">Main Workout</p>
                            <ul class="text-sm space-y-1 text-gray-900 font-medium" id="mainList">
                                <li>Loading...</li>
                            </ul>
                        </div>
                        <div class="p-3 bg-gray-50 rounded-xl">
                            <p class="text-xs text-gray-500 uppercase font-bold mb-2">Cooldown</p>
                            <ul class="text-sm space-y-1 text-gray-700" id="cooldownList">
                                <li>Loading...</li>
                            </ul>
                        </div>
                    </div>
                    <div class="flex justify-between items-center">
                        <p class="text-sm text-gray-500 italic" id="workoutTips">"Stay hydrated!"</p>
                        <button id="startWorkoutNowBtn" class="px-4 py-2 bg-orange-500 text-white rounded-lg text-sm font-medium hover:bg-orange-600 shadow-lg shadow-orange-200">Start Now</button>
                    </div>
                </div>

                <!-- 6. Today's AI Activity Suggestion -->
                <div class="glass-card rounded-2xl p-6 bg-gradient-to-br from-teal-50 to-white">
                    <h3 class="text-lg font-bold text-teal-900 mb-4">Active Recovery</h3>
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-12 h-12 rounded-full bg-teal-100 flex items-center justify-center text-teal-600">
                            <i data-lucide="bike" class="w-6 h-6" id="activityIcon"></i>
                        </div>
                        <div>
                            <p class="font-bold text-gray-900" id="activityType">Cycling</p>
                            <p class="text-sm text-gray-500" id="activityGoal">30 mins • 150 kcal</p>
                        </div>
                    </div>
                    <p class="text-sm text-gray-600 italic mb-4">"<span id="activityQuote">Motion is lotion.</span>"</p>
                    <button id="markActivityCompleteBtn" class="w-full py-2 border border-teal-200 text-teal-700 rounded-lg text-sm font-medium hover:bg-teal-50">Mark Complete</button>
                </div>

                <!-- 7. Comprehensive Weekly Overview -->
                <div class="glass-card rounded-2xl p-6 lg:col-span-3 border-l-4 border-blue-500">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-xl font-bold text-gray-900">📊 Weekly Overview</h3>
                        <div class="flex gap-2">
                            <button onclick="switchWeeklyView('current')" id="currentWeekBtn" class="px-3 py-1 bg-blue-100 text-blue-600 rounded-lg text-sm font-medium">This Week</button>
                            <button onclick="switchWeeklyView('last')" id="lastWeekBtn" class="px-3 py-1 bg-gray-100 text-gray-600 rounded-lg text-sm font-medium">Last Week</button>
                        </div>
                    </div>
                    
                    <!-- Weekly Stats Grid -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                        <div class="bg-gradient-to-r from-orange-50 to-orange-100 p-4 rounded-xl border border-orange-200">
                            <div class="flex items-center gap-2 mb-2">
                                <i data-lucide="activity" class="w-4 h-4 text-orange-600"></i>
                                <span class="text-xs font-bold text-orange-600 uppercase">Workouts</span>
                            </div>
                            <p class="text-2xl font-bold text-gray-900" id="weeklyWorkouts">0</p>
                            <p class="text-xs text-gray-500">of 7 planned</p>
                            <div class="mt-2 w-full bg-orange-200 rounded-full h-2">
                                <div id="workoutProgressBar" class="bg-orange-500 h-2 rounded-full" style="width: 0%"></div>
                            </div>
                        </div>
                        
                        <div class="bg-gradient-to-r from-green-50 to-green-100 p-4 rounded-xl border border-green-200">
                            <div class="flex items-center gap-2 mb-2">
                                <i data-lucide="utensils" class="w-4 h-4 text-green-600"></i>
                                <span class="text-xs font-bold text-green-600 uppercase">Diet</span>
                            </div>
                            <p class="text-2xl font-bold text-gray-900" id="weeklyDietScore">0%</p>
