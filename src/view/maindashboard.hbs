                const userResponse = await fetch('/api/onboarding/' + (window.currentUserId || 'me'), {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (userResponse.ok) {
                    const userData = await userResponse.json();
                    if (userData.dietPreference) {
                        userDietPreference = userData.dietPreference;
                        window.currentUserId = userData._id;
                    }
                }
                
                // Load AI plans from fitness API
                const plansResponse = await fetch('/api/fitness/plans', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (plansResponse.ok) {
                    const plansData = await plansResponse.json();
                    if (plansData.success && plansData.plans && plansData.plans.dailyPlan) {
                        const dailyPlan = plansData.plans.dailyPlan;
                        
                        // Update AI diet plan display
                        if (dailyPlan.diet && dailyPlan.diet.meals) {
                            const getMealText = (meal) => {
                                if (!meal) return 'Not scheduled';
                                if (typeof meal === 'string') return meal;
                                return meal.item || meal.original || meal;
                            };
                            
                            document.getElementById('aiBreakfast').textContent = getMealText(dailyPlan.diet.meals.breakfast);
                            document.getElementById('aiLunch').textContent = getMealText(dailyPlan.diet.meals.lunch);
                            document.getElementById('aiDinner').textContent = getMealText(dailyPlan.diet.meals.dinner);
                            document.getElementById('aiSnacks').textContent = getMealText(dailyPlan.diet.meals.snack1 || dailyPlan.diet.meals.snacks);
                        }
                        
                        // Update AI workout plan display with daily rotation
                        if (dailyPlan.workout && dailyPlan.workout.main) {
                            const mainList = document.getElementById('mainList');
                            if (mainList) {
                                mainList.innerHTML = '';
                                dailyPlan.workout.main.forEach(exercise => {
                                    const li = document.createElement('li');
                                    li.innerHTML = `<strong>${exercise.name}</strong> - ${exercise.sets || 3} sets × ${exercise.reps || '10-12'} reps`;
                                    mainList.appendChild(li);
                                });
                            }
                        } else {
                            // Use daily rotation if no API data
                            const todaysWorkout = getDailyWorkout();
                            const mainList = document.getElementById('mainList');
                            if (mainList) {
                                mainList.innerHTML = '';
                                todaysWorkout.forEach(exercise => {
                                    const li = document.createElement('li');
                                    li.innerHTML = `<strong>${exercise.name}</strong> - ${exercise.sets} sets × ${exercise.reps} reps`;
                                    mainList.appendChild(li);
                                });
                            }
                        }
                    } else {
                        // Generate initial plans based on preference if none exists
                        await generateNewDietPlan();
                    }
                }
                
                // Load performance data
                const response = await fetch('/api/performance/data', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (response.ok) {
                    const data = await response.json();
                    console.log('Performance data:', data);
                    
                    // Check completion status
                    if (data.performance && data.performance.length > 0) {
                        const today = data.performance[0];
                        
                        if (today.workoutCompleted) {
                            updateWorkoutStatus('completed');
                            
                            // Update start button to completed state
                            const startBtn = document.getElementById('startWorkoutNowBtn');
                            if (startBtn) {
                                startBtn.textContent = '✓ Completed';
                                startBtn.disabled = true;
                                startBtn.style.background = '#28a745';
                            }
                        }
                        
                        if (today.dietCompleted) {
                            document.getElementById('dietScore').textContent = '100%';
                            const dietRing = document.getElementById('dietRing');
                            if (dietRing) {
                                const circumference = 2 * Math.PI * 35;
                                dietRing.style.strokeDashoffset = 0;
                            }
                        }
                        
                        // Update streak
                        if (data.currentStreak) {
                            document.getElementById('workoutStreak').textContent = data.currentStreak;
                        }
                    }
                }
            } catch (error) {
                console.error('Error loading diet progress:', error);
            }
        }

        // Calculate progressive weekly progress (starts at 0, increases daily)
        function calculateWeeklyProgress() {
            // Get user's start date (when they first used the app)
            let startDate = localStorage.getItem('userStartDate');
            if (!startDate) {
                startDate = new Date().toDateString();
                localStorage.setItem('userStartDate', startDate);
            }
            
            const start = new Date(startDate);
            const today = new Date();
            const daysSinceStart = Math.floor((today - start) / (1000 * 60 * 60 * 24));
            
            // Count completed workouts since start
            let completedWorkouts = 0;
            for (let i = 0; i <= daysSinceStart; i++) {
                const checkDate = new Date(start);
                checkDate.setDate(start.getDate() + i);
                const dateString = checkDate.toDateString();
                
                if (localStorage.getItem('workoutCompleted_' + dateString) === 'true') {
                    completedWorkouts++;
                }
            }
            
            // Calculate progress: each completed workout = ~14.3% (100/7)
            const progressPerWorkout = 100 / 7;
            const currentProgress = Math.min(100, completedWorkouts * progressPerWorkout);
            
            return Math.round(currentProgress);
        }
        
        // Update workout progress displays
        function updateWorkoutProgress(percentage) {
            // Update workout score
            document.getElementById('workoutScore').textContent = percentage + '%';
            
            // Update duration based on progress (starts at 0, increases to 45)
            const maxDuration = 45;
            const currentDuration = Math.round((percentage / 100) * maxDuration);
            document.getElementById('durationStatus').textContent = `${currentDuration} / ${maxDuration} min`;
            document.getElementById('durationBar').style.width = percentage + '%';
            
            // Update workout ring (starts empty, fills progressively)
            const workoutRing = document.getElementById('workoutRing');
            if (workoutRing) {
                const circumference = 2 * Math.PI * 28;
                const offset = circumference - (percentage / 100) * circumference;
                workoutRing.style.strokeDashoffset = offset;
            }
            
            // Update weekly consistency (shows actual completed workouts)
            const completedWorkouts = Math.round((percentage / 100) * 7);
            document.getElementById('weeklyConsistency').textContent = `${completedWorkouts}/7`;
            
            // Update weekly progress dots
            updateWeeklyDots(completedWorkouts);
            
            // Update burned calories based on progress
            const maxCalories = 300;
            const burnedCalories = Math.round((percentage / 100) * maxCalories);
            document.getElementById('burnedCal').textContent = burnedCalories;
        }
        
        // Update weekly progress dots (shows actual completion pattern)
        function updateWeeklyDots(completedWorkouts) {
            const container = document.getElementById('weeklyProgress');
            if (!container) return;
            
            container.innerHTML = '';
            const days = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
            
            // Get actual completion status for each day
            const startDate = localStorage.getItem('userStartDate');
            const start = startDate ? new Date(startDate) : new Date();
            
            for (let i = 0; i < 7; i++) {
                const checkDate = new Date(start);
                checkDate.setDate(start.getDate() + i);
                const dateString = checkDate.toDateString();
                const isCompleted = localStorage.getItem('workoutCompleted_' + dateString) === 'true';
                
                const dayElement = document.createElement('div');
                dayElement.className = `w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold ${
                    isCompleted ? 'bg-green-500 text-white' : 'bg-gray-200 text-gray-500'
                }`;
                dayElement.textContent = days[i];
                container.appendChild(dayElement);
            }
        }
        
        // Calculate workout streak (consecutive days)
        function calculateWorkoutStreak() {
            const startDate = localStorage.getItem('userStartDate');
            if (!startDate) return 0;
            
            const start = new Date(startDate);
            const today = new Date();
            let streak = 0;
            
            // Count consecutive completed workouts from most recent
            for (let i = 0; i <= Math.floor((today - start) / (1000 * 60 * 60 * 24)); i++) {
                const checkDate = new Date(today);
                checkDate.setDate(today.getDate() - i);
                const dateString = checkDate.toDateString();
                
                if (localStorage.getItem('workoutCompleted_' + dateString) === 'true') {
                    streak++;
                } else {
                    break;
                }
            }
            
            return streak;
        }
        
        // Calculate hydration streak
        function calculateHydrationStreak() {
            const startDate = localStorage.getItem('userStartDate');
            if (!startDate) return 0;
            
            const start = new Date(startDate);
            const today = new Date();
            let streak = 0;
            
            // Count consecutive days with water intake
            for (let i = 0; i <= Math.floor((today - start) / (1000 * 60 * 60 * 24)); i++) {
                const checkDate = new Date(today);
                checkDate.setDate(today.getDate() - i);
                const dateString = checkDate.toDateString();
                
                if (localStorage.getItem('waterCompleted_' + dateString) === 'true') {
                    streak++;
                } else {
                    break;
                }
            }
            
            return streak;
        }
        
        // Navigation functions
        function showSection(sectionName) {
            // Hide all sections
            document.getElementById('mainGrid').classList.add('hidden');
            document.getElementById('section1').classList.add('hidden');
            document.getElementById('workouts-section').classList.add('hidden');
            document.getElementById('diet-section').classList.add('hidden');
            document.getElementById('progress-section').classList.add('hidden');
            document.getElementById('analytics-section').classList.add('hidden');
            document.getElementById('ai-coach-section').classList.add('hidden');
            
            // Update nav links
            document.querySelectorAll('.nav-link').forEach(link => {
                link.className = 'nav-link flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium';
            });
            
            // Show selected section and update nav
            if (sectionName === 'dashboard') {
                document.getElementById('section1').classList.remove('hidden');
                document.getElementById('mainGrid').classList.remove('hidden');
                document.querySelector('[data-section="dashboard"]').className = 'nav-link flex items-center gap-3 px-4 py-3 bg-orange-50 text-orange-600 rounded-xl font-medium';
            } else {
                document.getElementById(sectionName + '-section').classList.remove('hidden');
                document.querySelector('[data-section="' + sectionName + '"]').className = 'nav-link flex items-center gap-3 px-4 py-3 bg-orange-50 text-orange-600 rounded-xl font-medium';
            }
        }
        
        // Make functions global for onclick handlers
        window.closeWeightModal = closeWeightModal;
        window.submitWeight = submitWeight;
        window.closeFoodModal = closeFoodModal;
        window.submitFood = submitFood;
        window.generateNewDietPlan = generateNewDietPlan;
        window.showSection = showSection;
        window.calculateWeeklyProgress = calculateWeeklyProgress;
        window.updateWorkoutProgress = updateWorkoutProgress;
        window.calculateWorkoutStreak = calculateWorkoutStreak;
        window.calculateHydrationStreak = calculateHydrationStreak;
        window.switchWeeklyView = switchWeeklyView;
        window.loadWeeklyOverview = loadWeeklyOverview;
        
        // Load weekly overview data on page load
        loadWeeklyOverview();

        // Weekly Overview Functions
        function switchWeeklyView(period) {
            const currentBtn = document.getElementById('currentWeekBtn');
            const lastBtn = document.getElementById('lastWeekBtn');
            
            if (period === 'current') {
                currentBtn.className = 'px-3 py-1 bg-blue-100 text-blue-600 rounded-lg text-sm font-medium';
                lastBtn.className = 'px-3 py-1 bg-gray-100 text-gray-600 rounded-lg text-sm font-medium';
            } else {
                currentBtn.className = 'px-3 py-1 bg-gray-100 text-gray-600 rounded-lg text-sm font-medium';
                lastBtn.className = 'px-3 py-1 bg-blue-100 text-blue-600 rounded-lg text-sm font-medium';
            }
            
            loadWeeklyOverview(period);
        }
        
        async function loadWeeklyOverview(period = 'current') {
            const token = localStorage.getItem('token') || sessionStorage.getItem('token');
            
            try {
                // Calculate week dates
                const today = new Date();
                const startOfWeek = new Date(today);
                startOfWeek.setDate(today.getDate() - today.getDay());
                
                if (period === 'last') {
                    startOfWeek.setDate(startOfWeek.getDate() - 7);
                }
                
                // Generate weekly data
                const weeklyData = generateWeeklyData(startOfWeek);
                
                // Update UI with weekly data
                updateWeeklyOverviewUI(weeklyData);
                
                // Try to fetch real data from API
                try {
                    const response = await fetch('/api/analytics/weekly', {
                        headers: { 'Authorization': `Bearer ${token}` },
                        method: 'POST',
                        body: JSON.stringify({ period, startDate: startOfWeek.toISOString() }),
                        headers: { 
                            'Authorization': `Bearer ${token}`,
                            'Content-Type': 'application/json'
                        }
                    });
                    
                    if (response.ok) {
                        const apiData = await response.json();
                        updateWeeklyOverviewUI(apiData);
                    }
                } catch (apiError) {
                    console.log('Using generated data for weekly overview');
                }
                
            } catch (error) {
                console.error('Error loading weekly overview:', error);
            }
        }
        
        function generateWeeklyData(startOfWeek) {
            const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
            let totalWorkouts = 0;
            let totalCalories = 0;
            let totalSteps = 0;
            let dietCompliance = 0;
            let completedDays = 0;
            
            const dailyActivities = [];
            
            // Check each day of the week
            for (let i = 0; i < 7; i++) {
                const checkDate = new Date(startOfWeek);
                checkDate.setDate(startOfWeek.getDate() + i);
                const dateString = checkDate.toDateString();
                
                const workoutCompleted = localStorage.getItem('workoutCompleted_' + dateString) === 'true';
                const dietCompleted = localStorage.getItem('dietCompleted_' + dateString) === 'true';
                const activityCompleted = localStorage.getItem('activityCompleted_' + dateString) === 'true';
                
                if (workoutCompleted) {
                    totalWorkouts++;
                    totalCalories += 300; // Average calories per workout
                }
                
                if (dietCompleted) {
                    dietCompliance += 100;
                    completedDays++;
                }
                
                if (activityCompleted) {
                    totalCalories += 150; // Additional activity calories
                }
                
                // Generate daily steps (random but realistic)
                const dailySteps = Math.floor(Math.random() * 3000) + 5000;
                totalSteps += dailySteps;
                
                // Create daily activity entry
                const dayActivity = {
                    day: days[i],
                    date: checkDate.toLocaleDateString(),
                    workout: workoutCompleted,
                    diet: dietCompleted,
                    activity: activityCompleted,
                    steps: dailySteps,
                    calories: workoutCompleted ? 300 : 0
                };
                
                dailyActivities.push(dayActivity);
            }
            
            // Calculate averages and insights
            const avgDietCompliance = completedDays > 0 ? Math.round(dietCompliance / 7) : 0;
            const avgDailySteps = Math.round(totalSteps / 7);
            const avgDailyCals = Math.round(totalCalories / 7);
            
            // Generate insights
            const insights = generateWeeklyInsights(dailyActivities, totalWorkouts, avgDietCompliance);
            
            return {
                workouts: totalWorkouts,
                calories: totalCalories,
                steps: avgDailySteps,
                dietScore: avgDietCompliance,
                dailyActivities,
                insights,
                nutrition: {
                    avgDailyCals: avgDailyCals + 1800, // Add base metabolism
                    avgProtein: Math.round(totalWorkouts * 25 + 60), // Protein based on activity
                    avgHydration: Math.round((totalWorkouts * 0.5 + 2) * 10) / 10, // Hydration in liters
                    mealCompliance: avgDietCompliance
                }
            };
        }
        
        function generateWeeklyInsights(dailyActivities, totalWorkouts, dietCompliance) {
            // Find best performance day
            let bestDay = 'Monday';
            let bestScore = 0;
            
            dailyActivities.forEach(day => {
                const score = (day.workout ? 40 : 0) + (day.diet ? 30 : 0) + (day.activity ? 20 : 0) + (day.steps > 8000 ? 10 : 0);
                if (score > bestScore) {
                    bestScore = score;
                    bestDay = day.day;
                }
            });
            
            // Determine improvement area
            let improvementArea = 'Consistency';
            if (totalWorkouts < 3) {
                improvementArea = 'Workout frequency - aim for 4-5 sessions';
            } else if (dietCompliance < 70) {
                improvementArea = 'Diet tracking - log meals daily';
            } else {
                improvementArea = 'Great job! Focus on progressive overload';
            }
            
            // Streak status
            const currentStreak = calculateWorkoutStreak();
            let streakStatus = `${currentStreak} day workout streak`;
            if (currentStreak >= 7) {
                streakStatus += ' - Amazing consistency! 🔥';
            } else if (currentStreak >= 3) {
                streakStatus += ' - Keep it up! 💪';
            } else {
                streakStatus += ' - Build momentum daily';
            }
            
            // Achievement
            let achievement = 'Getting started!';
            if (totalWorkouts >= 6) {
                achievement = 'Workout Warrior - 6+ sessions! 🏆';
            } else if (totalWorkouts >= 4) {
                achievement = 'Consistency Champion - 4+ workouts! 🥇';
            } else if (totalWorkouts >= 2) {
                achievement = 'Progress Maker - 2+ sessions! 🌟';
            } else if (dietCompliance >= 80) {
                achievement = 'Nutrition Master - Great diet tracking! 🥗';
            }
            
            return {
                bestDay,
                improvementArea,
                streakStatus,
                achievement
            };
        }
        
        function updateWeeklyOverviewUI(data) {
            // Update main stats
            document.getElementById('weeklyWorkouts').textContent = data.workouts;
            document.getElementById('weeklyDietScore').textContent = data.dietScore + '%';
            document.getElementById('weeklyCals').textContent = data.calories;
            document.getElementById('weeklySteps').textContent = data.steps.toLocaleString();
            
            // Update progress bars
            const workoutProgress = Math.min(100, (data.workouts / 7) * 100);
            document.getElementById('workoutProgressBar').style.width = workoutProgress + '%';
            
            document.getElementById('dietProgressBar').style.width = data.dietScore + '%';
            
            const calorieProgress = Math.min(100, (data.calories / 2100) * 100); // Target 2100 calories/week
            document.getElementById('calorieProgressBar').style.width = calorieProgress + '%';
            
            const stepsProgress = Math.min(100, (data.steps / 10000) * 100); // Target 10k steps/day
            document.getElementById('stepsProgressBar').style.width = stepsProgress + '%';
            
            // Update daily activities
            const dailyList = document.getElementById('dailyActivityList');
            dailyList.innerHTML = '';
            
            data.dailyActivities.forEach(day => {
                const dayElement = document.createElement('div');
                dayElement.className = 'flex justify-between items-center p-2 bg-white rounded-lg border';
                
                const statusIcons = [
                    day.workout ? '💪' : '⭕',
                    day.diet ? '🥗' : '⭕',
                    day.activity ? '🚶' : '⭕'
                ].join(' ');
                
                dayElement.innerHTML = `
                    <div>
                        <span class="font-medium text-sm">${day.day}</span>
                        <span class="text-xs text-gray-500 ml-2">${day.date}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-sm">${statusIcons}</span>
                        <span class="text-xs text-gray-500">${day.steps.toLocaleString()} steps</span>
                    </div>
                `;
                
                dailyList.appendChild(dayElement);
            });
            
            // Update nutrition summary
            if (data.nutrition) {
                document.getElementById('avgDailyCals').textContent = data.nutrition.avgDailyCals + ' kcal';
                document.getElementById('avgProtein').textContent = data.nutrition.avgProtein + 'g';
                document.getElementById('avgHydration').textContent = data.nutrition.avgHydration + 'L';
                document.getElementById('mealCompliance').textContent = data.nutrition.mealCompliance + '%';
            }
            
            // Update insights
            if (data.insights) {
                document.getElementById('bestDay').textContent = data.insights.bestDay;
                document.getElementById('improvementArea').textContent = data.insights.improvementArea;
                document.getElementById('streakStatus').textContent = data.insights.streakStatus;
                document.getElementById('weeklyAchievement').textContent = data.insights.achievement;
            }
        }
        
        // Quick Action Buttons
        document.getElementById('newWorkoutBtn').addEventListener('click', () => {
            sendChatMessage('Generate a new workout plan for me');
        });

        document.getElementById('checkProgressBtn').addEventListener('click', async () => {
            const token = localStorage.getItem('token') || sessionStorage.getItem('token');
            try {
                const response = await fetch('/api/analytics/progress', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (response.ok) {
                    const data = await response.json();
                    const progressMsg = `📊 Your Progress:\n\n` +
                        `Workouts: ${data.totalWorkouts || 0}\n` +
                        `Streak: ${data.currentStreak || 0} days\n` +
                        `Total Score: ${data.totalScore || 0} points`;
                    
                    const aiMsg = document.createElement('p');
                    aiMsg.className = 'bg-gray-800 p-2 rounded-lg rounded-tl-none inline-block whitespace-pre-line';
                    aiMsg.textContent = progressMsg;
                    chatHistory.appendChild(aiMsg);
                    chatHistory.scrollTop = chatHistory.scrollHeight;
                } else {
                    sendChatMessage('Show me my progress');
                }
            } catch (error) {
                console.error('Progress check error:', error);
                sendChatMessage('Show me my progress');
            }
        });
    </script>
