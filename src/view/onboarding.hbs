  <script>
    const formData = {
      gender: '',
      age: null,
      height: null,
      weight: 70,
      fitnessGoal: '',
      fitnessLevel: '',
      activityLevel: '',
      medicalConditions: [],
      dietPreference: '',
      workoutPreference: '',
      availableEquipment: [],
      workoutTime: '',
      exerciseFrequency: {
        timesPerWeek: 3,
        preferredDays: []
      },
      permissions: {
        emailUpdates: false,
        location: false,
        healthTracking: false
      },
      firstGoal: '',
      onboardingStep: 1,
      isComplete: false
    };

    let currentStep = 1;
    const totalSteps = 16;

    const debounce = (func, wait) => {
      let timeout;
      return (...args) => {
        clearTimeout(timeout);
        timeout = setTimeout(() => func(...args), wait);
      };
    };

    const saveFormData = () => {
      localStorage.setItem('formData', JSON.stringify(formData));
      saveProgress();
    };

    const loadFormData = () => {
      const savedData = localStorage.getItem('formData');
      if (savedData) {
        Object.assign(formData, JSON.parse(savedData));
        currentStep = formData.onboardingStep;
        showStep(currentStep);
        updateFormUI();
      }
    };

    const updateFormUI = () => {
      if (formData.gender) selectGender(formData.gender);
      if (formData.age) {
        document.getElementById('age-input').value = formData.age;
        handleAgeInput({ target: document.getElementById('age-input') });
      }
      if (formData.height) {
        document.getElementById('height-input').value = formData.height;
        handleHeightInput({ target: document.getElementById('height-input') });
      }
      if (formData.weight) {
        document.getElementById('weight-slider').value = formData.weight;
        updateWeight();
      }
      if (formData.fitnessGoal) selectGoal(formData.fitnessGoal);
      if (formData.fitnessLevel) document.getElementById('fitness-level').value = formData.fitnessLevel;
      if (formData.activityLevel) document.getElementById('activity-level').value = formData.activityLevel;
      if (formData.medicalConditions.length) document.getElementById('medical-conditions').value = formData.medicalConditions.join(', ');
      if (formData.dietPreference) document.getElementById('diet-preference').value = formData.dietPreference;
      if (formData.workoutPreference) document.getElementById('workout-preference').value = formData.workoutPreference;
      if (formData.availableEquipment.length) document.getElementById('available-equipment').value = formData.availableEquipment.join(', ');
      if (formData.workoutTime) document.getElementById('workout-time').value = formData.workoutTime;
      if (formData.exerciseFrequency.timesPerWeek) {
        document.getElementById('frequency-slider').value = formData.exerciseFrequency.timesPerWeek;
        updateFrequency();
      }
      if (formData.exerciseFrequency.preferredDays.length) {
        formData.exerciseFrequency.preferredDays.forEach(day => {
          document.getElementById(`day-${day.toLowerCase()}`).checked = true;
        });
      }
      if (formData.firstGoal) document.getElementById('first-goal').value = formData.firstGoal;
      document.getElementById('email-updates').checked = formData.permissions.emailUpdates;
      document.getElementById('location').checked = formData.permissions.location;
      document.getElementById('health-tracking').checked = formData.permissions.healthTracking;
      updateButtons();
      if (currentStep === 16) updateSummary();
    };

    const updateProgress = () => {
      const progressBar = document.getElementById('progress-bar');
      const stepIndicator = document.getElementById('step-indicator');
      const percentage = (currentStep / totalSteps) * 100;
      progressBar.style.width = `${percentage}%`;
      stepIndicator.textContent = `Step ${currentStep} of ${totalSteps}`;
    };

    const showStep = (step) => {
      document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
      document.getElementById(`step-${step}`).classList.add('active');
      updateProgress();
      if (step === 16) updateSummary();
    };

    const validateStep = (step) => {
      switch (step) {
        case 1: return !!formData.gender;
        case 2: return formData.age >= 13 && formData.age <= 120;
        case 3: return formData.height >= 100 && formData.height <= 250;
        case 4: return formData.weight >= 30 && formData.weight <= 200;
        case 5: return !!formData.fitnessGoal;
        case 6: return !!formData.fitnessLevel;
        case 7: return !!formData.activityLevel;
        case 9: return !!formData.dietPreference;
        case 10: return !!formData.workoutPreference;
        case 12: return !!formData.workoutTime;
        case 13: return formData.exerciseFrequency.timesPerWeek > 0 && formData.exerciseFrequency.preferredDays.length >= formData.exerciseFrequency.timesPerWeek;
        case 14: return !!formData.firstGoal;
        case 15: return true; // Optional
        case 16: return true;
        default: return true;
      }
    };

    const nextStep = () => {
      if (!validateStep(currentStep)) {
        alert('Please complete the current step correctly.');
        return;
      }
      if (currentStep < totalSteps) {
        currentStep++;
        formData.onboardingStep = currentStep;
        showStep(currentStep);
        saveFormData();
      }
    };

    const prevStep = () => {
      if (currentStep > 1) {
        currentStep--;
        formData.onboardingStep = currentStep;
        showStep(currentStep);
        saveFormData();
      }
    };

    const selectGender = (gender) => {
      formData.gender = gender;
      document.querySelectorAll('.card[data-gender]').forEach(card => {
        card.classList.toggle('selected', card.dataset.gender === gender);
      });
      document.getElementById('next-button-1').disabled = false;
      saveFormData();
    };

    const handleAgeInput = (e) => {
      const age = parseInt(e.target.value);
      formData.age = age || null;
      const feedback = document.getElementById('age-feedback');
      if (age && age > 0) {
        if (age < 18) {
          feedback.textContent = "Youth fitness programs available";
        } else if (age < 30) {
          feedback.textContent = "Perfect age to build lifelong habits";
        } else if (age < 50) {
          feedback.textContent = "Great time to maintain peak fitness";
        } else {
          feedback.textContent = "Wisdom meets wellness - let's do this!";
        }
      } else {
        feedback.textContent = "";
      }
      document.getElementById('next-button-2').disabled = !validateStep(2);
    };

    const handleHeightInput = (e) => {
      const height = parseFloat(e.target.value);
      formData.height = height || null;
      const feedback = document.getElementById('height-feedback');
      if (height && height > 0) {
        const feet = Math.floor(height / 30.48);
        const inches = Math.round((height % 30.48) / 2.54);
        feedback.textContent = `${feet}'${inches}" (${height}cm)`;
      } else {
        feedback.textContent = "";
      }
      document.getElementById('next-button-3').disabled = !validateStep(3);
    };

    const updateWeight = () => {
      const slider = document.getElementById('weight-slider');
      const display = document.getElementById('weight-display');
      const feedback = document.getElementById('weight-feedback');
      formData.weight = parseInt(slider.value);
      display.textContent = `${formData.weight} kg`;
      if (formData.weight < 50) {
        feedback.textContent = "Light and agile";
      } else if (formData.weight < 70) {
        feedback.textContent = "Healthy range";
      } else if (formData.weight < 90) {
        feedback.textContent = "Strong foundation";
      } else {
        feedback.textContent = "Powerful build";
      }
      const percentage = ((formData.weight - 30) / 170) * 100;
      slider.style.background = `linear-gradient(to right, var(--primary-color) 0%, var(--secondary-color) ${percentage}%, rgba(255,255,255,0.2) ${percentage}%, rgba(255,255,255,0.2) 100%)`;
      document.getElementById('next-button-4').disabled = !validateStep(4);
      saveFormData();
    };

    const selectGoal = (goal) => {
      formData.fitnessGoal = goal;
      document.querySelectorAll('.card[data-goal]').forEach(card => {
        card.classList.toggle('selected', card.dataset.goal === goal);
      });
      document.getElementById('next-button-5').disabled = !validateStep(5);
      saveFormData();
    };

    const handleMedicalConditions = (e) => {
      formData.medicalConditions = e.target.value.split(',').map(s => s.trim()).filter(Boolean);
      saveFormData();
    };

    const handleAvailableEquipment = (e) => {
      formData.availableEquipment = e.target.value.split(',').map(s => s.trim()).filter(Boolean);
      saveFormData();
    };

    const updateFrequency = () => {
      const slider = document.getElementById('frequency-slider');
      const display = document.getElementById('frequency-display');
      formData.exerciseFrequency.timesPerWeek = parseInt(slider.value);
      display.textContent = `${formData.exerciseFrequency.timesPerWeek} times/week`;
      const percentage = ((formData.exerciseFrequency.timesPerWeek - 1) / 6) * 100;
      slider.style.background = `linear-gradient(to right, var(--primary-color) 0%, var(--secondary-color) ${percentage}%, rgba(255,255,255,0.2) ${percentage}%, rgba(255,255,255,0.2) 100%)`;
      updatePreferredDays();
      document.getElementById('next-button-13').disabled = !validateStep(13);
      saveFormData();
    };

    const updatePreferredDays = () => {
      formData.exerciseFrequency.preferredDays = [];
      ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'].forEach(day => {
        const checkbox = document.getElementById(`day-${day}`);
        if (checkbox.checked) formData.exerciseFrequency.preferredDays.push(day.toUpperCase());
      });
      document.getElementById('next-button-13').disabled = !validateStep(13);
      saveFormData();
    };

    const handleFirstGoal = (e) => {
      formData.firstGoal = e.target.value.trim();
      document.getElementById('next-button-14').disabled = !validateStep(14);
      saveFormData();
    };

    const updatePermissions = () => {
      formData.permissions.emailUpdates = document.getElementById('email-updates').checked;
      formData.permissions.location = document.getElementById('location').checked;
      formData.permissions.healthTracking = document.getElementById('health-tracking').checked;
      saveFormData();
    };

    const updateSummary = () => {
      const summary = document.getElementById('form-summary');
      summary.innerHTML = `
        <p><strong>Gender:</strong> ${formData.gender}</p>
        <p><strong>Age:</strong> ${formData.age}</p>
        <p><strong>Height:</strong> ${formData.height} cm</p>
        <p><strong>Weight:</strong> ${formData.weight} kg</p>
        <p><strong>Fitness Goal:</strong> ${formData.fitnessGoal}</p>
        <p><strong>Fitness Level:</strong> ${formData.fitnessLevel}</p>
        <p><strong>Activity Level:</strong> ${formData.activityLevel}</p>
        <p><strong>Medical Conditions:</strong> ${formData.medicalConditions.join(', ') || 'None'}</p>
        <p><strong>Diet Preference:</strong> ${formData.dietPreference}</p>
        <p><strong>Workout Preference:</strong> ${formData.workoutPreference}</p>
        <p><strong>Available Equipment:</strong> ${formData.availableEquipment.join(', ') || 'None'}</p>
        <p><strong>Workout Time:</strong> ${formData.workoutTime}</p>
        <p><strong>Exercise Frequency:</strong> ${formData.exerciseFrequency.timesPerWeek} times/week on ${formData.exerciseFrequency.preferredDays.join(', ')}</p>
        <p><strong>First Goal:</strong> ${formData.firstGoal}</p>
        <p><strong>Permissions:</strong> Email: ${formData.permissions.emailUpdates ? 'Yes' : 'No'}, Location: ${formData.permissions.location ? 'Yes' : 'No'}, Health Tracking: ${formData.permissions.healthTracking ? 'Yes' : 'No'}</p>
      `;
    };

    const updateButtons = () => {
      for (let i = 1; i <= totalSteps; i++) {
        const nextBtn = document.getElementById(`next-button-${i}`);
        if (nextBtn) nextBtn.disabled = !validateStep(i);
      }
    };

    const saveProgress = async () => {
      try {
        await axios.post('/api/onboarding', formData, {
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content }
        });
      } catch (error) {
        console.error('Error saving progress:', error);
      }
    };

    const init = () => {
      loadFormData();
      document.getElementById('age-input').addEventListener('input', debounce((e) => { handleAgeInput(e); saveFormData(); }, 300));
      document.getElementById('height-input').addEventListener('input', debounce((e) => { handleHeightInput(e); saveFormData(); }, 300));
      document.getElementById('weight-slider').addEventListener('input', updateWeight);
      document.getElementById('medical-conditions').addEventListener('input', debounce((e) => { handleMedicalConditions(e); saveFormData(); }, 300));
      document.getElementById('available-equipment').addEventListener('input', debounce((e) => { handleAvailableEquipment(e); saveFormData(); }, 300));
      document.getElementById('frequency-slider').addEventListener('input', updateFrequency);
      ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'].forEach(day => {
        document.getElementById(`day-${day}`).addEventListener('change', updatePreferredDays);
      });
      document.getElementById('first-goal').addEventListener('input', debounce((e) => { handleFirstGoal(e); }, 300));
      document.getElementById('email-updates').addEventListener('change', updatePermissions);
      document.getElementById('location').addEventListener('change', updatePermissions);
      document.getElementById('health-tracking').addEventListener('change', updatePermissions);
      document.getElementById('fitness-level').addEventListener('change', (e) => {
        formData.fitnessLevel = e.target.value;
        document.getElementById('next-button-6').disabled = !validateStep(6);
        saveFormData();
      });
      document.getElementById('activity-level').addEventListener('change', (e) => {
        formData.activityLevel = e.target.value;
        document.getElementById('next-button-7').disabled = !validateStep(7);
        saveFormData();
      });
      document.getElementById('diet-preference').addEventListener('change', (e) => {
        formData.dietPreference = e.target.value;
        document.getElementById('next-button-9').disabled = !validateStep(9);
        saveFormData();
      });
      document.getElementById('workout-preference').addEventListener('change', (e) => {
        formData.workoutPreference = e.target.value;
        document.getElementById('next-button-10').disabled = !validateStep(10);
        saveFormData();
      });
      document.getElementById('workout-time').addEventListener('change', (e) => {
        formData.workoutTime = e.target.value;
        document.getElementById('next-button-12').disabled = !validateStep(12);
        saveFormData();
      });
      updateProgress();
      updateWeight();
      updateFrequency();
    };

    document.addEventListener('DOMContentLoaded', init);
  </script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script>
    async function submitForm() {
      const submitButton = document.getElementById('submit-button');
      if (!submitButton) return;

      if (!validateStep(16)) {
        alert('Please review and complete all required fields.');
        return;
      }

      const maxRetries = 3;
      let attempts = 0;

      while (attempts < maxRetries) {
        try {
          submitButton.disabled = true;
          submitButton.innerHTML = '<div class="loader"></div>';

          const response = await axios.post('/api/onboarding', formData, {
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            }
          });

          if (response.status === 200) {
            alert('Form submitted successfully! Redirecting to your fitness plan...');
            window.location.href = '/dashboard';
            localStorage.removeItem('formData');
            return;
          }
        } catch (error) {
          attempts++;
          if (attempts === maxRetries) {
            console.error('Submission error:', error);
            alert(`Error submitting form: ${error.response?.data?.message || 'Please try again later.'}`);
            submitButton.disabled = false;
            submitButton.innerHTML = '<span>Submit</span><span class="icon-arrow-right"></span>';
            return;
          }
          await new Promise(resolve => setTimeout(resolve, 1000 * attempts));
        }
      }
    }
  </script>
</body>
</html>