<!-- Adaptive Features Based on User State -->
{{#if isReturning}}
    <!-- Advanced Features for Returning Users -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <!-- Recent Activity Summary -->
        <div class="glass-card rounded-2xl p-6">
            <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
                <span>📊</span> Recent Activity
            </h3>
            <div class="space-y-3">
                <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg border border-green-200">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center text-white">
                            <span class="text-sm">💪</span>
                        </div>
                        <div>
                            <div class="font-medium text-gray-900">Yesterday's Workout</div>
                            <div class="text-sm text-gray-600">45 min • 320 calories</div>
                        </div>
                    </div>
                    <span class="text-green-600 font-bold">✓</span>
                </div>
                
                <div class="flex items-center justify-between p-3 bg-blue-50 rounded-lg border border-blue-200">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white">
                            <span class="text-sm">🥗</span>
                        </div>
                        <div>
                            <div class="font-medium text-gray-900">Diet Tracking</div>
                            <div class="text-sm text-gray-600">1,850/2,000 calories</div>
                        </div>
                    </div>
                    <span class="text-blue-600 font-bold">92%</span>
                </div>
                
                <div class="flex items-center justify-between p-3 bg-purple-50 rounded-lg border border-purple-200">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center text-white">
                            <span class="text-sm">💧</span>
                        </div>
                        <div>
                            <div class="font-medium text-gray-900">Hydration</div>
                            <div class="text-sm text-gray-600">2.2L water intake</div>
                        </div>
                    </div>
                    <span class="text-purple-600 font-bold">88%</span>
                </div>
            </div>
        </div>
        
        <!-- Achievements & Milestones -->
        <div class="glass-card rounded-2xl p-6">
            <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
                <span>🏆</span> Achievements
            </h3>
            <div class="space-y-3">
                <div class="flex items-center gap-3 p-3 bg-yellow-50 rounded-lg border border-yellow-200">
                    <div class="w-10 h-10 bg-yellow-500 rounded-full flex items-center justify-center text-white">
                        <span>🔥</span>
                    </div>
                    <div>
                        <div class="font-bold text-gray-900">{{stats.currentStreak}} Day Streak!</div>
                        <div class="text-sm text-gray-600">Keep the momentum going</div>
                    </div>
                </div>
                
                <div class="flex items-center gap-3 p-3 bg-green-50 rounded-lg border border-green-200">
                    <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center text-white">
                        <span>💪</span>
                    </div>
                    <div>
                        <div class="font-bold text-gray-900">Consistency Champion</div>
                        <div class="text-sm text-gray-600">{{stats.workoutCompletionRate}}% workout completion rate</div>
                    </div>
                </div>
                
                <div class="flex items-center gap-3 p-3 bg-blue-50 rounded-lg border border-blue-200">
                    <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white">
                        <span>⭐</span>
                    </div>
                    <div>
                        <div class="font-bold text-gray-900">{{stats.totalScore}} Points Earned</div>
                        <div class="text-sm text-gray-600">You're crushing your goals!</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{{else}}
    <!-- Simplified Features for New Users -->
    <div class="glass-card rounded-2xl p-6 mb-6 bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200">
        <h3 class="text-lg font-bold text-blue-900 mb-4 flex items-center gap-2">
            <span>🎓</span> Getting Started Guide
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white rounded-lg p-4 border border-blue-100">
                <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center text-white mb-3">
                    <span class="text-xl">1️⃣</span>
                </div>
                <h4 class="font-bold text-gray-900 mb-2">Complete Profile</h4>
                <p class="text-sm text-gray-600">Tell us about your fitness goals, current level, and preferences</p>
                <div class="mt-3">
                    {{#if isFirstTime}}
                        <span class="text-xs bg-orange-100 text-orange-600 px-2 py-1 rounded-full font-medium">CURRENT STEP</span>
                    {{else}}
                        <span class="text-xs bg-green-100 text-green-600 px-2 py-1 rounded-full font-medium">✓ COMPLETED</span>
                    {{/if}}
                </div>
            </div>
            
            <div class="bg-white rounded-lg p-4 border border-blue-100 {{#if isFirstTime}}opacity-60{{/if}}">
                <div class="w-12 h-12 {{#if isFirstTime}}bg-gray-300{{else}}bg-blue-500{{/if}} rounded-full flex items-center justify-center text-white mb-3">
                    <span class="text-xl">2️⃣</span>
                </div>
                <h4 class="font-bold {{#if isFirstTime}}text-gray-500{{else}}text-gray-900{{/if}} mb-2">Generate AI Plans</h4>
                <p class="text-sm {{#if isFirstTime}}text-gray-400{{else}}text-gray-600{{/if}}">Get personalized workout and diet plans created by AI</p>
                <div class="mt-3">
                    {{#if isFirstTime}}
                        <span class="text-xs bg-gray-100 text-gray-500 px-2 py-1 rounded-full font-medium">🔒 LOCKED</span>
                    {{else if (eq flowState 'onboarding_complete')}}
                        <span class="text-xs bg-orange-100 text-orange-600 px-2 py-1 rounded-full font-medium">CURRENT STEP</span>
                    {{else}}
                        <span class="text-xs bg-green-100 text-green-600 px-2 py-1 rounded-full font-medium">✓ COMPLETED</span>
                    {{/if}}
                </div>
            </div>
            
            <div class="bg-white rounded-lg p-4 border border-blue-100 {{#unless isReturning}}opacity-60{{/unless}}">
                <div class="w-12 h-12 {{#unless isReturning}}bg-gray-300{{else}}bg-blue-500{{/unless}} rounded-full flex items-center justify-center text-white mb-3">
                    <span class="text-xl">3️⃣</span>
                </div>
                <h4 class="font-bold {{#unless isReturning}}text-gray-500{{else}}text-gray-900{{/unless}} mb-2">Start Training</h4>
                <p class="text-sm {{#unless isReturning}}text-gray-400{{else}}text-gray-600{{/unless}}">Begin your fitness journey with daily workouts and meal tracking</p>
                <div class="mt-3">
                    {{#unless isReturning}}
                        <span class="text-xs bg-gray-100 text-gray-500 px-2 py-1 rounded-full font-medium">🔒 LOCKED</span>
                    {{else}}
                        <span class="text-xs bg-green-100 text-green-600 px-2 py-1 rounded-full font-medium">✓ READY</span>
                    {{/unless}}
                </div>
            </div>
        </div>
        
        {{#if isFirstTime}}
            <div class="mt-4 p-3 bg-blue-100 rounded-lg border border-blue-200">
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-blue-600">💡</span>
                    <span class="text-sm font-medium text-blue-800">Why complete your profile?</span>
                </div>
                <p class="text-sm text-blue-700">Your profile helps our AI create personalized workout and diet plans that match your fitness level, goals, and preferences. This ensures you get the most effective and safe fitness routine.</p>
            </div>
        {{/if}}
    </div>
{{/if}}

<!-- Feature Availability Notice for Non-Complete Users -->
{{#unless isReturning}}
<div class="glass-card rounded-2xl p-4 mb-6 bg-gradient-to-r from-amber-50 to-yellow-50 border border-amber-200">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-amber-500 rounded-full flex items-center justify-center text-white">
            <span>🔓</span>
        </div>
        <div>
            <h4 class="font-bold text-amber-900">Unlock Full Dashboard</h4>
            <p class="text-sm text-amber-700">
                {{#if isFirstTime}}
                    Complete your profile to unlock personalized AI plans and full dashboard features
                {{else}}
                    Generate your AI plans to unlock workout tracking, diet logging, and progress analytics
                {{/if}}
            </p>
        </div>
        <button onclick="{{#if isFirstTime}}window.location.href='/onboarding'{{else}}window.location.href='/ai-plans'{{/if}}" 
                class="px-4 py-2 bg-amber-500 text-white rounded-lg hover:bg-amber-600 transition-colors whitespace-nowrap">
            {{#if isFirstTime}}Complete Profile{{else}}Generate Plans{{/if}}
        </button>
    </div>
</div>
{{/unless}}