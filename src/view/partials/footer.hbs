<style>
    /* Footer Styles */
    .footer-wrapper {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        width: 100%;
        position: relative;
        z-index: 100;
    }

    footer {
        width: 100%;
        background: #000;
        padding: 30px 40px 20px;
        position: relative;
        z-index: 1;
    }

    .footer-content {
        max-width: 1400px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 30px;
        margin-bottom: 40px;
        position: relative;
        z-index: 1;
    }

    .footer-section h3 {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #666;
        margin-bottom: 16px;
    }

    .footer-links {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .footer-links a {
        color: #fff;
        text-decoration: none;
        font-size: 15px;
        transition: all 0.3s ease;
        width: fit-content;
    }

    .footer-links a:hover {
        color: #ff6b35;
        transform: translateX(5px);
    }

    .subscribe-section {
        grid-column: span 2;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
    }

    .subscribe-title {
        font-size: 28px;
        font-weight: 600;
        color: #fff;
        margin-bottom: 16px;
        line-height: 1.3;
    }

    .subscribe-title span {
        font-style: italic;
        background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .subscribe-description {
        color: #999;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 24px;
        max-width: 500px;
    }

    .subscribe-form {
        position: relative;
        max-width: 350px;
        margin-left: auto;
    }

    .subscribe-form input {
        width: 100%;
        padding: 18px 180px 18px 24px;
        border: 1px solid #333;
        border-radius: 50px;
        font-size: 14px;
        outline: none;
        transition: all 0.3s ease;
        background: #000;
        color: #fff;
    }

    .subscribe-form input::placeholder {
        color: #666;
    }

    .subscribe-form input:focus {
        border-color: #ff6b35;
        background: #111;
    }

    .subscribe-form button {
        position: absolute;
        right: 5px;
        top: 50%;
        transform: translateY(-50%);
        background: #fff;
        color: #000;
        border: none;
        padding: 14px 32px;
        border-radius: 50px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .subscribe-form button:hover {
        background: #ff6b35;
        color: #fff;
        transform: translateY(-50%) scale(1.05);
    }

    .footer-bottom {
        max-width: 1400px;
        margin: 0 auto;
        padding-top: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 30px;
        position: relative;
        z-index: 1;
    }

    .brand-section {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .brand-logo {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #fff;
    }

    .brand-name {
        font-size: 20px;
        font-weight: 800;
        color: #fff;
        letter-spacing: 1px;
    }

    .footer-bottom-links {
        display: flex;
        gap: 24px;
        align-items: center;
    }

    .footer-bottom-links a {
        color: #666;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .footer-bottom-links a:hover {
        color: #fff;
    }

    .copyright {
        color: #666;
        font-size: 13px;
    }

    .large-text {
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 140px;
        font-weight: 900;
        color: transparent;
        -webkit-text-stroke: 1px #1a1a1a;
        text-stroke: 1px #1a1a1a;
        letter-spacing: 15px;
        pointer-events: none;
        white-space: nowrap;
        opacity: 0.5;
        z-index: 0;
    }

    @media (max-width: 1024px) {
        .large-text {
            font-size: 80px;
            letter-spacing: 8px;
        }

        .subscribe-section {
            grid-column: span 1;
        }
    }

    @media (max-width: 768px) {
        footer {
            padding: 25px 20px 15px;
        }

        .footer-content {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .subscribe-title {
            font-size: 24px;
        }

        .subscribe-form input {
            padding: 16px 20px;
            padding-right: 24px;
            margin-bottom: 12px;
        }

        .subscribe-form button {
            position: static;
            transform: none;
            width: 80%;
        }

        .subscribe-form button:hover {
            transform: scale(1.02);
        }

        .footer-bottom {
            flex-direction: column;
            text-align: center;
            gap: 20px;
            padding-top: 20px;
        }

        .large-text {
            font-size: 40px;
            letter-spacing: 3px;
            padding-bottom: 20px;
        }
    }
</style>

