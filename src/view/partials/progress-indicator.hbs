<!-- Progress Indicator for Non-Complete Users -->
{{#unless isReturning}}
<div class="glass-card rounded-2xl p-6 mb-6 bg-gradient-to-r from-indigo-50 to-purple-50 border border-indigo-200">
    <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-indigo-900 flex items-center gap-2">
            <span>🎯</span> Setup Progress
        </h3>
        <span class="px-3 py-1 bg-indigo-100 text-indigo-700 text-sm font-bold rounded-full">
            {{completionPercentage}}% Complete
        </span>
    </div>
    
    <!-- Progress Bar -->
    <div class="mb-4">
        <div class="w-full bg-indigo-200 rounded-full h-3 overflow-hidden">
            <div class="bg-gradient-to-r from-indigo-500 to-purple-500 h-3 rounded-full transition-all duration-1000 ease-out" 
                 style="width: {{completionPercentage}}%"></div>
        </div>
        <div class="flex justify-between mt-2 text-xs text-indigo-600">
            <span>Started</span>
            <span>{{#if (eq flowState 'onboarding_complete')}}Plans Ready{{else}}Almost There{{/if}}</span>
            <span>Complete</span>
        </div>
    </div>
    
    <!-- Steps -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Step 1: Registration -->
        <div class="flex items-center gap-3 p-3 bg-white rounded-lg border border-indigo-100">
            <div class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center text-white">
                <span class="text-sm">✓</span>
            </div>
            <div>
                <h4 class="font-medium text-gray-900">Account Created</h4>
                <p class="text-xs text-gray-500">Welcome aboard!</p>
            </div>
        </div>
        
        <!-- Step 2: Onboarding -->
        <div class="flex items-center gap-3 p-3 bg-white rounded-lg border border-indigo-100">
            <div class="w-8 h-8 {{#if isReturning}}bg-green-500{{else if isFirstTime}}bg-orange-500{{else}}bg-gray-300{{/if}} rounded-full flex items-center justify-center text-white">
                {{#if isReturning}}
                    <span class="text-sm">✓</span>
                {{else if isFirstTime}}
                    <span class="text-sm">2</span>
                {{else}}
                    <span class="text-sm">⏳</span>
                {{/if}}
            </div>
            <div>
                <h4 class="font-medium {{#if isReturning}}text-gray-900{{else if isFirstTime}}text-orange-600{{else}}text-gray-500{{/if}}">
                    Profile Setup
                </h4>
                <p class="text-xs {{#if isReturning}}text-gray-500{{else if isFirstTime}}text-orange-500{{else}}text-gray-400{{/if}}">
                    {{#if isReturning}}Completed!{{else if isFirstTime}}In progress...{{else}}Ready to start{{/if}}
                </p>
            </div>
        </div>
        
        <!-- Step 3: AI Plans -->
        <div class="flex items-center gap-3 p-3 bg-white rounded-lg border border-indigo-100">
            <div class="w-8 h-8 {{#if isReturning}}bg-green-500{{else if (eq flowState 'onboarding_complete')}}bg-indigo-500{{else}}bg-gray-300{{/if}} rounded-full flex items-center justify-center text-white">
                {{#if isReturning}}
                    <span class="text-sm">✓</span>
                {{else if (eq flowState 'onboarding_complete')}}
                    <span class="text-sm">3</span>
                {{else}}
                    <span class="text-sm">🔒</span>
                {{/if}}
            </div>
            <div>
                <h4 class="font-medium {{#if isReturning}}text-gray-900{{else if (eq flowState 'onboarding_complete')}}text-indigo-600{{else}}text-gray-500{{/if}}">
                    AI Plans
                </h4>
                <p class="text-xs {{#if isReturning}}text-gray-500{{else if (eq flowState 'onboarding_complete')}}text-indigo-500{{else}}text-gray-400{{/if}}">
                    {{#if isReturning}}Ready to use!{{else if (eq flowState 'onboarding_complete')}}Generate now{{else}}Locked{{/if}}
                </p>
            </div>
        </div>
    </div>
    
    <!-- Next Action -->
    <div class="mt-4 p-4 bg-white rounded-lg border border-indigo-100">
        <div class="flex items-center justify-between">
            <div>
                <h4 class="font-medium text-gray-900">
                    {{#if isFirstTime}}
                        Next: Complete Your Profile
                    {{else if (eq flowState 'onboarding_complete')}}
                        Next: Generate AI Plans
                    {{else}}
                        Setup Complete!
                    {{/if}}
                </h4>
                <p class="text-sm text-gray-600">
                    {{#if isFirstTime}}
                        Tell us about your fitness goals and preferences
                    {{else if (eq flowState 'onboarding_complete')}}
                        Get personalized workout and diet plans
                    {{else}}
                        You're all set to start your fitness journey!
                    {{/if}}
                </p>
            </div>
            <button onclick="{{#if isFirstTime}}window.location.href='/onboarding'{{else if (eq flowState 'onboarding_complete')}}window.location.href='/ai-plans'{{else}}showSection('workouts'){{/if}}" 
                    class="px-4 py-2 bg-indigo-500 text-white rounded-lg hover:bg-indigo-600 transition-colors">
                {{#if isFirstTime}}
                    Start Setup
                {{else if (eq flowState 'onboarding_complete')}}
                    Generate Plans
                {{else}}
                    View Dashboard
                {{/if}}
            </button>
        </div>
    </div>
    
    <!-- Estimated Time -->
    <div class="mt-3 text-center">
        <p class="text-xs text-indigo-600">
            {{#if isFirstTime}}
                ⏱️ Estimated time: 5-7 minutes to complete setup
            {{else if (eq flowState 'onboarding_complete')}}
                ⏱️ Estimated time: 2-3 minutes to generate plans
            {{else}}
                🎉 Setup complete! Welcome to Mission Fitness
            {{/if}}
        </p>
    </div>
</div>
{{/unless}}

<script>
// Animate progress bar on page load
document.addEventListener('DOMContentLoaded', () => {
    const progressBar = document.querySelector('.bg-gradient-to-r.from-indigo-500.to-purple-500');
    if (progressBar) {
        const targetWidth = progressBar.style.width;
        progressBar.style.width = '0%';
        setTimeout(() => {
            progressBar.style.width = targetWidth;
        }, 500);
    }
});
</script>