<!-- Quick Actions Panel -->
<div class="glass-card rounded-2xl p-6 mb-6 {{#if hideAdvancedFeatures}}border-2 border-orange-200{{/if}}">
    <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold flex items-center gap-2">
            {{#if isFirstTime}}
                <span>🚀</span> Quick Start
            {{else if isReturning}}
                <span>⚡</span> Today's Actions
            {{else}}
                <span>📋</span> Next Steps
            {{/if}}
        </h3>
        {{#if isFirstTime}}
            <span class="px-2 py-1 bg-orange-100 text-orange-600 text-xs font-bold rounded-full">NEW USER</span>
        {{/if}}
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-{{#if isReturning}}3{{else}}2{{/if}} gap-4">
        {{#if isFirstTime}}
            <!-- First-time user actions -->
            <div class="action-card bg-gradient-to-r from-orange-50 to-orange-100 border border-orange-200 p-4 rounded-xl cursor-pointer hover:shadow-lg transition-all" onclick="window.location.href='/onboarding'">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 bg-orange-500 rounded-full flex items-center justify-center text-white">
                        <span>👤</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900">Complete Profile</h4>
                        <p class="text-xs text-gray-600">5 minutes</p>
                    </div>
                </div>
                <p class="text-sm text-gray-700">Tell us about your fitness goals and get personalized plans</p>
                <div class="mt-3 flex items-center justify-between">
                    <span class="text-xs text-orange-600 font-medium">PRIORITY</span>
                    <span class="text-orange-500">→</span>
                </div>
            </div>
            
            <div class="action-card bg-gray-50 border border-gray-200 p-4 rounded-xl opacity-60">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 bg-gray-300 rounded-full flex items-center justify-center text-gray-500">
                        <span>🤖</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-700">AI Plans</h4>
                        <p class="text-xs text-gray-500">Locked</p>
                    </div>
                </div>
                <p class="text-sm text-gray-500">Complete profile first to unlock AI-generated plans</p>
                <div class="mt-3">
                    <span class="text-xs text-gray-400">🔒 Complete profile to unlock</span>
                </div>
            </div>
        {{else if isReturning}}
            <!-- Returning user actions -->
            <div class="action-card bg-gradient-to-r from-blue-50 to-blue-100 border border-blue-200 p-4 rounded-xl cursor-pointer hover:shadow-lg transition-all" onclick="showSection('workouts')">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white">
                        <span>💪</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900">Today's Workout</h4>
                        <p class="text-xs text-gray-600">{{workout.plannedDuration}} min</p>
                    </div>
                </div>
                <p class="text-sm text-gray-700">{{workout.message}}</p>
                <div class="mt-3">
                    <div class="w-full bg-blue-200 rounded-full h-2">
                        <div class="bg-blue-500 h-2 rounded-full" style="width: {{workout.consistencyScore}}%"></div>
                    </div>
                    <span class="text-xs text-blue-600 font-medium">{{workout.consistencyScore}}% this week</span>
                </div>
            </div>
            
            <div class="action-card bg-gradient-to-r from-green-50 to-green-100 border border-green-200 p-4 rounded-xl cursor-pointer hover:shadow-lg transition-all" onclick="showSection('diet')">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center text-white">
                        <span>🥗</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900">Track Diet</h4>
                        <p class="text-xs text-gray-600">{{diet.preference}}</p>
                    </div>
                </div>
                <p class="text-sm text-gray-700">{{diet.message}}</p>
                <div class="mt-3">
                    <span class="text-xs text-green-600 font-medium">{{diet.caloriesEaten}}/{{diet.totalCalories}} calories today</span>
                </div>
            </div>
            
            <div class="action-card bg-gradient-to-r from-purple-50 to-purple-100 border border-purple-200 p-4 rounded-xl cursor-pointer hover:shadow-lg transition-all" onclick="showSection('progress')">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 bg-purple-500 rounded-full flex items-center justify-center text-white">
                        <span>📈</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900">View Progress</h4>
                        <p class="text-xs text-gray-600">{{stats.currentStreak}} day streak</p>
                    </div>
                </div>
                <p class="text-sm text-gray-700">See your fitness journey progress</p>
                <div class="mt-3">
                    <span class="text-xs text-purple-600 font-medium">{{stats.totalScore}} points earned</span>
                </div>
            </div>
        {{else}}
            <!-- Intermediate user actions -->
            <div class="action-card bg-gradient-to-r from-orange-50 to-orange-100 border border-orange-200 p-4 rounded-xl cursor-pointer hover:shadow-lg transition-all" onclick="window.location.href='/ai-plans'">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 bg-orange-500 rounded-full flex items-center justify-center text-white">
                        <span>🤖</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900">Generate AI Plans</h4>
                        <p class="text-xs text-gray-600">Almost ready!</p>
                    </div>
                </div>
                <p class="text-sm text-gray-700">Get your personalized workout and diet plans</p>
                <div class="mt-3">
                    <span class="text-xs text-orange-600 font-medium">NEXT STEP</span>
                </div>
            </div>
            
            <div class="action-card bg-gray-50 border border-gray-200 p-4 rounded-xl opacity-60">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 bg-gray-300 rounded-full flex items-center justify-center text-gray-500">
                        <span>📊</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-700">Dashboard</h4>
                        <p class="text-xs text-gray-500">Locked</p>
                    </div>
                </div>
                <p class="text-sm text-gray-500">Generate AI plans first to unlock full dashboard</p>
                <div class="mt-3">
                    <span class="text-xs text-gray-400">🔒 Generate plans to unlock</span>
                </div>
            </div>
        {{/if}}
    </div>
    
    {{#if isFirstTime}}
        <div class="mt-4 p-3 bg-blue-50 rounded-lg border border-blue-200">
            <div class="flex items-center gap-2 mb-1">
                <span class="text-blue-500">💡</span>
                <span class="text-sm font-medium text-blue-800">Pro Tip</span>
            </div>
            <p class="text-sm text-blue-700">Complete your profile to unlock AI-powered personalized fitness and diet plans tailored just for you!</p>
        </div>
    {{/if}}
</div>

<style>
.action-card {
    transition: all 0.3s ease;
}

.action-card:hover:not(.opacity-60) {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
}

.action-card.opacity-60 {
    cursor: not-allowed;
}
</style>