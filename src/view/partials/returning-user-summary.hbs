<!-- Returning User Summary -->
{{#if isReturning}}
<div class="glass-card rounded-2xl p-6 mb-6 bg-gradient-to-r from-green-50 to-emerald-50 border border-green-200">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h3 class="text-xl font-bold text-green-900 flex items-center gap-2">
                <span>👋</span> Welcome back, {{name}}!
            </h3>
            <p class="text-green-700">Ready to continue your fitness journey?</p>
        </div>
        <div class="text-right">
            <div class="text-2xl font-bold text-green-600">{{stats.currentStreak}}</div>
            <div class="text-sm text-green-600">day streak</div>
        </div>
    </div>
    
    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
        <div class="bg-white rounded-lg p-3 border border-green-100">
            <div class="text-lg font-bold text-gray-900">{{stats.totalScore}}</div>
            <div class="text-xs text-gray-600">Total Points</div>
        </div>
        <div class="bg-white rounded-lg p-3 border border-green-100">
            <div class="text-lg font-bold text-gray-900">{{stats.workoutCompletionRate}}%</div>
            <div class="text-xs text-gray-600">Workout Rate</div>
        </div>
        <div class="bg-white rounded-lg p-3 border border-green-100">
            <div class="text-lg font-bold text-gray-900">{{stats.dietCompletionRate}}%</div>
            <div class="text-xs text-gray-600">Diet Rate</div>
        </div>
        <div class="bg-white rounded-lg p-3 border border-green-100">
            <div class="text-lg font-bold text-gray-900">{{weight}} kg</div>
            <div class="text-xs text-gray-600">Current Weight</div>
        </div>
    </div>
    
    <!-- Today's Focus -->
    <div class="bg-white rounded-lg p-4 border border-green-100">
        <h4 class="font-bold text-gray-900 mb-2 flex items-center gap-2">
            <span>🎯</span> Today's Focus
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                    <span>💪</span>
                </div>
                <div>
                    <div class="font-medium text-gray-900">{{workout.message}}</div>
                    <div class="text-sm text-gray-600">{{workout.plannedDuration}} min workout</div>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                    <span>🥗</span>
                </div>
                <div>
                    <div class="font-medium text-gray-900">{{diet.message}}</div>
                    <div class="text-sm text-gray-600">{{diet.preference}} diet plan</div>
                </div>
            </div>
        </div>
    </div>
</div>
{{/if}}