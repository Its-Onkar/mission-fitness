<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Plan Update Response - Mission Fitness</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #000;
            color: #ffffff;
            min-height: 100vh;
            padding: 2rem;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: rgba(26, 26, 26, 0.8);
            border: 1px solid rgba(51, 51, 51, 1);
            border-radius: 1rem;
            padding: 2rem;
        }

        .header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .header h1 {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .response-content {
            background: rgba(18, 18, 18, 1);
            border: 1px solid rgba(51, 51, 51, 1);
            border-radius: 0.5rem;
            padding: 1.5rem;
            margin-bottom: 2rem;
            white-space: pre-wrap;
            line-height: 1.6;
        }

        .back-button {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background-color: rgba(26, 26, 26, 0.5);
            border: 1px solid rgba(51, 51, 51, 1);
            border-radius: 0.5rem;
            color: #ffffff;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .back-button:hover {
            background-color: rgba(38, 38, 38, 1);
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>✅ Plan Updated Successfully!</h1>
            <p>Your fitness plan has been updated based on your request.</p>
        </div>

        <div class="response-content" id="response-content">
            {{response}}
        </div>

        <a href="/dashboard" class="back-button">← Back to Dashboard</a>
    </div>
</body>
</html>
