<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Progress Tracking | Mission Fitness</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; }
        .glass-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px); border: 1px solid rgba(226, 232, 240, 0.8); }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 w-64 h-full bg-white border-r border-gray-200 z-40">
        <div class="p-6 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-orange-100 flex items-center justify-center text-orange-600">
                <i data-lucide="dumbbell" class="w-6 h-6"></i>
            </div>
            <span class="text-xl font-bold">Mission<span class="text-orange-500">Fitness</span></span>
        </div>
        <nav class="flex-1 px-4 space-y-2 py-4">
            <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium">
                <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Dashboard
            </a>
            <a href="/workouts" class="flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium">
                <i data-lucide="dumbbell" class="w-5 h-5"></i> Workouts
            </a>
            <a href="/diet" class="flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium">
                <i data-lucide="utensils" class="w-5 h-5"></i> Diet & Nutrition
            </a>
            <a href="/progress" class="flex items-center gap-3 px-4 py-3 bg-orange-50 text-orange-600 rounded-xl font-medium">
                <i data-lucide="trending-up" class="w-5 h-5"></i> Progress
            </a>
        </nav>
    </aside>
    
    <main class="ml-64 p-6">
        <header class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900">📈 Progress Tracking</h1>
            <p class="text-gray-600">Monitor your fitness journey and achievements</p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Weight Progress -->
            <div class="glass-card rounded-2xl p-6">
                <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
                    <i data-lucide="scale" class="w-5 h-5 text-blue-500"></i> Weight Progress
                </h3>
                <div class="text-center mb-4">
                    <p class="text-3xl font-bold text-gray-900" id="currentWeight">70 kg</p>
                    <p class="text-sm text-gray-500">Current Weight</p>
                </div>
                <div class="space-y-2">
                    <div class="flex justify-between">
                        <span class="text-gray-600">This Week</span>
                        <span class="font-bold text-green-600" id="weeklyChange">-0.5 kg</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">This Month</span>
                        <span class="font-bold text-green-600" id="monthlyChange">-2.1 kg</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Total Progress</span>
                        <span class="font-bold text-green-600" id="totalProgress">-2.5 kg</span>
                    </div>
                </div>
                <button id="addWeightBtn" class="w-full mt-4 py-2 bg-blue-500 text-white rounded-lg">Add Weight</button>
            </div>

            <!-- Streaks & Achievements -->
            <div class="glass-card rounded-2xl p-6">
                <h3 class="text-lg font-bold mb-4">🔥 Streaks & Achievements</h3>
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="p-2 bg-orange-100 rounded-lg text-orange-600">
                                <i data-lucide="flame" class="w-4 h-4"></i>
                            </div>
                            <span class="text-sm font-medium">Workout Streak</span>
                        </div>
                        <span class="font-bold text-xl" id="workoutStreak">3</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="p-2 bg-blue-100 rounded-lg text-blue-600">
                                <i data-lucide="droplets" class="w-4 h-4"></i>
                            </div>
                            <span class="text-sm font-medium">Hydration</span>
                        </div>
                        <span class="font-bold text-xl" id="waterStreak">5</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="p-2 bg-green-100 rounded-lg text-green-600">
                                <i data-lucide="utensils" class="w-4 h-4"></i>
                            </div>
                            <span class="text-sm font-medium">Diet Tracking</span>
                        </div>
                        <span class="font-bold text-xl" id="dietStreak">4</span>
                    </div>
                </div>
            </div>

            <!-- Performance Metrics -->
            <div class="glass-card rounded-2xl p-6">
                <h3 class="text-lg font-bold mb-4">📊 Performance Metrics</h3>
                <div class="space-y-3">
                    <div class="flex justify-between">
                        <span class="text-gray-600">Total Workouts</span>
                        <span class="font-bold" id="totalWorkouts">24</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Calories Burned</span>
                        <span class="font-bold" id="totalCalories">1,500</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Active Days</span>
                        <span class="font-bold" id="activeDays">18</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Avg Session</span>
                        <span class="font-bold" id="avgSession">42 min</span>
                    </div>
                </div>
            </div>

            <!-- Progress Timeline -->
            <div class="glass-card rounded-2xl p-6 lg:col-span-3">
                <h3 class="text-xl font-bold mb-4">Progress Timeline</h3>
                <div class="space-y-4" id="progressTimeline">
                    <div class="flex items-center gap-4 p-3 bg-green-50 rounded-lg">
                        <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                        <div class="flex-1">
                            <p class="font-medium">Completed Upper Body Workout</p>
                            <p class="text-sm text-gray-500">Today at 6:00 PM • 45 minutes</p>
                        </div>
                        <span class="text-sm text-green-600 font-medium">+50 points</span>
                    </div>
                    <div class="flex items-center gap-4 p-3 bg-blue-50 rounded-lg">
                        <div class="w-3 h-3 bg-blue-500 rounded-full"></div>
                        <div class="flex-1">
                            <p class="font-medium">Logged Daily Nutrition</p>
                            <p class="text-sm text-gray-500">Today at 2:00 PM • 1,200 calories</p>
                        </div>
                        <span class="text-sm text-blue-600 font-medium">+30 points</span>
                    </div>
                    <div class="flex items-center gap-4 p-3 bg-orange-50 rounded-lg">
                        <div class="w-3 h-3 bg-orange-500 rounded-full"></div>
                        <div class="flex-1">
                            <p class="font-medium">Weight Update</p>
                            <p class="text-sm text-gray-500">Yesterday • Lost 0.5 kg</p>
                        </div>
                        <span class="text-sm text-orange-600 font-medium">+20 points</span>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            loadProgressData();
        });

        function loadProgressData() {
            const token = localStorage.getItem('token');
            if (!token) {
                window.location.href = '/login';
                return;
            }
            
            const defaultData = {
                weight: { current: 70, weeklyChange: -0.5, monthlyChange: -2.1, totalProgress: -2.5 },
                streaks: { workout: 3, water: 5, diet: 4 },
                performance: { totalWorkouts: 24, totalCalories: 1500, activeDays: 18, avgSession: 42 }
            };
            
            document.getElementById('currentWeight').textContent = `${defaultData.weight.current} kg`;
            document.getElementById('weeklyChange').textContent = `${defaultData.weight.weeklyChange} kg`;
            document.getElementById('monthlyChange').textContent = `${defaultData.weight.monthlyChange} kg`;
            document.getElementById('totalProgress').textContent = `${defaultData.weight.totalProgress} kg`;
            
            document.getElementById('workoutStreak').textContent = defaultData.streaks.workout;
            document.getElementById('waterStreak').textContent = defaultData.streaks.water;
            document.getElementById('dietStreak').textContent = defaultData.streaks.diet;
            
            document.getElementById('totalWorkouts').textContent = defaultData.performance.totalWorkouts;
            document.getElementById('totalCalories').textContent = defaultData.performance.totalCalories.toLocaleString();
            document.getElementById('activeDays').textContent = defaultData.performance.activeDays;
            document.getElementById('avgSession').textContent = `${defaultData.performance.avgSession} min`;
            
            document.getElementById('addWeightBtn').addEventListener('click', () => {
                const weight = prompt('Enter your current weight (kg):');
                if (weight) {
                    alert(`Weight ${weight} kg logged successfully!`);
                    window.location.href = '/dashboard';
                }
            });
        }
    </script>
</body>
</html>