<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup - Mission Fitness</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 50%, #3a3a3a 100%);
            display: flex;
            overflow: hidden;
            position: relative;
            min-height: 100vh;
        }

        /* Radial gradient circles with orange glows */
        body::before {
            content: '';
            position: absolute;
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(249, 115, 22, 0.08) 0%, transparent 70%);
            border-radius: 50%;
            top: -300px;
            left: -300px;
            pointer-events: none;
            animation: pulse 8s ease-in-out infinite;
            z-index: 0;
        }

        body::after {
            content: '';
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(251, 146, 60, 0.06) 0%, transparent 70%);
            border-radius: 50%;
            bottom: -200px;
            right: -200px;
            pointer-events: none;
            animation: pulse 10s ease-in-out infinite reverse;
            z-index: 0;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.15); opacity: 0.7; }
        }

        .split-container {
            display: flex;
            width: 100%;
            height: 100vh;
            position: relative;
            z-index: 1;
        }

        /* Left Side - Enhanced Illustration with Orange Accents */
        .left-side {
            flex: 1;
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.8) 0%, rgba(10, 10, 10, 0.8) 50%, rgba(20, 20, 20, 0.8) 100%),
                        url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1400&h=2000&fit=crop') center/cover no-repeat;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 80px;
            position: relative;
            overflow: hidden;
        }

        .left-side::before {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(249, 115, 22, 0.2) 0%, transparent 70%);
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            animation: glow 6s ease-in-out infinite;
            z-index: 1;
        }

        @keyframes glow {
            0%, 100% { opacity: 0.4; transform: translate(-50%, -50%) scale(1); }
            50% { opacity: 0.7; transform: translate(-50%, -50%) scale(1.3); }
        }

        .illustration {
            max-width: 450px;
            text-align: center;
            animation: floatIllustration 4s ease-in-out infinite;
            position: relative;
            z-index: 2;
        }

        @keyframes floatIllustration {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(1deg); }
        }

        .fitness-illustration {
            font-size: 200px;
            margin-bottom: 30px;
            display: block;
            filter: drop-shadow(0 20px 50px rgba(249, 115, 22, 0.3));
            animation: bounce 2s ease-in-out infinite;
            color: #f97316;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .illustration h2 {
            font-size: 60px;
            background: linear-gradient(135deg, #f97316 0%, #ffffff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
            margin-bottom: 20px;
            letter-spacing: -1.5px;
            text-shadow: 0 4px 20px rgba(249, 115, 22, 0.3);
        }

        .illustration p {
            font-size: 24px;
            color: #ffffff;
            font-weight: 400;
            line-height: 1.7;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
        }

        /* Enhanced Decorative Elements with Orange Icons */
        .decoration {
            position: absolute;
            opacity: 0.3;
            z-index: 1;
            color: #f97316;
        }

        .decoration:nth-child(1) {
            top: 15%;
            left: 10%;
            font-size: 40px;
            animation: rotate 12s linear infinite;
        }

        .decoration:nth-child(2) {
            top: 25%;
            right: 10%;
            font-size: 35px;
            animation: rotate 18s linear infinite reverse;
        }

        .decoration:nth-child(3) {
            bottom: 20%;
            left: 10%;
            font-size: 38px;
            animation: rotate 14s linear infinite;
        }

        .decoration:nth-child(4) {
            bottom: 15%;
            right: 10%;
            font-size: 42px;
            animation: rotate 10s linear infinite reverse;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Right Side - Enhanced Signup Form with Orange Accents */
        .right-side {
            flex: 1;
            background: linear-gradient(135deg, #1a1a1a 0%, #141414 50%, #202020 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 70px 90px;
            position: relative;
        }

        .signup-container {
            width: 100%;
            max-width: 480px;
            position: relative;
            z-index: 2;
        }

        .signup-box {
            position: static;
            width: 100%;
            padding: 60px 50px;
            margin: 0 auto;
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.95) 0%, rgba(10, 10, 10, 0.98) 100%);
            box-sizing: border-box;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.7), 
                        0 0 0 1px rgba(249, 115, 22, 0.1),
                        inset 0 1px 0 rgba(255, 255, 255, 0.02);
            border-radius: 28px;
            backdrop-filter: blur(20px);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(249, 115, 22, 0.1);
        }

        .signup-box::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(249, 115, 22, 0.3), transparent);
        }

        .signup-box p:first-child {
            margin: 0 0 50px;
            padding: 0;
            color: #ffffff;
            text-align: center;
            font-size: 2.5rem;
            font-weight: 900;
            letter-spacing: -0.8px;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            position: relative;
        }

        .signup-box p:first-child::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 3px;
            background: linear-gradient(135deg, #f97316, #fb923c);
            border-radius: 2px;
        }

        .signup-box .user-box {
            position: relative;
            margin-bottom: 45px;
        }

        .signup-box .user-box input {
            width: 100%;
            padding: 16px 0 16px 0;
            font-size: 16px;
            color: #ffffff;
            margin-bottom: 0;
            border: none;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
            outline: none;
            background: transparent;
            transition: all 0.3s ease;
        }

        .signup-box .user-box input:focus {
            border-bottom-color: #f97316;
            box-shadow: 0 2px 10px rgba(249, 115, 22, 0.1);
        }

        .signup-box .user-box label {
            position: absolute;
            top: 0;
            left: 0;
            padding: 16px 0;
            font-size: 16px;
            color: rgba(255, 255, 255, 0.4);
            pointer-events: none;
            transition: all 0.3s ease;
        }

        .signup-box .user-box input:focus ~ label,
        .signup-box .user-box input:valid ~ label,
        .signup-box .user-box.filled label {
            top: -28px;
            left: 0;
            color: #f97316;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .signup-box .user-box label i {
            margin-right: 8px;
            opacity: 0.6;
        }

        .signup-box .user-box input:focus ~ label i {
            opacity: 1;
        }

        /* Enhanced Button with Orange Gradient */
        .signup-box form .signup-btn {
            position: relative;
            display: block;
            width: 100%;
            padding: 18px 24px;
            font-weight: 700;
            color: #ffffff;
            font-size: 16px;
            text-decoration: none;
            text-transform: uppercase;
            overflow: hidden;
            transition: all 0.4s ease;
            margin-top: 60px;
            letter-spacing: 1.5px;
            background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
            border: none;
            cursor: pointer;
            border-radius: 16px;
            box-shadow: 0 12px 35px rgba(249, 115, 22, 0.3);
        }

        .signup-box .signup-btn:hover {
            background: linear-gradient(135deg, #ea580c 0%, #f59e0b 100%);
            box-shadow: 0 18px 45px rgba(249, 115, 22, 0.4);
            transform: translateY(-3px);
        }

        .signup-box .signup-btn:active {
            transform: translateY(-1px);
        }

        .signup-box .signup-btn span {
            position: absolute;
            display: block;
            background: rgba(255, 255, 255, 0.2);
        }

        .signup-box .signup-btn span:nth-child(1) {
            top: 0;
            left: -100%;
            width: 100%;
            height: 2px;
            animation: btn-anim1 1.5s linear infinite;
        }

        @keyframes btn-anim1 {
            0% { left: -100%; }
            50%, 100% { left: 100%; }
        }

        .signup-box .signup-btn span:nth-child(2) {
            top: -100%;
            right: 0;
            width: 2px;
            height: 100%;
            animation: btn-anim2 1.5s linear infinite;
            animation-delay: 0.375s;
        }

        @keyframes btn-anim2 {
            0% { top: -100%; }
            50%, 100% { top: 100%; }
        }

        .signup-box .signup-btn span:nth-child(3) {
            bottom: 0;
            right: -100%;
            width: 100%;
            height: 2px;
            animation: btn-anim3 1.5s linear infinite;
            animation-delay: 0.75s;
        }

        @keyframes btn-anim3 {
            0% { right: -100%; }
            50%, 100% { right: 100%; }
        }

        .signup-box .signup-btn span:nth-child(4) {
            bottom: -100%;
            left: 0;
            width: 2px;
            height: 100%;
            animation: btn-anim4 1.5s linear infinite;
            animation-delay: 1.125s;
        }

        @keyframes btn-anim4 {
            0% { bottom: -100%; }
            50%, 100% { bottom: 100%; }
        }

        .signup-box p:last-child {
            color: rgba(255, 255, 255, 0.4);
            font-size: 14px;
            text-align: center;
            margin-top: 40px;
        }

        .signup-box a.a2 {
            color: #f97316;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .signup-box a.a2:hover {
            color: #ea580c;
            text-shadow: 0 0 10px rgba(249, 115, 22, 0.5);
        }

        #message {
            margin-top: 30px;
            text-align: center;
            font-size: 14px;
            font-weight: 600;
            padding: 16px 24px;
            border-radius: 16px;
            letter-spacing: 0.4px;
            backdrop-filter: blur(15px);
            transition: all 0.3s ease;
        }

        #message.success {
            color: #f97316;
            background: linear-gradient(135deg, rgba(249, 115, 22, 0.15) 0%, rgba(249, 115, 22, 0.08) 100%);
            border: 1px solid rgba(249, 115, 22, 0.3);
            box-shadow: 0 6px 25px rgba(249, 115, 22, 0.15);
        }

        #message.error {
            color: #ef4444;
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(239, 68, 68, 0.08) 100%);
            border: 1px solid rgba(239, 68, 68, 0.3);
            box-shadow: 0 6px 25px rgba(239, 68, 68, 0.15);
        }

        /* Loading State Enhanced */
        .signup-btn.loading {
            pointer-events: none;
            opacity: 0.8;
            position: relative;
        }

        .signup-btn.loading span {
            display: none;
        }

        .signup-btn.loading::after {
            content: '';
            position: absolute;
            width: 22px;
            height: 22px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-top-color: #ffffff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        @keyframes spin {
            to { transform: translate(-50%, -50%) rotate(360deg); }
        }

        /* Responsive Design Enhanced */
        @media (max-width: 1024px) {
            .left-side {
                padding: 50px;
            }

            .right-side {
                padding: 50px 60px;
            }

            .fitness-illustration {
                font-size: 160px;
            }

            .illustration h2 {
                font-size: 42px;
            }
        }

        @media (max-width: 768px) {
            .split-container {
                flex-direction: column;
            }

            .left-side {
                flex: 0 0 35vh;
                padding: 40px;
            }

            .fitness-illustration {
                font-size: 120px;
            }

            .illustration h2 {
                font-size: 32px;
            }

            .illustration p {
                font-size: 16px;
            }

            .right-side {
                flex: 1;
                padding: 50px 40px;
            }

            .decoration {
                display: none;
            }

            .signup-box {
                width: 100%;
                max-width: 420px;
                padding: 50px 40px;
            }
        }

        @media (max-width: 480px) {
            .fitness-illustration {
                font-size: 100px;
            }

            .illustration h2 {
                font-size: 28px;
            }

            .signup-box p:first-child {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <div class="split-container">
        <!-- Left Side - Illustration -->
        <div class="left-side">
            <i class="fas fa-dumbbell fitness-illustration"></i>
            <div class="illustration">
                <h2>Mission Fitness</h2>
                <p>Transform your body, transform your life. Start your fitness journey today.</p>
            </div>
            <i class="fas fa-heart decoration" style="top: 15%; left: 10%;"></i>
            <i class="fas fa-running decoration" style="top: 25%; right: 10%;"></i>
            <i class="fas fa-apple-alt decoration" style="bottom: 20%; left: 10%;"></i>
            <i class="fas fa-fire decoration" style="bottom: 15%; right: 10%;"></i>
        </div>

        <!-- Right Side - Signup Form -->
        <div class="right-side">
            <div class="signup-container signup-box">
                <p>Create Account</p>
                <form id="signupForm">
                    <div class="user-box">
                        <input required="" name="userName" type="text">
                        <label><i class="fas fa-user"></i> Username</label>
                    </div>
                    <div class="user-box">
                        <input required="" name="email" type="email">
                        <label><i class="fas fa-envelope"></i> Email</label>
                    </div>
                    <div class="user-box">
                        <input required="" name="password" type="password" id="passwordInput">
                        <label><i class="fas fa-lock"></i> Password</label>
                    </div>
                    <button type="submit" class="signup-btn">
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        Create Account
                    </button>
                    <div id="message"></div>
                </form>
                <p>Already have an account? <a href="/login" class="a2">Sign in now!</a></p>
            </div>
        </div>
    </div>

    <!-- Axios CDN -->
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <script>
        // Handle floating labels for autofill
        function handleFloatingLabels() {
            const userBoxes = document.querySelectorAll('.user-box');
            userBoxes.forEach(box => {
                const input = box.querySelector('input');
                const label = box.querySelector('label');

                function checkInput() {
                    if (input.value.trim() !== '') {
                        box.classList.add('filled');
                    } else {
                        box.classList.remove('filled');
                    }
                }

                // Initial check
                checkInput();

                // Listen for input changes
                input.addEventListener('input', checkInput);

                // Handle autofill with MutationObserver
                const observer = new MutationObserver(() => {
                    checkInput();
                });
                observer.observe(input, { attributes: true, attributeFilter: ['value'] });

                // Also check on focus out
                input.addEventListener('blur', checkInput);
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            handleFloatingLabels();

            const form = document.getElementById("signupForm");
            const messageEl = document.getElementById("message");
            const submitBtn = form.querySelector(".signup-btn");

            form.addEventListener("submit", async function (event) {
                event.preventDefault();

                const userName = form.querySelector("input[name='userName']").value;
                const email = form.querySelector("input[name='email']").value;
                const password = form.querySelector("input[name='password']").value;

                // Add loading state
                submitBtn.classList.add('loading');
                messageEl.textContent = '';
                messageEl.className = '';

                try {
                    const res = await axios.post('/auth/sign-up', {
                        userName: userName,
                        email: email,
                        password: password
                    });

                    messageEl.textContent = res.data.message || "Account created successfully! Please check your email.";
                    messageEl.className = 'success';

                    form.reset();

                    // Redirect to verify email page with email parameter
                    setTimeout(() => {
                        window.location.href = `/verify-email?email=${encodeURIComponent(email)}`;
                    }, 1500);

                } catch (error) {
                    submitBtn.classList.remove('loading');
                    
                    messageEl.textContent = error?.response?.data?.error || "Failed to create account.";
                    messageEl.className = 'error';
                }
            });
        });
    </script>
</body>
</html>