<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Email - Mission Fitness</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 50%, #3a3a3a 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 18px;
            padding-top: 40px;
            position: relative;
            overflow: hidden;
        }

        /* Radial gradient circles with orange glows */
        body::before {
            content: '';
            position: absolute;
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(249, 115, 22, 0.08) 0%, transparent 70%);
            
            top: -300px;
            left: -300px;
            pointer-events: none;
            animation: pulse 8s ease-in-out infinite;
            z-index: 0;
        }

        body::after {
            content: '';
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(251, 146, 60, 0.06) 0%, transparent 70%);
            border-radius: 50%;
            bottom: -200px;
            right: -200px;
            pointer-events: none;
            animation: pulse 10s ease-in-out infinite reverse;
            z-index: 0;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.15); opacity: 0.7; }
        }

        .container {
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.95) 0%, rgba(10, 10, 10, 0.98) 100%);
           
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.7), 
                        0 0 0 1px rgba(249, 115, 22, 0.1),
                        inset 0 1px 0 rgba(255, 255, 255, 0.02);
            max-width: 450px;
            width: 100%;
            padding: 25px 35px;
            text-align: center;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(249, 115, 22, 0.1);
            backdrop-filter: blur(20px);
            z-index: 1;
            margin: 0 auto;
        }

        .container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(249, 115, 22, 0.3), transparent);
        }

        .icon {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0 auto 15px;
            animation: pulse 2s infinite;
            box-shadow: 0 8px 25px rgba(249, 115, 22, 0.3);
        }

        @keyframes pulse {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.05);
            }
        }

        .icon i {
            font-size: 32px;
            color: #1a1a1a;
        }

        h1 {
            color: #ffffff;
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
        }

        .subtitle {
            color: rgba(255, 255, 255, 0.7);
            font-size: 16px;
            margin-bottom: 8px;
            line-height: 1.5;
        }

        .email {
            color: #f97316;
            font-weight: 600;
            margin-bottom: 15px;
            font-size: 18px;
            text-shadow: 0 1px 5px rgba(249, 115, 22, 0.3);
        }

        .action-btn {
            width: 100%;
            padding: 16px 20px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            letter-spacing: 0.5px;
            position: relative;
            overflow: hidden;
        }

        .primary-btn {
            background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
            color: #1a1a1a;
            box-shadow: 0 8px 25px rgba(249, 115, 22, 0.3);
        }

        .primary-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 35px rgba(249, 115, 22, 0.4);
        }

        .secondary-btn {
            background: transparent;
            color: #ffffff;
            border: 2px solid #f97316;
        }

        .secondary-btn:hover {
            background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
            color: #1a1a1a;
        }

        .action-btn:active {
            transform: translateY(0);
        }

        .action-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .success-message {
            background: linear-gradient(135deg, rgba(249, 115, 22, 0.15) 0%, rgba(249, 115, 22, 0.1) 100%);
            color: #f97316;
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 15px;
            display: none;
            border: 1px solid rgba(249, 115, 22, 0.3);
            font-weight: 600;
        }

        .info-box {
            background: rgba(255, 255, 255, 0.05);
            padding: 20px;
            border-radius: 12px;
            margin-top: 15px;
            text-align: left;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .info-box h3 {
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .info-box ul {
            color: rgba(255, 255, 255, 0.7);
            font-size: 14px;
            line-height: 1.6;
            padding-left: 20px;
        }

        .info-box li {
            margin-bottom: 8px;
        }

        .timer {
            color: rgba(255, 255, 255, 0.5);
            font-size: 13px;
            margin-top: 10px;
        }

        /* Responsive Design */
        @media (max-width: 480px) {
            body {
                padding: 10px;
            }

            .container {
                padding: 25px 30px;
                margin: 0 auto;
            }

            h1 {
                font-size: 24px;
            }

            .action-btn {
                padding: 14px 18px;
                font-size: 15px;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="icon">
            <i class="fas fa-envelope-open"></i>
        </div>

        <h1>Verify Your Email</h1>
        <p class="subtitle">We've sent a verification link to</p>
        <p class="email" id="userEmail">user@example.com</p>

        <div class="success-message" id="successMessage">
            Verification email sent successfully!
        </div>

        <button class="action-btn primary-btn" onclick="openGmail()">
            <i class="fas fa-envelope"></i>
            Open Gmail
        </button>

        <button class="action-btn secondary-btn" id="resendBtn" onclick="resendToken()">
            <i class="fas fa-redo"></i>
            Resend Verification Email
        </button>

        <div class="timer" id="timer"></div>

        <div class="info-box">
            <h3><i class="fas fa-info-circle" style="color: #f97316; margin-right: 8px;"></i> Next Steps:</h3>
            <ul>
                <li>Click "Open Gmail" to check your inbox</li>
                <li>Look for the verification email</li>
                <li>Click the verification link in the email</li>
                <li>Didn't receive it? Click "Resend" after 60 seconds</li>
            </ul>

        </div>
    </div>

    <script>



        // Global variables
        let resendTimer = 0;
        let timerInterval;

        // Open Gmail function
        function openGmail() {
            window.open('https://mail.google.com', '_blank');
        }

        function resendToken() {
            if (resendTimer > 0) {
                return;
            }

            const email = document.getElementById('userEmail').textContent.trim();
            if (!email || email === 'user@example.com') {
                showSuccess('Error: Invalid email address. Please sign up again.');
                return;
            }
            const resendBtn = document.getElementById('resendBtn');
            const originalContent = resendBtn.innerHTML;
            
            // Disable button and show loading
            resendBtn.disabled = true;
            resendBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';
            
            fetch('/auth/resend-verification', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ email: email })
            })
            .then(response => {
                if (!response.ok) {
                    return response.json().then(err => { throw new Error(err.message || 'Failed to send') });
                }
                return response.json();
            })
            .then(data => {
                console.log('Verification email sent:', data);
                showSuccess('Verification email sent! Check your inbox.');
                startTimer();
                resendBtn.innerHTML = '<i class="fas fa-check"></i> Sent!';
            })
            .catch(error => {
                console.error('Error sending email:', error);
                showSuccess('Error: ' + error.message);
                resendBtn.disabled = false;
                resendBtn.innerHTML = originalContent;
            });
        }

        function startTimer() {
            const resendBtn = document.getElementById('resendBtn');
            const timerDisplay = document.getElementById('timer');
            
            resendTimer = 60;
            resendBtn.disabled = true;
            
            timerInterval = setInterval(() => {
                resendTimer--;
                timerDisplay.textContent = `You can resend in ${resendTimer} seconds`;
                
                if (resendTimer === 0) {
                    clearInterval(timerInterval);
                    resendBtn.disabled = false;
                    timerDisplay.textContent = '';
                }
            }, 1000);
        }

        function showSuccess(message) {
            const successMsg = document.getElementById('successMessage');
            successMsg.textContent = message;
            successMsg.style.display = 'block';
            
            setTimeout(() => {
                successMsg.style.display = 'none';
            }, 3000);
        }

        // Check for token in URL (auto-verify)
        window.addEventListener('load', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const token = urlParams.get('token');
            const email = urlParams.get('email');
            
            // Set user email if provided in URL
            if (email) {
                document.getElementById('userEmail').textContent = email;
            }
            
            // If token is present, auto-verify
            if (token) {
                // Call your verification API
                fetch(`/auth/verify-email?token=${encodeURIComponent(token)}`, {
                    method: 'GET'
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = '/verified-email?success=true';
                    } else {
                        window.location.href = '/verified-email?success=false';
                    }
                })
                .catch(error => {
                    console.error('Verification error:', error);
                    window.location.href = '/verified-email?success=false';
                });
            }
        });
    </script>
</body>
</html>
