<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Workouts | Mission Fitness</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; }
        .glass-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px); border: 1px solid rgba(226, 232, 240, 0.8); }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 w-64 h-full bg-white border-r border-gray-200 z-40">
        <div class="p-6 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-orange-100 flex items-center justify-center text-orange-600">
                <i data-lucide="dumbbell" class="w-6 h-6"></i>
            </div>
            <span class="text-xl font-bold">Mission<span class="text-orange-500">Fitness</span></span>
        </div>
        <nav class="flex-1 px-4 space-y-2 py-4">
            <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium">
                <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Dashboard
            </a>
            <a href="/workouts" class="flex items-center gap-3 px-4 py-3 bg-orange-50 text-orange-600 rounded-xl font-medium">
                <i data-lucide="dumbbell" class="w-5 h-5"></i> Workouts
            </a>
            <a href="/diet" class="flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium">
                <i data-lucide="utensils" class="w-5 h-5"></i> Diet & Nutrition
            </a>
            <a href="/progress" class="flex items-center gap-3 px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-xl font-medium">
                <i data-lucide="trending-up" class="w-5 h-5"></i> Progress
            </a>
        </nav>
    </aside>
    
    <main class="ml-64 p-6">
        <header class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900">💪 Workouts</h1>
            <p class="text-gray-600">Track your fitness journey and workout progress</p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Today's Workout Plan -->
            <div class="glass-card rounded-2xl p-6 lg:col-span-2">
                <h3 class="text-xl font-bold mb-4">Today's AI Workout</h3>
                <div class="grid grid-cols-3 gap-4 mb-4">
                    <div class="p-3 bg-gray-50 rounded-xl">
                        <p class="text-xs text-gray-500 uppercase font-bold mb-2">Warmup</p>
                        <ul class="text-sm space-y-1" id="warmupList">
                            <li>Jumping Jacks - 2 min</li>
                            <li>Arm Circles - 1 min</li>
                        </ul>
                    </div>
                    <div class="p-3 bg-orange-50 rounded-xl">
                        <p class="text-xs text-orange-600 uppercase font-bold mb-2">Main Workout</p>
                        <ul class="text-sm space-y-1" id="mainList">
                            <li>Push-ups - 3x12</li>
                            <li>Squats - 3x15</li>
                            <li>Plank - 3x30s</li>
                        </ul>
                    </div>
                    <div class="p-3 bg-gray-50 rounded-xl">
                        <p class="text-xs text-gray-500 uppercase font-bold mb-2">Cooldown</p>
                        <ul class="text-sm space-y-1" id="cooldownList">
                            <li>Stretching - 5 min</li>
                            <li>Deep Breathing - 2 min</li>
                        </ul>
                    </div>
                </div>
                <button id="startWorkoutBtn" class="w-full py-3 bg-orange-500 text-white rounded-lg font-medium">Start Workout</button>
            </div>

            <!-- Workout Stats -->
            <div class="glass-card rounded-2xl p-6">
                <h3 class="text-lg font-bold mb-4">Workout Stats</h3>
                <div class="space-y-4">
                    <div class="flex justify-between">
                        <span class="text-gray-600">This Week</span>
                        <span class="font-bold" id="weeklyWorkouts">4/7</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Current Streak</span>
                        <span class="font-bold" id="workoutStreak">3 days</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Total Workouts</span>
                        <span class="font-bold" id="totalWorkouts">24</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Calories Burned</span>
                        <span class="font-bold" id="caloriesBurned">250</span>
                    </div>
                </div>
            </div>

            <!-- Workout History -->
            <div class="glass-card rounded-2xl p-6 lg:col-span-3">
                <h3 class="text-xl font-bold mb-4">Workout History</h3>
                <div class="space-y-3" id="workoutHistory">
                    <div class="p-3 bg-gray-50 rounded-lg flex justify-between items-center">
                        <div>
                            <p class="font-medium">Upper Body Strength</p>
                            <p class="text-sm text-gray-500">Today - 45 mins</p>
                        </div>
                        <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm">Completed</span>
                    </div>
                    <div class="p-3 bg-gray-50 rounded-lg flex justify-between items-center">
                        <div>
                            <p class="font-medium">Cardio HIIT</p>
                            <p class="text-sm text-gray-500">Yesterday - 30 mins</p>
                        </div>
                        <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm">Completed</span>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            loadWorkoutData();
        });

        function loadWorkoutData() {
            const token = localStorage.getItem('token');
            if (!token) {
                window.location.href = '/login';
                return;
            }
            
            const defaultData = {
                workout: { consistencyScore: 70, caloriesBurned: 250, weeklyStats: { completed: 4, planned: 7 } },
                streaks: { workout: 3 },
                totalWorkouts: 24
            };
            
            document.getElementById('weeklyWorkouts').textContent = `${defaultData.workout.weeklyStats.completed}/${defaultData.workout.weeklyStats.planned}`;
            document.getElementById('workoutStreak').textContent = `${defaultData.streaks.workout} days`;
            document.getElementById('totalWorkouts').textContent = defaultData.totalWorkouts;
            document.getElementById('caloriesBurned').textContent = defaultData.workout.caloriesBurned;
            
            document.getElementById('startWorkoutBtn').addEventListener('click', () => {
                localStorage.setItem('workoutCompleted_' + new Date().toDateString(), 'true');
                alert('Workout completed! Great job!');
                window.location.href = '/dashboard';
            });
        }
    </script>
</body>
</html>